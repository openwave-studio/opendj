import { PushScreen, PushTrack, PushKnob, PushMenu } from "push.slint";
export { PushScreen, PushTrack, PushKnob, PushMenu }
// openDJ Studio: a browser on the left, the Session grid with its mixer in
// the middle, returns A and B and Main on the right, and the selected
// track's devices along the bottom.

export global Theme {
    out property <color> bg: #101112;
    out property <color> panel: #161819;
    out property <color> panel-2: #1b1d1f;
    out property <color> slot: #1e2022;
    out property <color> slot-hover: #26292b;
    out property <color> line: #2a2d30;
    out property <color> text: #e8e8ea;
    out property <color> dim: #8b8d91;
    out property <color> faint: #55585c;
    out property <color> accent: #B69CFF;
    out property <color> accent-dark: #8C72D9;
    out property <color> select: #4A4A4D;
    out property <color> playing: #7ee08a;
    out property <color> queued: #ffd166;
    out property <color> effect: #ff9f5a;
    out property <color> midi-fx: #ffd166;
    out property <color> return-a: #8C72D9;
    out property <color> return-b: #5d8cc9;
    out property <length> radius: 3px;
}

// Slot states, as the audio thread reports them.
export enum SlotState { empty, stopped, queued, playing, stopping }

export struct SlotData {
    name: string,
    color: color,
    state: SlotState,
    // Loop length in beats; 0 for an empty slot.
    beats: float,
}

export struct ParamData {
    name: string,
    value: float,
    text: string,
}

// A device a set lists, shown until it can load.
export struct DeviceData {
    name: string,
    kind: string,
    note: string,
    on: bool,
    // A plug-in, running: its window can open.
    can-open: bool,
}

export struct TrackData {
    name: string,
    color: color,
    // How far through its clip the track is, 0..1; -1 when stopped.
    progress: float,
    // A stop is waiting for the next launch point.
    stopping: bool,
    // The instrument on the track, as the device row titles it.
    device: string,
    drums: bool,
    // An audio track: recordings, no instrument.
    audio: bool,
    kind: string,
    // Where it listens (an audio input, or a MIDI controller).
    input: string,
    // The devices a set lists for it.
    chain: [DeviceData],
    // A plug-in plays its notes (the built-in sound isn't shown).
    plugin-instrument: bool,
    // Meter, 0..1 on a dB scale.
    level: float,
    // Fader position 0..1 (0 dB at 60/66) and as text.
    volume: float,
    volume-text: string,
    pan: float,
    pan-text: string,
    send-a: float,
    send-b: float,
    // The instrument's knobs.
    params: [ParamData],
}

struct BrowserItem {
    name: string,
    // 0 instrument, 1 audio effect, 2 MIDI effect, 3 folder, 4 clip.
    kind: int,
    detail: string,
}

// ---------------------------------------------------------------- controls

component Pill inherits Rectangle {
    in property <string> label;
    in property <bool> on;
    in property <bool> enabled: true;
    callback clicked;
    height: 24px;
    min-width: 28px;
    border-radius: 3px;
    background: on ? Theme.accent : (ta.has-hover ? Theme.slot-hover : Theme.slot);
    opacity: enabled ? 1 : 0.4;
    HorizontalLayout {
        padding-left: 9px;
        padding-right: 9px;
        Text {
            text: label;
            color: on ? #101112 : Theme.text;
            font-size: 12px;
            font-weight: 600;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component Readout inherits Rectangle {
    in property <string> title;
    in property <string> value;
    in property <length> value-width: 56px;
    HorizontalLayout {
        spacing: 6px;
        if title != "": Text {
            text: title;
            color: Theme.dim;
            font-size: 11px;
            vertical-alignment: center;
        }
        Text {
            text: value;
            color: Theme.text;
            font-size: 14px;
            font-weight: 600;
            min-width: value-width;
            vertical-alignment: center;
        }
    }
}

// A rotary knob: drag up and down. The arc runs from 7 to 5 o'clock.
// Its value comes from the model; a `free` knob (not connected yet) keeps
// its own.
component Knob inherits Rectangle {
    in property <string> label;
    in property <string> display;
    in property <float> value: 0.5;
    in property <bool> free;
    in property <bool> bipolar;
    in property <length> size: 30px;
    in property <color> tint: Theme.accent;
    callback changed(float);
    property <float> local;
    property <float> shown: free ? local : value;
    property <float> start-value;
    property <angle> a0: 135deg;
    property <angle> a1: 135deg + 270deg * shown;
    init => { local = value; }
    property <angle> centre: 270deg;
    width: max(size, 48px);
    height: (label != "" ? 14px : 0px) + size + (display != "" ? 14px : 0px);
    if label != "": Text {
        y: 0;
        height: 14px;
        width: parent.width;
        text: label;
        color: Theme.dim;
        font-size: 10px;
        horizontal-alignment: center;
        overflow: elide;
    }
    Path {
        x: (parent.width - size) / 2;
        y: label != "" ? 14px : 0px;
        width: size;
        height: size;
        viewbox-width: 36;
        viewbox-height: 36;
        stroke: Theme.line;
        stroke-width: 3px;
        commands: "M " + (18 + 14 * cos(135deg)) + " " + (18 + 14 * sin(135deg))
            + " A 14 14 0 1 1 " + (18 + 14 * cos(45deg)) + " " + (18 + 14 * sin(45deg));
    }
    // The value arc, from the start (or the top for a bipolar knob).
    property <angle> from: bipolar ? centre : a0;
    property <angle> lo: a1 < from ? a1 : from;
    property <angle> hi: a1 < from ? from : a1;
    if hi - lo > 2deg: Path {
        x: (parent.width - size) / 2;
        y: label != "" ? 14px : 0px;
        width: size;
        height: size;
        viewbox-width: 36;
        viewbox-height: 36;
        stroke: tint;
        stroke-width: 3px;
        commands: "M " + (18 + 14 * cos(lo)) + " " + (18 + 14 * sin(lo))
            + " A 14 14 0 " + (hi - lo > 180deg ? 1 : 0) + " 1 "
            + (18 + 14 * cos(hi)) + " " + (18 + 14 * sin(hi));
    }
    // Pointer.
    Path {
        x: (parent.width - size) / 2;
        y: label != "" ? 14px : 0px;
        width: size;
        height: size;
        viewbox-width: 36;
        viewbox-height: 36;
        stroke: Theme.text;
        stroke-width: 2px;
        commands: "M " + (18 + 5 * cos(a1)) + " " + (18 + 5 * sin(a1))
            + " L " + (18 + 11 * cos(a1)) + " " + (18 + 11 * sin(a1));
    }
    function set(v: float) {
        local = max(0, min(1, v));
        changed(local);
    }
    if display != "": Text {
        y: parent.height - 14px;
        height: 14px;
        width: parent.width;
        text: display;
        color: Theme.text;
        font-size: 10px;
        horizontal-alignment: center;
    }
    TouchArea {
        mouse-cursor: ns-resize;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                root.start-value = root.shown;
            }
        }
        moved => {
            root.set(root.start-value + (self.pressed-y - self.mouse-y) / 160px);
        }
        double-clicked => {
            if root.bipolar {
                root.set(0.5);
            }
        }
    }
}

// A vertical fader. 0..1 maps to -inf..+6 dB; 0 dB sits at 60/66.
component Fader inherits Rectangle {
    in property <float> value: 60 / 66;
    in property <bool> free;
    callback changed(float);
    property <float> local;
    property <float> shown: free ? local : value;
    property <float> start-value;
    init => { local = value; }
    function set(v: float) {
        local = max(0, min(1, v));
        changed(local);
    }
    property <length> thumb: 12px;
    width: 18px;
    Rectangle {
        x: (parent.width - 4px) / 2;
        width: 4px;
        border-radius: 2px;
        background: #0b0c0d;
    }
    // 0 dB mark.
    Rectangle {
        x: 0;
        y: (1 - 60 / 66) * (parent.height - thumb) + thumb / 2;
        width: 3px;
        height: 1px;
        background: Theme.faint;
    }
    Rectangle {
        y: (1 - shown) * (parent.height - thumb);
        height: thumb;
        border-radius: 2px;
        background: ta.pressed ? Theme.text : #c9cacd;
        Rectangle { height: 1px; width: parent.width - 4px; background: #101112; }
    }
    ta := TouchArea {
        mouse-cursor: ns-resize;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                root.start-value = root.shown;
            }
        }
        moved => {
            root.set(root.start-value + (self.pressed-y - self.mouse-y) / (root.height - root.thumb));
        }
        double-clicked => {
            root.set(60 / 66);
        }
    }
}

component Meter inherits Rectangle {
    in property <float> level;
    width: 4px;
    background: #0b0c0d;
    clip: true;
    Rectangle {
        background: @linear-gradient(0deg, #4fc36a 0%, #7ee08a 65%, #ffd166 88%, #ff6b6b 100%);
    }
    Rectangle {
        y: 0;
        height: parent.height * (1 - max(0, min(1, level)));
        background: #0b0c0d;
    }
}

component SmallButton inherits Rectangle {
    in property <string> label;
    in property <bool> on;
    in property <color> on-color: Theme.accent;
    callback clicked;
    width: 22px;
    height: 18px;
    border-radius: 2px;
    background: on ? on-color : (ta.has-hover ? Theme.slot-hover : Theme.slot);
    Text {
        text: label;
        color: on ? #101112 : Theme.text;
        font-size: 10px;
        font-weight: 600;
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

// A mixer strip: sends, pan, fader with meter, activator, solo and arm.
// Values come from the model; `free` strips (returns, not connected yet)
// keep their own.
component Strip inherits Rectangle {
    in property <color> tint;
    in property <string> number;
    in property <float> level;
    in property <bool> sends: true;
    in property <bool> arm: true;
    in property <bool> free;
    in property <float> volume: 60 / 66;
    in property <float> pan: 0.5;
    in property <string> pan-text: "C";
    in property <float> send-a;
    in property <float> send-b;
    // Which control (0 volume, 1 pan, 2 send A, 3 send B) and its value.
    callback changed(int, float);
    property <float> fader: free ? local-volume : volume;
    property <float> local-volume: 60 / 66;
    property <bool> active: true;
    property <bool> solo;
    property <bool> armed;
    background: tint.with-alpha(0.10);
    VerticalLayout {
        padding: 4px;
        spacing: 2px;
        HorizontalLayout {
            alignment: center;
            spacing: -14px;
            height: 44px;
            if sends: Knob {
                label: "A";
                size: 24px;
                tint: Theme.return-a;
                value: root.send-a;
                changed(v) => { root.changed(2, v); }
            }
            if sends: Knob {
                label: "B";
                size: 24px;
                tint: Theme.return-b;
                value: root.send-b;
                changed(v) => { root.changed(3, v); }
            }
        }
        HorizontalLayout {
            alignment: center;
            Knob {
                size: 24px;
                bipolar: true;
                free: root.free;
                value: root.pan;
                display: root.free ? "" : root.pan-text;
                label: "Pan";
                changed(v) => { root.changed(1, v); }
            }
        }
        HorizontalLayout {
            alignment: center;
            spacing: 6px;
            vertical-stretch: 1;
            Text {
                width: 30px;
                text: fader <= 0.001 ? "-inf" : (round((6 - (1 - fader) * 66) * 10) / 10);
                color: Theme.dim;
                font-size: 10px;
                horizontal-alignment: right;
                vertical-alignment: top;
            }
            Fader {
                value: root.fader;
                free: root.free;
                changed(v) => {
                    root.local-volume = v;
                    root.changed(0, v);
                }
            }
            Meter { level: root.level; }
            Meter { level: root.level; }
        }
        HorizontalLayout {
            alignment: center;
            spacing: 3px;
            height: 20px;
            Rectangle {
                width: 26px;
                height: 18px;
                border-radius: 2px;
                background: active ? Theme.accent : Theme.slot;
                Text { text: number; color: active ? #101112 : Theme.dim; font-size: 10px; font-weight: 700; }
                TouchArea { clicked => { root.active = !root.active; } }
            }
            SmallButton { label: "S"; on: solo; on-color: Theme.return-b; clicked => { root.solo = !root.solo; } }
            if arm: SmallButton { label: "●"; on: armed; on-color: #ff6b6b; clicked => { root.armed = !root.armed; } }
        }
    }
}

component ClipSlot inherits Rectangle {
    in property <SlotData> data;
    in property <bool> blink;
    in property <float> progress: -1;
    in property <bool> selected;
    callback launch;
    background: data.state == SlotState.empty
        ? (ta.has-hover ? Theme.slot-hover : Theme.slot)
        : (data.state == SlotState.playing ? data.color : data.color.with-alpha(ta.has-hover ? 0.5 : 0.34));
    border-width: data.state == SlotState.queued ? 1px : (selected ? 1px : 0px);
    border-color: data.state == SlotState.queued
        ? (blink ? Theme.queued : Theme.queued.with-alpha(0.25))
        : Theme.text;
    clip: true;
    if data.state == SlotState.playing && progress >= 0: Rectangle {
        x: 0;
        y: parent.height - 2px;
        height: 2px;
        width: parent.width * progress;
        background: #101112aa;
    }
    if data.state == SlotState.empty: Rectangle {
        x: 6px;
        width: 6px;
        height: 6px;
        border-width: 1px;
        border-color: Theme.faint;
    }
    if data.state != SlotState.empty: HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        spacing: 5px;
        Text {
            text: data.state == SlotState.playing ? "▶" : "▷";
            color: data.state == SlotState.playing ? #101112 : Theme.text;
            font-size: 10px;
            vertical-alignment: center;
            width: 10px;
        }
        Text {
            text: data.name;
            color: data.state == SlotState.playing ? #101112 : Theme.text;
            font-size: 11px;
            font-weight: data.state == SlotState.playing ? 700 : 500;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    ta := TouchArea {
        clicked => { root.launch(); }
    }
}

// An outlined square, coloured by what a browser item is.
component KindIcon inherits Rectangle {
    in property <int> kind;
    width: 10px;
    height: 10px;
    border-width: 1.5px;
    border-radius: kind == 3 ? 1px : 2px;
    border-color: kind == 0 ? Theme.accent : (kind == 1 ? Theme.effect : (kind == 2 ? Theme.midi-fx : (kind == 4 ? Theme.playing : Theme.dim)));
    if kind != 3: Rectangle {
        width: 4px;
        height: 4px;
        background: parent.border-color;
    }
}

// --------------------------------------------------------------- browser

component NavItem inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    in property <color> dot: transparent;
    in property <bool> indent;
    callback clicked;
    height: 21px;
    background: selected ? Theme.select : (ta.has-hover ? Theme.slot : transparent);
    border-radius: 2px;
    HorizontalLayout {
        padding-left: indent ? 18px : 8px;
        spacing: 6px;
        if dot != transparent: VerticalLayout {
            alignment: center;
            Rectangle { width: 7px; height: 7px; border-radius: 1px; background: dot; }
        }
        Text {
            text: label;
            color: selected ? Theme.text : #c4c5c8;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

component NavHeading inherits Text {
    color: Theme.faint;
    font-size: 11px;
    font-weight: 600;
    height: 24px;
    vertical-alignment: bottom;
}

component Browser inherits Rectangle {
    in-out property <int> category: 3;
    in-out property <int> picked: -1;
    property <[string]> categories: [
        "Favorites", "Effects", "Instruments",
        "All", "Sounds", "Drums", "Instruments", "Audio Effects", "MIDI Effects", "Plug-ins", "Clips", "Samples",
        "User Library", "Current Project",
    ];
    property <[BrowserItem]> instruments: [
        { name: "Drum Kit", kind: 0, detail: "6 kits" },
        { name: "Bass Synth", kind: 0 },
        { name: "Pad Synth", kind: 0 },
        { name: "Lead Synth", kind: 0 },
        { name: "Sampler", kind: 0, detail: "soon" },
        { name: "Plug-in instrument", kind: 0, detail: "soon" },
    ];
    property <[BrowserItem]> kits: [
        { name: "Analog", kind: 0, detail: "kit" },
        { name: "Synthetic", kind: 0, detail: "kit" },
        { name: "Boom", kind: 0, detail: "kit" },
        { name: "Punch", kind: 0, detail: "kit" },
        { name: "Tin", kind: 0, detail: "kit" },
        { name: "Dub", kind: 0, detail: "kit" },
    ];
    property <[BrowserItem]> sounds: [
        { name: "Bass · Mono saw", kind: 0, detail: "preset" },
        { name: "Pad · Warm chords", kind: 0, detail: "preset" },
        { name: "Lead · Pluck", kind: 0, detail: "preset" },
    ];
    property <[BrowserItem]> effects: [
        { name: "EQ", kind: 1 },
        { name: "Filter", kind: 1 },
        { name: "Ladder", kind: 1 },
        { name: "Drive", kind: 1 },
        { name: "Bitcrusher", kind: 1 },
        { name: "Echo", kind: 1 },
        { name: "Tape Echo", kind: 1 },
        { name: "Filter Echo", kind: 1 },
        { name: "Reverb", kind: 1 },
        { name: "Hall", kind: 1 },
        { name: "Chorus", kind: 1 },
        { name: "Flanger", kind: 1 },
        { name: "Phaser", kind: 1 },
        { name: "Gate", kind: 1 },
        { name: "Ducker", kind: 1 },
        { name: "Pd rack", kind: 1, detail: "experimental" },
    ];
    property <[BrowserItem]> midi-effects: [
        { name: "Arpeggiator", kind: 2 },
        { name: "Scale", kind: 2 },
        { name: "Chord", kind: 2 },
        { name: "Pitch", kind: 2 },
    ];
    property <[BrowserItem]> plugins: [
        { name: "CLAP", kind: 3 },
        { name: "VST3", kind: 3 },
        { name: "Audio Units", kind: 3 },
    ];
    property <[BrowserItem]> clips: [
        { name: "Demo set", kind: 3 },
        { name: "Four on the floor", kind: 4, detail: "1 bar" },
        { name: "Broken beat", kind: 4, detail: "2 bars" },
        { name: "Am bassline", kind: 4, detail: "2 bars" },
        { name: "Am chords", kind: 4, detail: "4 bars" },
    ];
    property <[BrowserItem]> empty: [];
    property <[BrowserItem]> items:
        category == 1 || category == 7 ? effects
        : category == 2 || category == 6 ? instruments
        : category == 4 ? sounds
        : category == 5 ? kits
        : category == 8 ? midi-effects
        : category == 9 ? plugins
        : category == 10 ? clips
        : category == 3 ? [
            { name: "Instruments", kind: 3 },
            { name: "Drum Kit", kind: 0, detail: "6 kits" },
            { name: "Bass Synth", kind: 0 },
            { name: "Pad Synth", kind: 0 },
            { name: "Lead Synth", kind: 0 },
            { name: "Effects", kind: 3 },
            { name: "EQ", kind: 1 },
            { name: "Filter", kind: 1 },
            { name: "Drive", kind: 1 },
            { name: "Echo", kind: 1 },
            { name: "Reverb", kind: 1 },
            { name: "Chorus", kind: 1 },
            { name: "Pd rack", kind: 1, detail: "experimental" },
            { name: "MIDI Effects", kind: 3 },
            { name: "Arpeggiator", kind: 2 },
            { name: "Scale", kind: 2 },
            { name: "Plug-ins", kind: 3 },
        ]
        : empty;
    background: Theme.panel;

    VerticalLayout {
        padding: 8px;
        spacing: 8px;
        // Search.
        Rectangle {
            height: 26px;
            border-radius: 3px;
            background: Theme.bg;
            border-width: 1px;
            border-color: search.has-focus ? Theme.accent-dark : Theme.line;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 6px;
                Text { text: "⌕"; color: Theme.dim; vertical-alignment: center; }
                search := TextInput {
                    color: Theme.text;
                    font-size: 12px;
                    vertical-alignment: center;
                    single-line: true;
                }
            }
            if search.text == "": Text {
                x: 26px;
                text: "Search";
                color: Theme.faint;
                font-size: 12px;
            }
        }
        HorizontalLayout {
            spacing: 6px;
            vertical-stretch: 1;
            // Categories.
            VerticalLayout {
                width: 118px;
                spacing: 0px;
                NavHeading { text: "Collections"; }
                NavItem { label: categories[0]; dot: #ff6b6b; selected: category == 0; clicked => { category = 0; } }
                NavItem { label: categories[1]; dot: Theme.effect; selected: category == 1; clicked => { category = 1; } }
                NavItem { label: categories[2]; dot: Theme.accent; selected: category == 2; clicked => { category = 2; } }
                NavHeading { text: "Library"; }
                for i in 9: NavItem {
                    label: categories[3 + i];
                    selected: category == 3 + i;
                    clicked => { category = 3 + i; }
                }
                NavHeading { text: "Places"; }
                NavItem { label: categories[12]; selected: category == 12; clicked => { category = 12; } }
                NavItem { label: categories[13]; selected: category == 13; clicked => { category = 13; } }
                NavItem { label: "+ Add folder"; clicked => { } }
                Rectangle { vertical-stretch: 1; }
            }
            Rectangle { width: 1px; background: Theme.line; }
            // Items.
            VerticalLayout {
                horizontal-stretch: 1;
                Rectangle {
                    height: 22px;
                    Text {
                        x: 4px;
                        text: "Name";
                        color: Theme.dim;
                        font-size: 11px;
                        font-weight: 600;
                    }
                }
                Rectangle { height: 1px; background: Theme.line; }
                Flickable {
                    vertical-stretch: 1;
                    content-height: max(self.height, items.length * 22px);
                    for item[i] in items: Rectangle {
                        y: i * 22px;
                        height: 22px;
                        width: parent.width;
                        background: picked == i ? Theme.select : (row.has-hover ? Theme.slot : transparent);
                        border-radius: 2px;
                        HorizontalLayout {
                            padding-left: item.kind == 3 ? 4px : 14px;
                            padding-right: 6px;
                            spacing: 6px;
                            if item.kind == 3: Text { text: "›"; color: Theme.dim; font-size: 12px; vertical-alignment: center; width: 8px; }
                            VerticalLayout { alignment: center; KindIcon { kind: item.kind; } }
                            Text {
                                text: item.name;
                                color: Theme.text;
                                font-size: 12px;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                            if item.detail != "": Text {
                                text: item.detail;
                                color: Theme.faint;
                                font-size: 10px;
                                vertical-alignment: center;
                            }
                        }
                        row := TouchArea { clicked => { picked = i; } }
                    }
                }
                if items.length == 0: Text {
                    text: category == 11 ? "Add a folder to see its samples" : "Nothing here yet";
                    color: Theme.faint;
                    font-size: 11px;
                    vertical-alignment: top;
                    wrap: word-wrap;
                }
            }
        }
        Rectangle { height: 1px; background: Theme.line; }
        Text {
            text: "Select a sample or MIDI file to preview";
            color: Theme.faint;
            font-size: 11px;
            height: 18px;
            vertical-alignment: center;
        }
    }
}

// ---------------------------------------------------------------- devices

// A device's frame: a title bar with an on switch, and its controls.
component Device inherits Rectangle {
    in property <string> title;
    in property <color> tint: Theme.accent;
    in property <bool> selected;
    in-out property <bool> on: true;
    // The on/off square was clicked; `on` already changed.
    callback toggled(bool);
    // The title was clicked.
    callback opened();
    border-radius: 3px;
    background: Theme.panel-2;
    border-width: 1px;
    border-color: selected ? tint : Theme.line;
    Rectangle {
        y: 0;
        height: 24px;
        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            spacing: 7px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 10px;
                    height: 10px;
                    border-radius: 2px;
                    background: on ? tint : transparent;
                    border-width: 1px;
                    border-color: tint;
                    TouchArea { clicked => { root.on = !root.on; root.toggled(root.on); } }
                }
            }
            Text {
                text: title;
                color: on ? Theme.text : Theme.dim;
                font-size: 12px;
                font-weight: 600;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
                TouchArea { clicked => { root.opened(); } }
            }
            Text { text: "×"; color: Theme.faint; font-size: 13px; vertical-alignment: center; }
        }
    }
    Rectangle {
        y: 24px;
        height: parent.height - 24px;
        opacity: on ? 1 : 0.45;
        @children
    }
}

component Field inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    spacing: 2px;
    Text { text: label; color: Theme.dim; font-size: 10px; }
    Rectangle {
        height: 20px;
        border-radius: 2px;
        background: Theme.bg;
        Text {
            x: parent.width - self.width - 6px;
            text: value;
            color: Theme.text;
            font-size: 11px;
            font-family: "monospace";
        }
    }
}

// The selected clip: name, length and loop.
component ClipPanel inherits Rectangle {
    in property <SlotData> data;
    in property <bool> has-clip;
    property <bool> loop: true;
    border-radius: 3px;
    background: Theme.panel-2;
    border-width: 1px;
    border-color: Theme.line;
    if !has-clip: Text {
        text: "Select a clip";
        color: Theme.faint;
        font-size: 12px;
    }
    if has-clip: VerticalLayout {
        padding: 8px;
        spacing: 6px;
        HorizontalLayout {
            spacing: 6px;
            height: 18px;
            VerticalLayout {
                alignment: center;
                Rectangle { width: 10px; height: 10px; border-radius: 2px; background: data.color; }
            }
            Text {
                text: data.name;
                color: Theme.text;
                font-size: 12px;
                font-weight: 600;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
            Text {
                text: data.beats + " beats";
                color: Theme.dim;
                font-size: 10px;
                vertical-alignment: center;
            }
        }
        HorizontalLayout {
            spacing: 8px;
            Field { label: "Start"; value: "1.1.1"; }
            Field { label: "End"; value: (floor(data.beats / 4) + 1) + "." + (mod(data.beats, 4) + 1) + ".1"; }
        }
        Rectangle {
            height: 22px;
            border-radius: 2px;
            background: loop ? #d9d9dc : Theme.slot;
            Text { text: "Loop"; color: loop ? #101112 : Theme.text; font-size: 11px; font-weight: 600; }
            TouchArea { clicked => { root.loop = !root.loop; } }
        }
        HorizontalLayout {
            spacing: 8px;
            Field { label: "Signature"; value: "4 / 4"; }
            Field { label: "Groove"; value: "None"; }
        }
        Rectangle { vertical-stretch: 1; }
    }
}

// An instrument's eight knobs in two rows, as Push's encoders turn them.
component ParamKnobs inherits VerticalLayout {
    in property <[ParamData]> params;
    in property <color> tint;
    callback changed(int, float);
    spacing: 8px;
    alignment: center;
    for row in 2: HorizontalLayout {
        spacing: 4px;
        for col in 4: Knob {
            label: params[row * 4 + col].name;
            display: params[row * 4 + col].text;
            value: params[row * 4 + col].value;
            tint: root.tint;
            width: 62px;
            changed(v) => { root.changed(row * 4 + col, v); }
        }
    }
}

component DrumPad inherits Rectangle {
    in property <string> label;
    in property <int> pitch;
    in property <color> tint;
    callback note(int, float);
    border-radius: 2px;
    background: ta.pressed ? tint : tint.with-alpha(ta.has-hover ? 0.32 : 0.2);
    Text { text: label; color: Theme.text; font-size: 10px; }
    ta := TouchArea {
        pointer-event(e) => {
            if e.button == PointerEventButton.left && e.kind == PointerEventKind.down {
                root.note(root.pitch, 0.9);
            } else if e.button == PointerEventButton.left && e.kind == PointerEventKind.up {
                root.note(root.pitch, 0);
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "openDJ Studio";
    preferred-width: 1440px;
    preferred-height: 900px;
    min-width: 1280px;
    min-height: 760px;
    background: Theme.bg;
    default-font-size: 12px;

    in property <[TrackData]> tracks;
    // Scene-major: slot (scene s, track t) is at s * tracks.length + t.
    in property <[SlotData]> slots;
    in property <int> scenes: 8;
    in property <bool> playing;
    in property <string> tempo: "124.0";
    in property <string> position: "1.1";
    in property <bool> link;
    in property <int> peers;
    in property <string> quantize: "1 Bar";
    in property <string> load: "0%";
    in property <string> status;
    in property <bool> blink;
    in property <float> main-level;
    // Set from the shared controls: the window and Push both select.
    in property <int> selected-track: 0;
    in property <int> selected-scene: -1;
    in property <float> main-volume: 60 / 66;
    in property <string> return-a: "A Return";
    in property <string> return-b: "B Return";
    in property <color> return-a-color: Theme.return-a;
    in property <color> return-b-color: Theme.return-b;

    callback launch-clip(int, int);   // track, scene
    callback launch-scene(int);
    callback stop-track(int);
    callback stop-all();
    callback toggle-play();
    callback tempo-step(float);
    callback toggle-link();
    callback next-quantize();
    callback select(int, int);         // track, scene (-1 for none)
    // Track, control (0 volume, 1 pan, 2 send A, 3 send B), value 0..1.
    callback mix(int, int, float);
    callback main-volume-changed(float);
    // Track, instrument knob, value 0..1.
    callback param(int, int, float);
    // Track, pitch, velocity (0 ends the note).
    callback play-note(int, int, float);
    // A device in the chain: switch it on or off, open its window.
    callback toggle-device(int, int, bool);
    callback open-device(int, int);

    property <TrackData> track: tracks[selected-track];
    property <bool> has-clip: selected-scene >= 0
        && slots[selected-scene * tracks.length + selected-track].state != SlotState.empty;

    VerticalLayout {
        // ------------------------------------------------------- top bar
        Rectangle {
            height: 40px;
            background: Theme.panel;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 10px;
                Text {
                    text: "openDJ Studio";
                    color: Theme.accent;
                    font-size: 14px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                Rectangle { width: 12px; }
                VerticalLayout { alignment: center; Pill { label: "−"; clicked => { root.tempo-step(-1); } } }
                Readout { title: "BPM"; value: root.tempo; value-width: 44px; }
                VerticalLayout { alignment: center; Pill { label: "+"; clicked => { root.tempo-step(1); } } }
                VerticalLayout { alignment: center; Pill { label: "4 / 4"; } }
                VerticalLayout {
                    alignment: center;
                    Pill { label: "Launch " + root.quantize; clicked => { root.next-quantize(); } }
                }
                VerticalLayout {
                    alignment: center;
                    Pill {
                        label: root.link ? "LINK · " + root.peers : "LINK";
                        on: root.link;
                        clicked => { root.toggle-link(); }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                VerticalLayout {
                    alignment: center;
                    Pill { label: "▶"; on: root.playing; clicked => { if !root.playing { root.toggle-play(); } } }
                }
                VerticalLayout {
                    alignment: center;
                    Pill { label: "■"; clicked => { if root.playing { root.toggle-play(); } } }
                }
                VerticalLayout { alignment: center; Pill { label: "●"; enabled: false; } }
                Readout { title: ""; value: root.position; value-width: 52px; }
                Rectangle { horizontal-stretch: 1; }
                Readout { title: "CPU"; value: root.load; value-width: 36px; }
                VerticalLayout { alignment: center; Pill { label: "Session"; on: true; } }
                VerticalLayout { alignment: center; Pill { label: "Arrangement"; enabled: false; } }
            }
        }
        Rectangle { height: 1px; background: Theme.line; }

        HorizontalLayout {
            vertical-stretch: 1;
            Browser { width: 310px; }
            Rectangle { width: 1px; background: Theme.line; }

            VerticalLayout {
                horizontal-stretch: 1;
                // ------------------------------------------- session view
                session := Rectangle {
                    vertical-stretch: 1;
                    background: Theme.bg;
                    property <length> col-w: 128px;
                    property <length> ret: 104px;
                    property <length> main: 104px;
                    property <length> gap: 2px;
                    property <length> head: 24px;
                    property <length> row-h: 22px;
                    property <length> mixer: 186px;
                    property <length> stop-y: head + gap + scenes * (row-h + gap);
                    property <length> ret-x: self.width - main - 2 * (ret + gap) - gap;
                    property <length> main-x: self.width - main;
                    property <length> mixer-y: self.height - mixer;
                    property <length> tracks-end: tracks.length * (col-w + gap);

                    // Tracks, scrolling sideways when there are more than fit.
                    Flickable {
                    x: 0;
                    y: 0;
                    width: session.ret-x - session.gap;
                    height: session.height;
                    content-width: max(self.width, session.tracks-end + 160px);
                    for t[i] in tracks: Rectangle {
                        x: i * (session.col-w + session.gap);
                        width: session.col-w;
                        height: session.height;
                        background: Theme.panel.with-alpha(0.5);
                        // Header.
                        Rectangle {
                            y: 0;
                            height: session.head;
                            background: i == selected-track ? t.color : t.color.with-alpha(0.8);
                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                spacing: 5px;
                                Text {
                                    text: (i + 1) + " " + t.name;
                                    color: #101112;
                                    font-size: 12px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                                Text { text: t.kind; color: #10111299; font-size: 9px; font-weight: 700; vertical-alignment: center; }
                            }
                            TouchArea { clicked => { root.select(i, selected-scene); } }
                        }
                        // Clip slots.
                        for s in scenes: ClipSlot {
                            y: session.head + session.gap + s * (session.row-h + session.gap);
                            height: session.row-h;
                            data: slots[s * tracks.length + i];
                            blink: root.blink;
                            progress: t.progress;
                            selected: i == selected-track && s == selected-scene;
                            launch => { root.launch-clip(i, s); }
                        }
                        // Stop button.
                        Rectangle {
                            y: session.stop-y;
                            height: session.row-h;
                            background: stop.has-hover ? Theme.slot-hover : Theme.slot;
                            border-width: t.stopping ? 1px : 0px;
                            border-color: root.blink ? Theme.queued : Theme.queued.with-alpha(0.25);
                            Rectangle {
                                width: 8px;
                                height: 8px;
                                background: t.progress >= 0 ? Theme.text : Theme.faint;
                            }
                            stop := TouchArea { clicked => { root.stop-track(i); } }
                        }
                        // Selection outline.
                        if i == selected-track: Rectangle {
                            border-width: 1px;
                            border-color: t.color;
                        }
                        // Mixer strip.
                        Strip {
                            y: session.mixer-y;
                            height: session.mixer;
                            tint: t.color;
                            number: i + 1;
                            level: t.level;
                            volume: t.volume;
                            pan: t.pan;
                            pan-text: t.pan-text;
                            send-a: t.send-a;
                            send-b: t.send-b;
                            changed(which, v) => { root.mix(i, which, v); }
                        }
                        Rectangle {
                            y: session.mixer-y;
                            height: 1px;
                            background: t.color;
                        }
                    }

                    // Drop area for new tracks.
                    Rectangle {
                        x: session.tracks-end + 10px;
                        y: session.head + session.gap;
                        width: max(0px, session.ret-x - session.tracks-end - 20px);
                        height: session.mixer-y - session.head - 2 * session.gap;
                        if self.width > 130px: VerticalLayout {
                            alignment: start;
                            spacing: 4px;
                            for label in ["+ MIDI track", "+ Audio track", "+ Return track"]: HorizontalLayout {
                                alignment: start;
                                Rectangle {
                                    width: 110px;
                                    height: 22px;
                                    border-radius: 2px;
                                    background: add.has-hover ? Theme.slot-hover : Theme.slot;
                                    Text { x: 8px; text: label; color: Theme.dim; font-size: 11px; }
                                    add := TouchArea { }
                                }
                            }
                        }
                        if self.width > 200px: Text {
                            text: "Drop files or devices to add a track";
                            color: Theme.faint;
                            font-size: 12px;
                        }
                    }

                    }

                    // Returns A and B.
                    for r[i] in [
                        { name: root.return-a, color: root.return-a-color, letter: "A" },
                        { name: root.return-b, color: root.return-b-color, letter: "B" },
                    ]: Rectangle {
                        x: session.ret-x + i * (session.ret + session.gap);
                        width: session.ret;
                        height: session.height;
                        background: r.color.with-alpha(0.06);
                        Rectangle {
                            y: 0;
                            height: session.head;
                            background: r.color;
                            Text {
                                x: 6px;
                                text: r.name;
                                color: #101112;
                                font-size: 12px;
                                font-weight: 700;
                            }
                        }
                        Strip {
                            y: session.mixer-y;
                            height: session.mixer;
                            tint: r.color;
                            number: r.letter;
                            sends: false;
                            arm: false;
                            free: true;
                            level: 0;
                        }
                        Rectangle { y: session.mixer-y; height: 1px; background: r.color; }
                    }

                    // Main: scene launch buttons and the main fader.
                    Rectangle {
                        x: session.main-x;
                        width: session.main;
                        height: session.height;
                        background: Theme.panel;
                        Rectangle {
                            y: 0;
                            height: session.head;
                            background: Theme.select;
                            Text {
                                x: 6px;
                                text: "Main";
                                color: Theme.text;
                                font-size: 12px;
                                font-weight: 700;
                            }
                        }
                        for s in scenes: Rectangle {
                            y: session.head + session.gap + s * (session.row-h + session.gap);
                            height: session.row-h;
                            background: sa.has-hover ? Theme.slot-hover : Theme.slot;
                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                spacing: 6px;
                                Text { text: "▶"; color: Theme.dim; font-size: 10px; vertical-alignment: center; width: 10px; }
                                Text {
                                    text: s + 1;
                                    color: Theme.text;
                                    font-size: 11px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                            }
                            sa := TouchArea { clicked => { root.launch-scene(s); } }
                        }
                        Rectangle {
                            y: session.stop-y;
                            height: session.row-h;
                            background: stop-all.has-hover ? Theme.slot-hover : Theme.slot;
                            HorizontalLayout {
                                padding-left: 6px;
                                spacing: 6px;
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle { width: 8px; height: 8px; background: Theme.text; }
                                }
                                Text { text: "Stop all"; color: Theme.text; font-size: 11px; vertical-alignment: center; }
                            }
                            stop-all := TouchArea { clicked => { root.stop-all(); } }
                        }
                        Strip {
                            y: session.mixer-y;
                            height: session.mixer;
                            tint: Theme.accent;
                            number: "M";
                            sends: false;
                            arm: false;
                            level: root.main-level;
                            volume: root.main-volume;
                            changed(which, v) => {
                                if which == 0 {
                                    root.main-volume-changed(v);
                                }
                            }
                        }
                        Rectangle { y: session.mixer-y; height: 1px; background: Theme.select; }
                    }
                }
                Rectangle { height: 1px; background: Theme.line; }

                // ------------------------------------------- device row
                Rectangle {
                    height: 214px;
                    background: Theme.panel;
                    // Scrolls sideways when the chain is wider than the window.
                    Flickable {
                    content-width: max(self.width, 1270px);
                    HorizontalLayout {
                        width: max(parent.width, 1270px);
                        padding: 8px;
                        spacing: 6px;
                        alignment: start;
                        ClipPanel {
                            width: 200px;
                            has-clip: root.has-clip;
                            data: root.has-clip ? slots[selected-scene * tracks.length + selected-track] : { name: "", beats: 0 };
                        }
                        if track.audio: Device {
                            width: 180px;
                            title: "Audio In";
                            tint: track.color;
                            selected: true;
                            VerticalLayout {
                                padding: 10px;
                                spacing: 6px;
                                Text { text: track.input == "" ? "No input" : track.input; color: Theme.text; font-size: 13px; font-weight: 600; }
                                Text { text: "Recordings play from the clips. Live input and monitoring come next."; color: Theme.dim; font-size: 11px; wrap: word-wrap; }
                            }
                        }
                        if track.drums: Device {
                            width: 480px;
                            title: track.device;
                            tint: track.color;
                            selected: true;
                            HorizontalLayout {
                                padding: 8px;
                                spacing: 10px;
                                // Laid out as Push plays them in Note mode.
                                GridLayout {
                                    spacing: 3px;
                                    width: 190px;
                                    Row {
                                        DrumPad { label: "Ride"; pitch: 51; tint: track.color; note(p, v) => { root.play-note(selected-track, p, v); } }
                                        Rectangle { }
                                        Rectangle { }
                                        Rectangle { }
                                    }
                                    Row {
                                        DrumPad { label: "Clap"; pitch: 39; tint: track.color; note(p, v) => { root.play-note(selected-track, p, v); } }
                                        DrumPad { label: "Rim"; pitch: 37; tint: track.color; note(p, v) => { root.play-note(selected-track, p, v); } }
                                        DrumPad { label: "Cowbell"; pitch: 56; tint: track.color; note(p, v) => { root.play-note(selected-track, p, v); } }
                                        DrumPad { label: "Crash"; pitch: 49; tint: track.color; note(p, v) => { root.play-note(selected-track, p, v); } }
                                    }
                                    Row {
                                        DrumPad { label: "Kick"; pitch: 36; tint: track.color; note(p, v) => { root.play-note(selected-track, p, v); } }
                                        DrumPad { label: "Snare"; pitch: 38; tint: track.color; note(p, v) => { root.play-note(selected-track, p, v); } }
                                        DrumPad { label: "Closed hat"; pitch: 42; tint: track.color; note(p, v) => { root.play-note(selected-track, p, v); } }
                                        DrumPad { label: "Open hat"; pitch: 46; tint: track.color; note(p, v) => { root.play-note(selected-track, p, v); } }
                                    }
                                }
                                ParamKnobs {
                                    params: track.params;
                                    tint: track.color;
                                    changed(i, v) => { root.param(selected-track, i, v); }
                                }
                            }
                        }
                        if !track.drums && !track.audio && !track.plugin-instrument: Device {
                            width: 300px;
                            title: track.device;
                            tint: track.color;
                            selected: true;
                            HorizontalLayout {
                                padding: 8px;
                                alignment: center;
                                ParamKnobs {
                                    params: track.params;
                                    tint: track.color;
                                    changed(i, v) => { root.param(selected-track, i, v); }
                                }
                            }
                        }
                        // A set's own devices: plug-ins run, Live's own are
                        // listed until they have built-in matches.
                        for d[i] in track.chain: Device {
                            width: 150px;
                            title: d.name;
                            on: d.on;
                            tint: d.kind == "Live" ? Theme.faint : Theme.effect;
                            toggled(v) => { root.toggle-device(selected-track, i, v); }
                            opened => { root.open-device(selected-track, i); }
                            VerticalLayout {
                                padding: 10px;
                                spacing: 6px;
                                Text { text: d.kind; color: Theme.text; font-size: 12px; font-weight: 700; }
                                Text { text: d.note; color: Theme.dim; font-size: 11px; wrap: word-wrap; }
                                if d.can-open: Rectangle {
                                    height: 22px;
                                    border-radius: 3px;
                                    background: open-area.has-hover ? Theme.line : Theme.bg;
                                    Text { text: "Open window"; color: Theme.text; font-size: 11px; }
                                    open-area := TouchArea { clicked => { root.open-device(selected-track, i); } }
                                }
                            }
                        }
                        if track.chain.length == 0: Device {
                            width: 250px;
                            title: "EQ";
                            tint: Theme.effect;
                            HorizontalLayout {
                                padding: 8px;
                                spacing: 2px;
                                alignment: center;
                                Knob { free: true; label: "Low"; display: "0 dB"; bipolar: true; size: 36px; tint: Theme.effect; }
                                Knob { free: true; label: "Mid"; display: "0 dB"; bipolar: true; size: 36px; tint: Theme.effect; }
                                Knob { free: true; label: "High"; display: "0 dB"; bipolar: true; size: 36px; tint: Theme.effect; }
                                Knob { free: true; label: "Output"; display: "0 dB"; bipolar: true; size: 36px; tint: Theme.effect; }
                            }
                        }
                        if track.chain.length == 0: Device {
                            width: 230px;
                            title: "Echo";
                            tint: Theme.effect;
                            HorizontalLayout {
                                padding: 8px;
                                spacing: 2px;
                                alignment: center;
                                Knob { free: true; label: "Time"; display: "1/8"; value: 0.4; size: 36px; tint: Theme.effect; }
                                Knob { free: true; label: "Feedback"; display: "35%"; value: 0.35; size: 36px; tint: Theme.effect; }
                                Knob { free: true; label: "Dry/Wet"; display: "20%"; value: 0.2; size: 36px; tint: Theme.effect; }
                            }
                        }
                        Rectangle {
                            width: 130px;
                            border-radius: 3px;
                            border-width: 1px;
                            border-color: Theme.line;
                            Text {
                                text: "+\nDrop an effect here";
                                color: Theme.faint;
                                font-size: 11px;
                                horizontal-alignment: center;
                            }
                        }
                    }
    }
                }
            }
        }

        // ------------------------------------------------------- status
        Rectangle {
            height: 22px;
            background: Theme.panel;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                Text {
                    text: root.status;
                    color: Theme.dim;
                    font-size: 11px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Text {
                    text: tracks.length + " tracks · " + scenes + " scenes · sends, returns and effects are a preview";
                    color: Theme.faint;
                    font-size: 11px;
                    vertical-alignment: center;
                }
            }
        }
    }
}
