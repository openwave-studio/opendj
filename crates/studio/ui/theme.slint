// Colours and the small controls the Studio window and the piano roll share.

export global Theme {
    out property <color> bg: #101112;
    out property <color> panel: #161819;
    out property <color> panel-2: #1b1d1f;
    out property <color> slot: #1e2022;
    out property <color> slot-hover: #26292b;
    out property <color> line: #2a2d30;
    out property <color> text: #e8e8ea;
    out property <color> dim: #8b8d91;
    out property <color> faint: #55585c;
    out property <color> accent: #B69CFF;
    out property <color> accent-dark: #8C72D9;
    out property <color> select: #4A4A4D;
    out property <color> playing: #7ee08a;
    out property <color> queued: #ffd166;
    out property <color> effect: #ff9f5a;
    out property <color> midi-fx: #ffd166;
    out property <color> return-a: #8C72D9;
    out property <color> return-b: #5d8cc9;
    out property <length> radius: 3px;
}

export component Pill inherits Rectangle {
    in property <string> label;
    in property <bool> on;
    in property <bool> enabled: true;
    callback clicked;
    height: 24px;
    min-width: 28px;
    border-radius: 3px;
    background: on ? Theme.accent : (ta.has-hover ? Theme.slot-hover : Theme.slot);
    opacity: enabled ? 1 : 0.4;
    HorizontalLayout {
        padding-left: 9px;
        padding-right: 9px;
        Text {
            text: label;
            color: on ? #101112 : Theme.text;
            font-size: 12px;
            font-weight: 600;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// A drop-down: the current choice, and a list to pick from.
export component Picker inherits Rectangle {
    in property <string> text;
    in property <[string]> options;
    in property <length> text-size: 10px;
    callback picked(int);
    height: 18px;
    border-radius: 2px;
    background: ta.has-hover ? Theme.slot-hover : Theme.slot;
    HorizontalLayout {
        padding-left: 5px;
        padding-right: 4px;
        spacing: 2px;
        Text {
            text: root.text;
            color: Theme.text;
            font-size: root.text-size;
            overflow: elide;
            horizontal-stretch: 1;
            vertical-alignment: center;
        }
        Text { text: "▾"; color: Theme.dim; font-size: 9px; vertical-alignment: center; }
    }
    ta := TouchArea { clicked => { popup.show(); } }
    popup := PopupWindow {
        x: 0;
        y: root.height;
        width: max(root.width, 170px);
        Rectangle {
            background: Theme.panel-2;
            border-width: 1px;
            border-color: Theme.line;
            VerticalLayout {
                padding: 2px;
                for o[i] in root.options: Rectangle {
                    height: 20px;
                    background: oa.has-hover ? Theme.select : transparent;
                    Text {
                        x: 6px;
                        width: parent.width - 12px;
                        text: o;
                        color: o == root.text ? Theme.accent : Theme.text;
                        font-size: 11px;
                        overflow: elide;
                    }
                    oa := TouchArea { clicked => { root.picked(i); } }
                }
            }
        }
    }
}
