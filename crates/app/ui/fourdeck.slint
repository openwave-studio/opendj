// The 4-Deck layout, after djay Pro's Four Decks: four strips side by side,
// decks 3, 1, 2 and 4 from the left, each with its header, a small mixer
// channel, PLAY, CUE, the loop and pads. Under them a bar with each deck's
// crossfader side, SYNC and tempo either side of the crossfader; the FX
// are in the FX bar under that.
// A two-deck controller (the DDJ-FLX4) plays decks 1 and 2 until a strip's
// deck number is clicked: then that side plays deck 3 or 4.
import { LibraryEdit, TrackDrag } from "library.slint";
import { InstrumentsUi } from "instruments.slint";
import { Theme } from "theme.slint";
import { ControlButton, ControlFader, Controls, Crossfader, CueHeadphones, StereoMeter, SyncButton } from "controls.slint";
import { DeckInfo, Header, LiveStrip, LoopStepper, Pads, PadsUi, PlayButton, TempoRangeRow } from "deck.slint";
import { AudioSettings, Knob, ModeMenu, SideKnob } from "mixer.slint";
import { PillCaret, SectionTitle, SwitchPill } from "pills.slint";

// Which side of the crossfader a deck is on, as Mixxx's `orientation`:
// 0 left, 1 thru (not faded), 2 right. Click to pick, as in djay.
component CrossfaderAssign inherits Rectangle {
    in property <int> deck;
    property <string> group: "[Channel" + (deck + 1) + "]";
    property <int> index: Controls.resolve(group, "orientation");
    property <int> side: Controls.value(index, Controls.tick);
    // Dimmed while the crossfader is switched off; the choice stays.
    property <int> enabled-index: Controls.resolve("[Mixer]", "crossfader_enabled");
    width: 56px;
    opacity: Controls.value(enabled-index, Controls.tick) > 0 ? 1 : 0.35;
    // A press steps Left, Thru, Right and round; lit while on a side.
    SwitchPill {
        y: (parent.height - self.height) / 2;
        width: parent.width;
        text: ["Left", "Thru", "Right"][side];
        on: side != 1;
        clicked => { Controls.set-value(index, Math.mod(side + 1, 3)); }
    }
}

// One deck's strip.
export component DeckStrip inherits Rectangle {
    in property <int> deck;
    in property <DeckInfo> info;
    in property <image> overview;
    // The pad grid: off when the DJ hid it, or while the window is too
    // short for it (main.slint folds it).
    in property <bool> pads-shown: PadsUi.visible;
    out property <length> overview-width: header.overview-width;
    out property <length> overview-height: header.overview-height;
    property <string> group: "[Channel" + (deck + 1) + "]";
    property <color> tint: Theme.deck-color(deck);
    // A two-deck controller's left side plays deck 1 or 3, its right side
    // deck 2 or 4, as `[Controller],deck3` and `deck4` say. Clicking a deck's
    // number moves that side to it; the number is lit on the deck the side
    // plays while a controller is connected.
    property <int> layer-index: Controls.resolve("[Controller]", Math.mod(deck, 2) == 0 ? "deck3" : "deck4");
    property <bool> layer-on: Controls.value(layer-index, Controls.tick) > 0;
    property <bool> controller-here: AudioSettings.controllers != "None" && (deck >= 2) == layer-on;
    // A hardware mixer does the mixing: the channel shows only its meter.
    property <bool> external: Controls.value(Controls.resolve("[Master]", "external_mixer"), Controls.tick) > 0;
    // Files dragged in from Finder or a file manager (see TrackDrag.files-over).
    property <bool> under-files: TrackDrag.files-x >= self.absolute-position.x && TrackDrag.files-x < self.absolute-position.x + self.width
        && TrackDrag.files-y >= self.absolute-position.y && TrackDrag.files-y < self.absolute-position.y + self.height;
    property <bool> files-here: TrackDrag.files-over && under-files;
    property <int> files-dropped: TrackDrag.files-dropped;
    changed files-dropped => {
        if under-files && live > 0 {
            // An image becomes its art; anything else loads as a track.
            InstrumentsUi.drop-art(deck, live, InstrumentsUi.instrument());
        } else if under-files {
            TrackDrag.drop-files(deck);
        }
    }
    // A live input played through the deck (see Header.live).
    property <bool> groove: Controls.value(Controls.resolve("[Groove" + (deck + 1) + "]", "enabled"), Controls.tick) > 0;
    property <int> live: info.loaded || groove ? 0 : InstrumentsUi.live(deck);

    // Tracks dragged from the browser load here, as on the other layouts.
    // First, so the sampler pads' own drop areas sit above it.
    drop := DropArea {
        can-drop(e) => { TrackDrag.accepts(e.data) || InstrumentsUi.item(e.data) >= 0 ? DragAction.copy : DragAction.none }
        dropped(e) => {
            if InstrumentsUi.item(e.data) >= 0 {
                InstrumentsUi.drop(deck, InstrumentsUi.item(e.data));
            } else {
                TrackDrag.drop(deck, e.data);
            }
            TrackDrag.active = false;
            InstrumentsUi.dragging = false;
            DragAction.copy
        }
    }
    VerticalLayout {
        spacing: 1px;
        header := Header {
            deck: deck;
            info: info;
            overview: overview;
            group: group;
            compact: true;
            number-lit: controller-here;
            number-clicked => { Controls.set-value(layer-index, deck >= 2 ? 1 : 0); }
        }
        Rectangle {
            background: Theme.panel;
            vertical-stretch: 1;
            VerticalLayout {
                padding: 6px;
                spacing: 6px;
                // The channel: the knob mode and headphone cue, the EQs (or
                // stems or sculpt), the fader, and gain over the meter.
                HorizontalLayout {
                    height: 74px;
                    spacing: 4px;
                    if external: Text {
                        horizontal-stretch: 1;
                        text: "On the external mixer";
                        color: Theme.text-dim;
                        font-size: 11px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    if !external: VerticalLayout {
                        width: 44px;
                        alignment: space-around;
                        Rectangle {
                            height: 22px;
                            border-radius: 6px;
                            background: Theme.n-2a2a2d;
                            ModeMenu { width: parent.width; height: parent.height; }
                        }
                        HorizontalLayout { alignment: center; CueHeadphones { group: group; tint: tint; width: 30px; } }
                    }
                    // The `if` round the `for`: a repeater whose count reads
                    // `external` is rebuilt on every Controls tick, which drops
                    // the knob under a drag (only the scroll wheel got through).
                    if !external: HorizontalLayout {
                        spacing: 4px;
                        horizontal-stretch: 4;
                        for place in 4: SideKnob { deck: deck; place: [2, 1, 0, 3][place]; size: 32px; cfx-menu-left: false; horizontal-stretch: 1; min-width: 40px; }
                    }
                    if !external: ControlFader { group: group; key: "volume"; tint: tint; ticks: 5; width: 40px; look: 1; }
                    VerticalLayout {
                        spacing: 4px;
                        if !external: Knob { group: group; key: "pregain"; size: 20px; look: 4; readout: 1; arc-color: Theme.accent; }
                        HorizontalLayout { alignment: center; vertical-stretch: 1; StereoMeter { group: group; } }
                    }
                }
                if live > 0: LiveStrip { live: live; group: group; tint: tint; vertical-stretch: 1; min-height: 115px; }
                // PLAY, CUE and the loop.
                if live == 0: HorizontalLayout {
                    spacing: 6px;
                    PlayButton { group: group; tint: tint; width: 48px; height: 32px; }
                    ControlButton { group: group; key: "cue_default"; text: "CUE"; momentary: true; tint: Theme.cue-lit; outline-when-lit: true; font-size: 13px; width: 48px; height: 32px; }
                    // The loop as on 2-Deck: length, LOOP, then IN/OUT.
                    HorizontalLayout {
                        horizontal-stretch: 1;
                        alignment: end;
                        spacing: 6px;
                        LoopStepper { group: group; info: info; width: 88px; height: 32px; }
                        // The word goes in a small window, so OUT keeps its room.
                        if LibraryEdit.window-width >= 1440px: SectionTitle { title: "Loop"; font-size: 11px; }
                        ControlButton { group: group; key: "loop_in"; light-key: "loop_in_pending"; text: "IN"; momentary: true; tint: Theme.n-d1d1d6; font-size: 11px; width: 40px; height: 32px; }
                        ControlButton { group: group; key: "loop_out"; light-key: "loop_enabled"; text: "OUT"; momentary: true; tint: Theme.lilac; font-size: 11px; width: 40px; height: 32px; }
                    }
                }
                if live == 0 && pads-shown: Pads { deck: deck; group: group; info: info; vertical-stretch: 1; min-height: 77px; }
            }
        }
    }

    if TrackDrag.active || InstrumentsUi.dragging || TrackDrag.files-over || drop.has-drag: Rectangle {
        border-radius: Theme.radius + 2px;
        border-width: drop.has-drag || files-here ? 3px : 2px;
        border-color: drop.has-drag || files-here ? tint : tint.transparentize(0.55);
        background: drop.has-drag || files-here ? tint.transparentize(0.9) : transparent;
    }
}

// The tempo under its BPM: a click opens key lock, quantize, a reset and
// the fader's range.
export component TempoMenu inherits Rectangle {
    in property <string> group;
    in property <string> rate;
    // The fader's range as shown, e.g. "8%".
    in property <string> range;
    in property <color> tint;
    // Decks 2 and 4: the range list opens leftwards.
    in property <bool> mirrored;
    property <int> rate-index: Controls.resolve(group, "rate");
    height: 18px;
    min-width: rate-row.preferred-width;
    border-radius: 6px;
    background: ta.has-hover ? Theme.pill-hover : Theme.pill;
    border-width: 1px;
    border-color: ta.has-hover ? Theme.n-6e58a8 : Theme.n-2c2c31;
    rate-row := HorizontalLayout {
        alignment: center;
        padding-left: 6px;
        padding-right: 6px;
        spacing: 4px;
        Text { text: rate; color: ta.has-hover ? Theme.text : Theme.text-dim; font-size: 10px; font-family: "Inter Tabular"; vertical-alignment: center; }
        VerticalLayout { alignment: center; PillCaret { } }
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { menu.show(); } }
    menu := PopupWindow {
        x: (root.width - 130px) / 2;
        y: root.height + 4px;
        width: 130px;
        close-policy: close-on-click-outside;
        Rectangle {
            background: Theme.pill-list;
            border-radius: 9px;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 14px;
            drop-shadow-color: Theme.s-000000a0;
        }
        VerticalLayout {
            padding: 8px;
            spacing: 6px;
            ControlButton { group: group; key: "keylock"; text: "Key lock"; tint: tint; pill: true; font-size: 11px; height: 26px; }
            ControlButton { group: group; key: "quantize"; text: "Quantize"; tint: tint; pill: true; font-size: 11px; height: 26px; }
            Rectangle {
                height: 26px;
                border-radius: Theme.radius;
                background: rta.pressed ? Theme.control-pressed : rta.has-hover ? Theme.n-1d1d20 : Theme.control;
                border-width: 1px;
                border-color: Theme.border;
                Text { text: "Reset"; color: Theme.text; font-size: 11px; font-weight: 600; }
                rta := TouchArea {
                    clicked => {
                        Controls.set-value(rate-index, 0);
                        menu.close();
                    }
                }
            }
            TempoRangeRow { group: group; range: range; mirrored: mirrored; }
        }
    }
}

// One deck's part of the bar under the strips: which side of the
// crossfader it is on, SYNC, the BPM and tempo, and fine + and −. Decks 2
// and 4 have the crossfader side last, towards the outside.
component DeckBarSection inherits Rectangle {
    in property <int> deck;
    in property <DeckInfo> info;
    property <string> group: "[Channel" + (deck + 1) + "]";
    property <color> tint: Theme.deck-color(deck);
    property <bool> right: Math.mod(deck, 2) == 1;
    property <bool> external: Controls.value(Controls.resolve("[Master]", "external_mixer"), Controls.tick) > 0;
    background: Theme.panel;
    horizontal-stretch: 1;
    min-width: 0px;
    preferred-width: 0px;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 22px;
        alignment: start;
        if !right && !external: CrossfaderAssign { deck: deck; }
        SyncButton { group: group; tint: tint; menu-right-aligned: right; font-size: 12px; width: 60px; height: 28px; y: (parent.height - self.height) / 2; }
        VerticalLayout {
            width: 52px;
            alignment: center;
            Text { text: info.loaded ? info.bpm : "--"; color: Theme.text; font-size: 14px; font-weight: 600; horizontal-alignment: center; }
            HorizontalLayout { alignment: center; TempoMenu { group: group; rate: info.rate; range: info.range; tint: tint; mirrored: right; } }
        }
        if right && !external: CrossfaderAssign { deck: deck; }
    }
}

// 4-Deck: the bar under the strips, decks 3, 1 | the crossfader | 2, 4,
// the middle as wide as the Beat FX under it. A right-click on the
// crossfader switches it off and on.
export component FourDeckBar inherits Rectangle {
    in property <[DeckInfo]> decks;
    property <int> enabled-index: Controls.resolve("[Mixer]", "crossfader_enabled");
    property <bool> on: Controls.value(enabled-index, Controls.tick) > 0;
    property <bool> external: Controls.value(Controls.resolve("[Master]", "external_mixer"), Controls.tick) > 0;
    background: Theme.n-000000;
    height: 48px;
    HorizontalLayout {
        spacing: 1px;
        DeckBarSection { deck: 2; info: decks[2]; }
        DeckBarSection { deck: 0; info: decks[0]; }
        Rectangle {
            background: Theme.panel;
            width: 254px;
            if external: Text { text: "EXTERNAL MIXER"; color: Theme.text-dim; font-size: 10px; font-weight: 600; letter-spacing: 0.5px; }
            if !external: HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 10px;
                // A right-click switches it off and on.
                VerticalLayout { alignment: center; horizontal-stretch: 1; Crossfader { } }
            }
        }
        DeckBarSection { deck: 1; info: decks[1]; }
        DeckBarSection { deck: 3; info: decks[3]; }
    }
}
