// The Prep layout: deck 1 alone, for getting In Prep tracks ready to play.
// Under the deck's header (cover, title, tempo, key, time, overview) one
// row: the grid editor on the left (one side of the 2-Deck grid editor
// bar), transport in the middle, and pads on the right under four tabs:
// Hot Cues, Loops (saved loops), Automix (where Automix mixes in and out)
// and Memory (memory cues, for Pioneer players). The large scrolling waveform above is deck 1's;
// dragging and the wheel zoom it, as on every large waveform. No mixer,
// crossfader or FX.
import { Theme } from "theme.slint";
import { ControlButton, ControlFader, Controls, HoverTip } from "controls.slint";
import { DeckInfo, Header, PadTab, PlayButton } from "deck.slint";
import { CueList } from "cues.slint";
import { GridEditorSide } from "grid_editor.slint";

export global PrepUi {
    // Whether the Prep layout is offered (off until v0.6).
    in property <bool> offered: false;
    // The loaded track's stage: 0 none (not in the library, or no
    // stages), 1 Inbox, 2 In Prep, 3 Play Ready.
    in property <int> stage;
    // Tracks still In Prep, the one loaded included.
    in property <int> left;
    // Checklist lines ticked on the loaded track, of how many: Play Ready
    // lights up when all are (see checklist.slint).
    in property <int> done;
    in property <int> total;
    // Quick review: seconds on this track, and the average per track
    // (0: none yet).
    in property <int> track-seconds;
    in property <int> average-seconds;
    // Moves to the next phrase (1) or back (-1).
    callback phrase(direction: int);
    // Moves the loaded track to Play Ready and loads the next In Prep
    // track (the grid is locked first, in PrepReady below).
    callback ready-next();

    public pure function clock(seconds: int) -> string {
        floor(seconds / 60) + ":" + (mod(seconds, 60) < 10 ? "0" : "") + mod(seconds, 60)
    }
    public pure function stage-name(stage: int) -> string {
        stage == 1 ? "Inbox" : stage == 2 ? "In Prep" : stage == 3 ? "Play Ready" : "Not in a stage"
    }
    public pure function stage-color(stage: int) -> color {
        stage == 1 ? Theme.stage-inbox : stage == 2 ? Theme.stage-prep : stage == 3 ? Theme.stage-ready : Theme.text-dim
    }
    // Locks deck 1's grid and moves on: the button and Enter both do this.
    public function ready() {
        Controls.set-value(Controls.resolve("[Channel1]", "bpmlock"), 1);
        ready-next();
    }
}

// A button that presses a control once (grid moves, beat jumps).
component PressButton inherits ControlButton {
    momentary: true;
    font-size: 12px;
    height: 22px;
}

// The grid editor's side for deck 1, as in the 2-Deck bar.
component PrepGrid inherits Rectangle {
    in property <string> group;
    in property <DeckInfo> info;
    background: Theme.pill;
    GridEditorSide { group: group; info: info; }
}

// Play and CUE, beat jumps of 4 to 32 beats and a loop, with a thin level
// fader at the right, since Prep has no mixer.
component PrepTransport inherits HorizontalLayout {
    in property <string> group;
    in property <DeckInfo> info;
    in property <color> tint;
    padding-left: 4px;
    padding-right: 4px;
    padding-top: 2px;
    padding-bottom: 2px;
    spacing: 4px;
    VerticalLayout {
        spacing: 2px;
        alignment: center;
        HorizontalLayout {
            alignment: center;
            spacing: 4px;
            ControlButton { group: group; key: "cue_default"; text: "CUE"; momentary: true; tip-title: "CUE"; tip-body: "Key: A"; tint: Theme.cue-lit; outline-when-lit: true; font-size: 14px; width: 108px; height: 24px; }
            PlayButton { group: group; tint: tint; width: 108px; height: 24px; }
        }
        HorizontalLayout {
            alignment: center;
            spacing: 4px;
            PressButton { group: group; key: "beatjump_4_backward"; text: "−4"; width: 52px; }
            PressButton { group: group; key: "beatjump_4_forward"; text: "+4"; width: 52px; }
            PressButton { group: group; key: "beatjump_8_backward"; text: "−8"; width: 52px; }
            PressButton { group: group; key: "beatjump_8_forward"; text: "+8"; width: 52px; }
        }
        HorizontalLayout {
            alignment: center;
            spacing: 4px;
            PressButton { group: group; key: "beatjump_16_backward"; text: "−16"; width: 52px; tip-title: "Back 4 bars"; tip-body: "Key: ←"; }
            PressButton { group: group; key: "beatjump_16_forward"; text: "+16"; width: 52px; tip-title: "On 4 bars"; tip-body: "Key: →  (Tab: the next phrase)"; }
            PressButton { group: group; key: "beatjump_32_backward"; text: "−32"; width: 52px; }
            PressButton { group: group; key: "beatjump_32_forward"; text: "+32"; width: 52px; }
        }
        HorizontalLayout {
            alignment: center;
            spacing: 4px;
            ControlButton { group: group; key: "beatloop_activate"; light-key: "loop_enabled"; text: "LOOP " + info.loop-size; momentary: true; tint: Theme.loop; font-size: 12px; height: 22px; width: 108px; }
            PressButton { group: group; key: "loop_in"; text: "IN"; width: 52px; tip-title: "Loop in"; tip-body: "Key: D"; }
            PressButton { group: group; key: "loop_out"; text: "OUT"; width: 52px; tip-title: "Loop out"; tip-body: "Key: F  (G: loop on and off)"; }
        }
    }
    ControlFader { group: group; key: "volume"; tint: tint; ticks: 5; width: 18px; look: 1; }
}

// One hot cue pad: its number and time, filled with its color once set.
// Click an empty pad to set it, a set one to jump there; Shift-click clears.
component PrepPad inherits Rectangle {
    in property <string> group;
    in property <int> number;
    property <color> saved-color: CueList.pad-colors[number - 1];
    property <string> name: CueList.pad-names[number - 1];
    in property <color> tint: saved-color.alpha > 0 ? saved-color : Theme.hotcues[number - 1];
    property <int> index: Controls.resolve(group, "hotcue_" + number + "_activate");
    property <int> clear-index: Controls.resolve(group, "hotcue_" + number + "_clear");
    property <bool> clearing;
    property <bool> tip-mine;
    property <bool> set: Controls.value(Controls.resolve(group, "hotcue_" + number + "_enabled"), Controls.tick) > 0;
    property <float> seconds: Controls.value(Controls.resolve(group, "hotcue_" + number + "_position"), Controls.tick);
    property <int> minutes: floor(seconds / 60);
    property <float> secs: mod(seconds, 60);
    property <int> tenths: floor(mod(seconds * 10, 10));
    property <string> time: minutes + ":" + (secs < 10 ? "0" : "") + floor(secs) + "." + tenths;
    // A rounded tile, as the decks' pads.
    border-radius: 7px;
    background: set ? (touch.pressed ? tint.darker(0.3) : tint) : touch.pressed ? Theme.control-pressed : touch.has-hover ? Theme.n-1d1d20 : Theme.control;
    border-width: set ? 0px : 1px;
    border-color: touch.has-hover ? Theme.n-48484c : Theme.n-2c2c31;
    VerticalLayout {
        padding: 7px;
        HorizontalLayout {
            spacing: 6px;
            Text { text: number; color: set ? Theme.f-ffffff : Theme.text-dim; font-size: 13px; font-weight: 700; }
            if set: Text { text: name; color: Theme.f-ffffff; font-size: 12px; font-weight: 600; overflow: elide; horizontal-stretch: 1; }
        }
        Rectangle { vertical-stretch: 1; }
        Text { text: set ? time : "Click to set"; color: set ? Theme.n-ffffffd0 : Theme.text-dim; font-family: "Inter Tabular"; font-size: 11px; overflow: elide; }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if e.button != PointerEventButton.left && e.kind != PointerEventKind.cancel {
                return;
            }
            if e.kind == PointerEventKind.down {
                if e.modifiers.shift {
                    clearing = true;
                    if set {
                        Controls.set-value(clear-index, 1);
                    }
                } else {
                    Controls.set-value(index, 1);
                }
            } else if e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel {
                if clearing {
                    clearing = false;
                    Controls.set-value(clear-index, 0);
                } else {
                    Controls.set-value(index, 0);
                }
            }
        }
    }
    changed hovered => {
        if !hovered && tip-mine {
            tip-mine = false;
            HoverTip.shown = false;
        }
    }
    property <bool> hovered: touch.has-hover;
    Timer {
        interval: 600ms;
        running: touch.has-hover && !tip-mine;
        triggered => {
            tip-mine = true;
            HoverTip.title = "Hot cue " + number;
            HoverTip.body = (set ? "Jump here" : "Set it at the play line") + "  (key: " + number + ")\nShift-click clears it";
            HoverTip.right-aligned = false;
            HoverTip.x = root.absolute-position.x;
            HoverTip.y = root.absolute-position.y + root.height + 6px;
            HoverTip.shown = true;
        }
    }
}

// A pad on the Loops or Automix page: a title and a time, filled with
// `tint` once set. A click does `pressed(false)`, a Shift-click
// `pressed(true)` (clears).
component PrepTile inherits Rectangle {
    in property <string> title;
    in property <string> time;
    in property <string> detail;
    in property <bool> set;
    in property <bool> enabled: true;
    in property <string> empty-text: "Click to set";
    in property <color> tint;
    in property <color> ink: Theme.f-ffffff;
    in property <string> tip-title;
    in property <string> tip-body;
    callback pressed(clear: bool);
    property <bool> tip-mine;
    property <bool> shift;
    border-radius: 7px;
    background: set ? (touch.pressed ? tint.darker(0.3) : tint) : touch.pressed ? Theme.control-pressed : touch.has-hover && enabled ? Theme.n-1d1d20 : Theme.control;
    border-width: set ? 0px : 1px;
    border-color: touch.has-hover && enabled ? Theme.n-48484c : Theme.n-2c2c31;
    VerticalLayout {
        padding: 7px;
        HorizontalLayout {
            spacing: 6px;
            Text { text: title; color: set ? ink : Theme.text-dim; font-size: 12px; font-weight: 700; overflow: elide; horizontal-stretch: 1; }
            if set: Text { text: detail; color: ink.with-alpha(0.8); font-size: 11px; }
        }
        Rectangle { vertical-stretch: 1; }
        Text { text: set ? time : empty-text; color: set ? ink.with-alpha(0.82) : Theme.text-dim; font-family: "Inter Tabular"; font-size: 11px; overflow: elide; }
    }
    touch := TouchArea {
        enabled: root.enabled || root.set;
        mouse-cursor: pointer;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                root.shift = e.modifiers.shift;
            }
        }
        clicked => { root.pressed(root.shift); }
        changed has-hover => {
            if !self.has-hover && tip-mine {
                tip-mine = false;
                HoverTip.shown = false;
            }
        }
    }
    Timer {
        interval: 600ms;
        running: touch.has-hover && !tip-mine && tip-title != "";
        triggered => {
            tip-mine = true;
            HoverTip.title = tip-title;
            HoverTip.body = tip-body;
            HoverTip.right-aligned = false;
            HoverTip.x = root.absolute-position.x;
            HoverTip.y = root.absolute-position.y + root.height + 6px;
            HoverTip.shown = true;
        }
    }
}

// Saved loop pad `slot` (0 to 7).
component LoopPad inherits PrepTile {
    in property <string> group;
    in property <int> slot;
    property <bool> looping: Controls.value(Controls.resolve(group, "loop_enabled"), Controls.tick) > 0;
    set: slot < CueList.prep-loops.length;
    enabled: looping;
    title: root.set && CueList.prep-loops[slot].name != "" ? CueList.prep-loops[slot].name : "Loop " + (slot + 1);
    time: CueList.prep-loops[slot].time;
    detail: CueList.prep-loops[slot].detail;
    tint: Theme.loop;
    ink: Theme.n-0e0e10;
    empty-text: looping ? "Click to save" : "Set a loop first";
    tip-title: "Saved loop";
    tip-body: root.set ? "Play this loop\nShift-click removes it" : "Saves the loop playing, to play again later";
    pressed(clear) => { CueList.loop-pad(slot, clear); }
}

// Memory cue pad `slot` (0 to 7): a marker in the track, on no pad (as
// Pioneer players keep them).
component MemoryPad inherits PrepTile {
    in property <int> slot;
    set: slot < CueList.prep-memory.length;
    title: root.set && CueList.prep-memory[slot].name != "" ? CueList.prep-memory[slot].name : "Memory " + (slot + 1);
    time: CueList.prep-memory[slot].time;
    detail: CueList.prep-memory[slot].detail;
    tint: Theme.accent;
    ink: Theme.n-0e0e10;
    empty-text: "Click to add";
    tip-title: "Memory cue";
    tip-body: root.set ? "Jump here\nShift-click removes it" : "Adds a memory cue at the play line  (C)\nPioneer players step through these";
    pressed(clear) => { CueList.memory-pad(slot, clear); }
}

// Mix in (0) or mix out (1): where Automix mixes this track in or out.
component MixPad inherits PrepTile {
    in property <int> which;
    set: CueList.mix-times[which] != "";
    title: which == 0 ? "Mix in" : "Mix out";
    time: CueList.mix-times[which];
    detail: CueList.mix-details[which];
    tint: Theme.automix;
    ink: Theme.automix-ink;
    tip-title: which == 0 ? "Mix in" : "Mix out";
    tip-body: (which == 0 ? "Where Automix brings this track in" : "Where Automix starts mixing out of this track")
        + (root.set ? "\nClick to jump here, Shift-click clears it" : "\nClick to set it at the play line");
    pressed(clear) => { CueList.mix-pad(which, clear); }
}

export component PrepDeck inherits Rectangle {
    in property <DeckInfo> info;
    in property <image> overview;
    out property <length> overview-width: header.overview-width;
    out property <length> overview-height: header.overview-height;
    property <string> group: "[Channel1]";
    property <color> tint: Theme.deck-color(0);
    // The pads' page: 0 Hot Cues, 1 Loops, 2 Automix, 3 Memory.
    property <int> page;
    VerticalLayout {
        spacing: 1px;
        header := Header { deck: 0; info: info; overview: overview; group: group; }
        // As tall as the 2-Deck grid editor bar.
        HorizontalLayout {
            spacing: 1px;
            height: 100px;
            // As the 2-Deck grid editor bar over the decks and mixer: deck 1's
            // side, the transport as wide as the mixer, then the pads.
            PrepGrid { group: group; info: info; horizontal-stretch: 1; min-width: 0px; preferred-width: 0px; }
            Rectangle {
                background: Theme.panel;
                width: 254px;
                PrepTransport { group: group; info: info; tint: tint; }
            }
            Rectangle {
                background: Theme.panel;
                horizontal-stretch: 1;
                min-width: 0px;
                preferred-width: 0px;
                VerticalLayout {
                    spacing: 4px;
                    // One tab over each pad column.
                    HorizontalLayout {
                        spacing: 4px;
                        height: 22px;
                        for name[i] in ["Hot Cues", "Loops", "Automix", "Memory"]: PadTab {
                            horizontal-stretch: 1;
                            min-width: 0px;
                            preferred-width: 0px;
                            text: name;
                            on: page == i;
                            clicked => { page = i; }
                        }
                    }
                    for row in 2: HorizontalLayout {
                        spacing: 4px;
                        for n in 4: Rectangle {
                            horizontal-stretch: 1;
                            min-width: 0px;
                            preferred-width: 0px;
                            if page == 0: PrepPad { group: group; number: row * 4 + n + 1; }
                            if page == 1: LoopPad { group: group; slot: row * 4 + n; }
                            if page == 2 && row == 0 && n < 2: MixPad { which: n; }
                            if page == 3: MemoryPad { slot: row * 4 + n; }
                        }
                    }
                }
            }
        }
    }
}
