// How tall the large scrolling waveforms are: ten steps, 1 to 10, 3 being
// the height they always had, kept per layout. Set from the grip under the
// waveforms, the waveforms button's arrow, a waveform's right-click menu,
// ⌥⌘↑ / ⌥⌘↓, View and controllers; the app saves it (waveform_height.rs).
// The window turns a step into pixels for its layout and shows a lower
// one while the library would get too little room.
import { Theme } from "theme.slint";
import { WaveLook } from "wave_look.slint";

export global WaveHeight {
    // Each layout's step, by layout number (0 2-Deck, 1 Player,
    // 2 4-Deck, 3 Prep, 4 2-Deck Basic): 1 to `steps`.
    in property <[int]> levels: [3, 3, 3, 3, 3];
    in property <int> steps: 10;
    in property <int> default-level: 3;
    // The layout showing, kept up to date by the window.
    in-out property <int> layout;
    out property <int> level: layout >= 0 && layout < levels.length ? levels[layout] : default-level;
    // Counts each change, so the step can show a moment.
    in property <int> changes;
    // While the drop-down's slider is dragged: the step under the pointer,
    // between whole steps, for the window to show the waveforms at.
    in-out property <bool> sliding;
    in-out property <float> slide: 3;
    // Asks the app for a step in a layout; it keeps it in range and saves it.
    callback set-level(layout: int, level: int);

    public function pick(level: int) {
        set-level(layout, clamp(level, 1, steps));
    }
    public function step(by: int) {
        pick(level + by);
    }
    public function reset() {
        pick(default-level);
    }
}

// A few choices side by side, the chosen one lit; `swatches` puts three
// small colour blocks before each choice's name (3-Band's palettes).
component WaveSegments inherits Rectangle {
    in property <[string]> choices;
    in property <int> chosen;
    in property <[[color]]> swatches;
    callback picked(index: int);
    height: 28px;
    border-radius: 8px;
    background: Theme.panel-raised.brighter(0.12);
    HorizontalLayout {
        padding: 2px;
        spacing: 2px;
        for c[i] in choices: Rectangle {
            property <bool> on: i == chosen;
            horizontal-stretch: 1;
            border-radius: 6px;
            background: on ? Theme.accent.with-alpha(0.25) : sta.has-hover ? Theme.panel-raised.brighter(0.3) : transparent;
            border-width: 1px;
            border-color: on ? Theme.accent : transparent;
            HorizontalLayout {
                alignment: center;
                spacing: 6px;
                if i < swatches.length: HorizontalLayout {
                    alignment: center;
                    spacing: 1px;
                    padding-top: 8px;
                    padding-bottom: 8px;
                    for sw in swatches[i]: Rectangle { width: 5px; border-radius: 1px; background: sw; }
                }
                Text {
                    text: c;
                    color: on ? Theme.text : Theme.text-dim;
                    font-size: 12px;
                    font-weight: on ? 700 : 500;
                    vertical-alignment: center;
                }
            }
            sta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.picked(i); }
            }
        }
    }
}

component WaveLabel inherits Text {
    color: Theme.text-dim;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.6px;
    vertical-alignment: center;
}

// An ⓘ beside a name: a click shows what it means.
component WaveInfo inherits Rectangle {
    in property <string> text;
    width: 14px;
    height: 14px;
    border-radius: 7px;
    border-width: 1px;
    border-color: ita.has-hover ? Theme.text : Theme.text-dim;
    Text {
        text: "i";
        color: ita.has-hover ? Theme.text : Theme.text-dim;
        font-size: 10px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ita := TouchArea {
        mouse-cursor: pointer;
        clicked => { tip.show(); }
    }
    tip := PopupWindow {
        x: 0;
        y: root.height + 6px;
        width: 240px;
        Rectangle {
            background: Theme.panel-raised;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 10px;
            drop-shadow-color: Theme.s-000000c0;
        }
        VerticalLayout {
            padding: 10px;
            Text { text: root.text; color: Theme.text; font-size: 12px; wrap: word-wrap; }
        }
    }
}

// A switch with its name, and what it does behind an ⓘ.
component WaveSwitch inherits HorizontalLayout {
    in property <string> text;
    in property <string> hint;
    in property <bool> on;
    callback toggled(on: bool);
    spacing: 6px;
    Text { text: root.text; color: Theme.text; font-size: 12px; font-weight: 600; vertical-alignment: center; }
    VerticalLayout {
        alignment: center;
        WaveInfo { text: root.hint; }
    }
    Rectangle { horizontal-stretch: 1; }
    VerticalLayout {
        alignment: center;
        Rectangle {
            width: 32px;
            height: 18px;
            border-radius: 9px;
            background: on ? Theme.accent.darker(0.25) : Theme.panel-raised.brighter(0.3);
            Rectangle {
                x: on ? 16px : 2px;
                y: 2px;
                width: 14px;
                height: 14px;
                border-radius: 7px;
                background: on ? #ffffff : Theme.text-dim;
                animate x { duration: 120ms; }
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => { root.toggled(!on); }
            }
        }
    }
}

// The waveforms button's drop-down: the height as a slider, then how the
// waveforms look (type, color and Show vocals, needle and Show lyrics). Dragging the slider resizes the waveforms as it moves
// and settles on the nearest of the ten steps when let go; arrow keys
// move a step. `fits` is the highest step the window has room for now; a
// higher one can still be chosen and shows once there is room.
export component WaveHeightList inherits VerticalLayout {
    in property <int> fits: 10;
    // A choice was made (the window shows the waveforms if hidden).
    callback picked();
    padding: 12px;
    padding-top: 10px;
    spacing: 8px;
    property <float> shown-level: WaveHeight.sliding ? WaveHeight.slide : WaveHeight.level;
    HorizontalLayout {
        WaveLabel { text: "WAVEFORM HEIGHT"; }
        Rectangle { horizontal-stretch: 1; }
        if WaveHeight.level != WaveHeight.default-level && !WaveHeight.sliding: Text {
            text: "Reset";
            color: reset-ta.has-hover ? Theme.text : Theme.text-dim;
            font-size: 11px;
            vertical-alignment: center;
            reset-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    WaveHeight.reset();
                    picked();
                }
            }
        }
    }
    HorizontalLayout {
        spacing: 10px;
        track := Rectangle {
            height: 28px;
            horizontal-stretch: 1;
            property <length> span: self.width - 16px;
            property <float> at: (shown-level - 1) / (WaveHeight.steps - 1);
            // The rail, lit up to the knob.
            Rectangle { x: 8px; y: 12px; width: track.span; height: 4px; border-radius: 2px; background: Theme.panel-raised.brighter(0.3); }
            Rectangle { x: 8px; y: 12px; width: track.span * track.at; height: 4px; border-radius: 2px; background: Theme.accent; }
            // A tick at each step, the default one taller; steps that don't
            // fit now are dimmer.
            for i in WaveHeight.steps: Rectangle {
                x: 8px + track.span * i / (WaveHeight.steps - 1) - 1px;
                y: 20px;
                width: 2px;
                height: i + 1 == WaveHeight.default-level ? 6px : 4px;
                background: i + 1 > fits ? Theme.text-dim.with-alpha(0.25) : i + 1 == WaveHeight.default-level ? Theme.text-dim : Theme.text-dim.with-alpha(0.55);
            }
            Rectangle {
                x: 8px + track.span * track.at - 8px;
                y: 6px;
                width: 16px;
                height: 16px;
                border-radius: 8px;
                background: Theme.text;
                border-width: 2px;
                border-color: Theme.accent;
                drop-shadow-blur: 4px;
                drop-shadow-color: Theme.s-000000c0;
            }
            keys := FocusScope {
                key-pressed(e) => {
                    if e.text == Key.RightArrow || e.text == Key.UpArrow {
                        WaveHeight.step(1);
                        picked();
                        return accept;
                    }
                    if e.text == Key.LeftArrow || e.text == Key.DownArrow {
                        WaveHeight.step(-1);
                        picked();
                        return accept;
                    }
                    reject
                }
            }
            slide-ta := TouchArea {
                mouse-cursor: pointer;
                pure function level-at(x: length) -> float {
                    1 + clamp((x - 8px) / max(track.span, 1px), 0, 1) * (WaveHeight.steps - 1)
                }
                pointer-event(e) => {
                    if e.button != PointerEventButton.left {
                        return;
                    }
                    if e.kind == PointerEventKind.down {
                        keys.focus();
                        WaveHeight.slide = level-at(self.mouse-x);
                        WaveHeight.sliding = true;
                    } else if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) && WaveHeight.sliding {
                        let step = round(WaveHeight.slide);
                        WaveHeight.sliding = false;
                        WaveHeight.pick(step);
                        picked();
                    }
                }
                moved => {
                    if self.pressed && WaveHeight.sliding {
                        WaveHeight.slide = level-at(self.mouse-x);
                    }
                }
            }
        }
        Rectangle {
            width: 26px;
            height: 24px;
            y: 2px;
            border-radius: 6px;
            background: Theme.panel-raised.brighter(0.2);
            Text {
                text: round(shown-level);
                color: Theme.text;
                font-family: "Inter Tabular";
                font-size: 12px;
                font-weight: 700;
            }
        }
    }
    Rectangle { height: 2px; }
    WaveLabel { text: "TYPE"; }
    WaveSegments {
        choices: ["Full", "Half"];
        chosen: WaveLook.half ? 1 : 0;
        picked(i) => {
            WaveLook.pick-half(i == 1);
            root.picked();
        }
    }
    WaveLabel { text: "COLOR"; }
    WaveSegments {
        choices: ["RGB", "3-Band", "Stems"];
        chosen: WaveLook.color;
        picked(i) => {
            WaveLook.pick-color(i);
            root.picked();
        }
    }
    if WaveLook.color == 1: WaveSegments {
        choices: ["Blue-Orange", "Lilac-Cyan"];
        swatches: [[#1F6BFF, #E8902A, #F5EEDD], [#B69CFF, #22C7E0, #F4FBFF]];
        chosen: WaveLook.palette;
        picked(i) => {
            WaveLook.pick-palette(i);
            root.picked();
        }
    }
    // Stems draws the vocals in their own color, so the tint has no part there.
    if WaveLook.color != 2: WaveSwitch {
        text: "Show vocals";
        hint: "Marks the sung parts with a thin cyan strip along the top of the waveforms. Not with Stems, which shows the vocals in their own color.";
        on: WaveLook.vocals;
        toggled(on) => {
            WaveLook.pick-vocals(on);
            root.picked();
        }
    }
    WaveLabel { text: "NEEDLE"; }
    WaveSegments {
        choices: ["Center", "Left"];
        chosen: WaveLook.needle < 0.5 ? 1 : 0;
        picked(i) => {
            WaveLook.pick-needle-left(i == 1);
            root.picked();
        }
    }
    WaveSwitch {
        text: "Show lyrics";
        hint: "A track's timed lyrics run along the bottom of its large waveform.";
        on: WaveLook.lyrics;
        toggled(on) => {
            WaveLook.pick-lyrics(on);
            root.picked();
        }
    }
}

// The grip on the line under the waveforms. Dragging it stretches the
// waveforms smoothly with the pointer; letting go settles them on the
// nearest step. The step shows as a number in the middle while dragging
// and a moment after any change; double-click goes back to 3. Placed over
// the whole window, so the grip's hit area can reach over the decks.
export component WaveHeightGrip inherits Rectangle {
    // Where the waveforms are, in the window.
    in property <length> strip-top;
    in property <length> strip-height;
    // The strip's height at each step, 1 first, and the highest step that
    // fits now.
    in property <[length]> heights;
    in property <int> fits: 10;
    // The step showing (lower than the chosen one while it doesn't fit).
    in property <int> shown: 3;
    // While dragging: the strip's height under the pointer, for the window
    // to show in place of the step's.
    out property <bool> dragging;
    out property <length> drag-height;
    // Whether this press has moved the strip yet: a click alone keeps the
    // step.
    property <bool> stretched;
    property <int> height-changes: WaveHeight.changes;
    property <bool> flash;
    changed height-changes => {
        flash = true;
        hide.running = false;
        hide.running = true;
    }
    hide := Timer {
        interval: 900ms;
        running: false;
        triggered => {
            flash = false;
            self.running = false;
        }
    }
    // The step whose strip height is nearest `h`, among those that fit.
    pure function nearest(h: length) -> int {
        let top = max(fits, 1);
        let i1 = abs(heights[0] - h) <= abs(heights[1] - h) ? 1 : 2;
        let i2 = abs(heights[i1 - 1] - h) <= abs(heights[2] - h) ? i1 : 3;
        let i3 = abs(heights[i2 - 1] - h) <= abs(heights[3] - h) ? i2 : 4;
        let i4 = abs(heights[i3 - 1] - h) <= abs(heights[4] - h) ? i3 : 5;
        let i5 = abs(heights[i4 - 1] - h) <= abs(heights[5] - h) ? i4 : 6;
        let i6 = abs(heights[i5 - 1] - h) <= abs(heights[6] - h) ? i5 : 7;
        let i7 = abs(heights[i6 - 1] - h) <= abs(heights[7] - h) ? i6 : 8;
        let i8 = abs(heights[i7 - 1] - h) <= abs(heights[8] - h) ? i7 : 9;
        let i9 = abs(heights[i8 - 1] - h) <= abs(heights[9] - h) ? i8 : 10;
        min(i9, top)
    }
    // The step's number, in the middle of the waveforms.
    Rectangle {
        x: (root.width - self.width) / 2;
        y: strip-top + (strip-height - self.height) / 2;
        width: max(self.height, number.preferred-width + 20px);
        height: 26px;
        border-radius: 13px;
        background: Theme.s-000000c0;
        border-width: 1px;
        border-color: dragging ? Theme.accent : Theme.border;
        opacity: dragging || flash ? 1 : 0;
        animate opacity { duration: 180ms; }
        number := Text {
            text: dragging ? nearest(drag-height) : shown;
            color: Theme.text;
            font-family: "Inter Tabular";
            font-size: 14px;
            font-weight: 700;
        }
    }
    // The grip: a lilac pill in the middle of the line, while the pointer
    // is near the line or dragging.
    Rectangle {
        x: (root.width - self.width) / 2;
        y: strip-top + strip-height - 3px;
        width: 40px;
        height: 5px;
        border-radius: 2.5px;
        background: Theme.accent;
        opacity: grip.has-hover || dragging ? 1 : 0;
        animate opacity { duration: 120ms; }
    }
    grip := TouchArea {
        x: 0;
        y: strip-top + strip-height - 4px;
        width: root.width;
        height: 8px;
        mouse-cursor: row-resize;
        pointer-event(e) => {
            if e.button != PointerEventButton.left {
                return;
            }
            if e.kind == PointerEventKind.down {
                drag-height = strip-height;
                stretched = false;
                dragging = true;
            } else if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) && dragging {
                let step = nearest(drag-height);
                dragging = false;
                if stretched && step != WaveHeight.level {
                    WaveHeight.pick(step);
                }
            }
        }
        // The strip follows the pointer between the lowest step and the
        // highest that fits. Measured from where the grip is now, as the
        // grip moves with the strip.
        moved => {
            if self.pressed && dragging {
                drag-height = clamp(self.y + self.mouse-y - strip-top, heights[0], heights[max(fits, 1) - 1]);
                stretched = true;
            }
        }
        double-clicked => { WaveHeight.reset(); }
    }
}
