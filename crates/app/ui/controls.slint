// Widgets bound to Mixxx controls by name, e.g. `ControlKnob { group: "[Channel1]"; key: "pregain"; }`.
//
// A widget resolves its name to an index once; reads go through `Controls.tick`,
// which the app bumps whenever a control changes, so values refresh without
// per-control wiring.
import { Theme } from "theme.slint";
import { TourMark } from "tourmark.slint";
import { MapMark } from "mapmark.slint";

export global Controls {
    in property <int> tick;
    // Flips twice a second, the same for every blinking button, so they
    // blink together and the window redraws only when they do.
    in property <bool> blink;
    pure callback resolve(group: string, key: string) -> int;
    // 0..1 widget position (knobs, faders)
    pure callback parameter(index: int, tick: int) -> float;
    // raw control value (buttons, meters)
    pure callback value(index: int, tick: int) -> float;
    // Where a controller's knob or fader is (0..1) while it waits to pick
    // the control up after it moved on screen; -1 otherwise.
    pure callback hardware(index: int, tick: int) -> float;
    callback set-parameter(index: int, parameter: float);
    callback set-value(index: int, value: float);
    callback toggle(index: int);
    callback reset(index: int);
    // The tempo fader ranges, as fractions of normal speed (the same as
    // Settings › Decks › Tempo fader range).
    in property <[float]> rate-ranges;
    // True on the half-seconds a paused deck's PLAY outline shows:
    // only with a track loaded, all decks in step. blink and tick are
    // passed in so callers redraw when either changes.
    pure function paused-blink(group: string, blink: bool, tick: int) -> bool {
        blink
            && value(resolve(group, "track_loaded"), tick) > 0
            && value(resolve(group, "play"), tick) <= 0
    }
}

// Small uppercase caption used under knobs and above sections.
// Quieter than the controls it names.
export component Caption inherits Text {
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.5px;
    color: Theme.n-6e6e73;
    horizontal-alignment: center;
}

// Part of a circle in a 100 x 100 box, clockwise from `from` to `to` (or
// back, when `to` is smaller). Angles are from twelve o'clock.
export component KnobArc inherits Path {
    in property <angle> from;
    in property <angle> to;
    in property <float> r: 46;
    viewbox-width: 100;
    viewbox-height: 100;
    fill: transparent;
    stroke-line-cap: round;
    // Three segments keep each one below 180 degrees.
    property <angle> step: (to - from) / 3;
    property <bool> clockwise: to >= from;
    MoveTo { x: 50 + r * sin(from); y: 50 - r * cos(from); }
    ArcTo { radius-x: r; radius-y: r; sweep: clockwise; x: 50 + r * sin(from + step); y: 50 - r * cos(from + step); }
    ArcTo { radius-x: r; radius-y: r; sweep: clockwise; x: 50 + r * sin(from + 2 * step); y: 50 - r * cos(from + 2 * step); }
    ArcTo { radius-x: r; radius-y: r; sweep: clockwise; x: 50 + r * sin(to); y: 50 - r * cos(to); }
}

// Where a controller's knob or fader is while it waits to pick a control
// up (see `Controls.hardware`): a hollow outline of the thumb, with an
// arrow pointing the way to move the hardware. `towards` is the direction
// from the outline to the control: 0 up, 1 down, 2 left, 3 right.
export component PickupGhost inherits Rectangle {
    in property <color> tint: Theme.accent;
    in property <int> towards;
    in property <bool> arrow: true;
    border-radius: 4px;
    border-width: 1.5px;
    border-color: tint;
    background: tint.with-alpha(0.12);
    property <length> a: min(self.width, self.height) - 6px;
    if arrow && towards == 0: Path {
        width: a; height: a; viewbox-width: 10; viewbox-height: 10; fill: tint;
        commands: "M 5 1.5 L 9 8.5 L 1 8.5 Z";
    }
    if arrow && towards == 1: Path {
        width: a; height: a; viewbox-width: 10; viewbox-height: 10; fill: tint;
        commands: "M 1 1.5 L 9 1.5 L 5 8.5 Z";
    }
    if arrow && towards == 2: Path {
        width: a; height: a; viewbox-width: 10; viewbox-height: 10; fill: tint;
        commands: "M 1.5 5 L 8.5 1 L 8.5 9 Z";
    }
    if arrow && towards == 3: Path {
        width: a; height: a; viewbox-width: 10; viewbox-height: 10; fill: tint;
        commands: "M 1.5 1 L 8.5 5 L 1.5 9 Z";
    }
}

// A hollow dot on a knob's rim where the controller's knob points, while
// it waits to pick the control up. Place it over the knob's cap.
export component PickupDot inherits Rectangle {
    // 0..1, as the knob's parameter.
    in property <float> at;
    in property <color> tint: Theme.accent;
    property <angle> angle: -135deg + at * 270deg;
    property <length> d: max(6px, self.width / 4);
    property <length> r: self.width / 2 - d / 2 + 1px;
    Rectangle {
        x: root.width / 2 + r * sin(angle) - d / 2;
        y: root.height / 2 - r * cos(angle) - d / 2;
        width: d;
        height: d;
        border-radius: d / 2;
        background: Theme.n-050506;
        border-width: 1.5px;
        border-color: tint;
    }
}

// A round knob (see below).
export component ControlKnob inherits Rectangle {
    // Names it for the guided tour (see TourMark).
    in property <string> tour-id;
    in property <string> group;
    in property <string> key;
    in property <string> label;
    // Pointer color. Defaults to white; big knobs use the deck color.
    in property <color> tint: Theme.text;
    in property <length> size: 34px;
    // Centre detent (EQs, filter): marks the default position above the knob.
    in property <bool> bipolar: false;
    // A right click on it, for a knob with a menu of its own.
    callback right-clicked();
    property <int> index: Controls.resolve(group, key);
    property <float> param: Controls.parameter(index, Controls.tick);
    property <float> drag-start;
    property <angle> value-angle: -135deg + param * 270deg;
    // Where a controller's knob is while it waits to pick this one up.
    property <float> hardware: Controls.hardware(index, Controls.tick);

    width: size + 8px;
    height: size + (label == "" ? 6px : 20px);

    // A grey cap with a light pointer line, and a blue
    // arc round its rim from `origin` (the centre for EQs) to where it points.
    in property <float> origin: bipolar ? 0.5 : 0;
    // 0 the grey cap; as on the Model 1's sculpt section, 1 a white
    // cap (sculpt) and 2 a black cap ringed in white (contour filters);
    // 3 a rack knob (instrument decks): a dark cap inside a ring, the
    // ring's arc in `arc-color` with a soft glow.
    // 4 a matte cap in a thin track (the mixer), described below.
    in property <int> look: 0;
    in property <color> arc-color: Theme.knob-arc;
    // 4 a matte cap with a short pointer inside a thin track (the mixer);
    // the arc thickens under the pointer.
    property <bool> thin: look == 4;
    property <bool> lit: touch.has-hover || touch.pressed;
    // What the label says under the pointer: 0 nothing new, 1 the gain in
    // dB (EQs, volumes), 2 the filter's side and amount.
    in property <int> readout: 0;
    property <float> raw: Controls.value(index, Controls.tick);
    property <float> db: raw < 0.001 ? -999 : 20 * log(raw, 10);
    property <string> readout-text: readout == 1
        ? (raw < 0.001 ? "−∞ dB" : abs(db) < 0.05 ? "0 dB" : (db > 0 ? "+" : "") + round(db * 10) / 10 + " dB")
        : abs(param - 0.5) < 0.01 ? "Off"
        : (param < 0.5 ? "LP " : "HP ") + round(abs(param - 0.5) * 200) + "%";
    // A rack knob's cap sits inside its ring.
    property <length> inset: look == 3 ? round(size * 0.17 / 1px) * 1px
        : look == 4 ? round(size * 0.2 / 1px) * 1px
        : 0px;
    property <angle> origin-angle: -135deg + origin * 270deg;
    // Soft shadow, then the cap.
    if !thin: Rectangle {
        x: 4px;
        y: 4px;
        width: size;
        height: size;
        border-radius: self.width / 2;
        background: Theme.n-050506;
    }
    // A rack knob's ring: the whole sweep, dark, under its arc.
    if look == 3: KnobArc {
        x: 4px + 1px;
        y: 3px + 1px;
        width: size - 2px;
        height: size - 2px;
        from: -135deg;
        to: 135deg;
        stroke: Theme.n-26262a;
        stroke-width: max(3px, size / 10);
    }
    // The thin knobs' track: the whole sweep, under the arc.
    if thin: KnobArc {
        x: 4px;
        y: 3px;
        width: size;
        height: size;
        r: 45;
        from: -135deg;
        to: 135deg;
        stroke: Theme.n-3a3a3f;
        stroke-width: lit ? max(3px, size / 10.5) : max(2px, size / 16);
    }
    cap := Rectangle {
        x: 4px + inset;
        y: 3px + inset;
        width: size - 2 * inset;
        height: size - 2 * inset;
        border-radius: self.width / 2;
        background: look == 4
            ? @radial-gradient(circle, Theme.knob-matte-hi 0%, Theme.knob-matte-lo 100%)
            : look == 3
            ? (touch.has-hover ? @radial-gradient(circle, #55575f 0%, #24252a 100%) : @radial-gradient(circle, #4a4c54 0%, #1d1e23 100%))
            : look == 1
            ? (touch.has-hover ? @linear-gradient(180deg, #ffffff 0%, #d4d4d8 100%) : @linear-gradient(180deg, #f2f2f4 0%, #c8c8cc 100%))
            : look == 2
            ? (touch.has-hover ? Theme.n-1c1c1e : Theme.n-0e0e10)
            : touch.has-hover
            ? @linear-gradient(180deg, #505055 0%, #303034 100%)
            : @linear-gradient(180deg, #46464b 0%, #2a2a2e 100%);
        border-width: look == 4 ? 0px : look == 2 ? max(2px, size / 12) : 1px;
        drop-shadow-blur: look == 3 || look == 4 ? 4px : 0px;
        drop-shadow-color: Theme.s-000000b0;
        border-color: look == 2 ? Theme.n-e4e4e8 : Theme.n-141416;
    }
    // Hidden at the origin, where the arc would be a dot.
    // A rack knob's glow, under its arc.
    if look == 3 && abs(param - origin) > 0.004: KnobArc {
        x: 4px + 1px;
        y: 3px + 1px;
        width: size - 2px;
        height: size - 2px;
        from: origin-angle;
        to: value-angle;
        stroke: root.arc-color.with-alpha(0.28);
        stroke-width: max(7px, size / 4.5);
    }
    if thin && abs(param - origin) > 0.004: KnobArc {
        x: 4px;
        y: 3px;
        width: size;
        height: size;
        r: 45;
        from: origin-angle;
        to: value-angle;
        stroke: root.arc-color;
        stroke-width: lit ? max(3px, size / 10.5) : max(2px, size / 16);
    }
    if !thin && abs(param - origin) > 0.004: KnobArc {
        x: 4px + 1px;
        y: 3px + 1px;
        width: size - 2px;
        height: size - 2px;
        from: origin-angle;
        to: value-angle;
        stroke: look == 3 ? root.arc-color : Theme.knob-arc;
        stroke-width: look == 3 ? max(3px, size / 10) : max(2px, size / 11);
    }
    // Pointer line from near the centre to the rim.
    Path {
        x: cap.x;
        y: cap.y;
        width: cap.width;
        height: cap.height;
        viewbox-width: 100;
        viewbox-height: 100;
        stroke: look == 1 ? Theme.n-1c1c1e : root.tint == Theme.text ? Theme.n-e4e4e8 : root.tint;
        stroke-width: max(1.5px, size / 14);
        stroke-line-cap: round;
        // A short pointer near the rim on the matte cap.
        property <float> from-r: look == 4 ? 13 : look == 3 ? 12 : 8;
        property <float> to-r: look == 4 ? 39 : look == 3 ? 38 : 40;
        MoveTo { x: 50 + from-r * sin(value-angle); y: 50 - from-r * cos(value-angle); }
        LineTo { x: 50 + to-r * sin(value-angle); y: 50 - to-r * cos(value-angle); }
    }
    // On the thin track, where the controller's knob is: a short lilac notch
    // on the track, gone once the knob picks the control up.
    if thin && hardware >= 0: KnobArc {
        x: 4px;
        y: 3px;
        width: size;
        height: size;
        r: 45;
        from: -135deg + hardware * 270deg - 7deg;
        to: -135deg + hardware * 270deg + 7deg;
        stroke: root.tint == Theme.text ? Theme.accent : root.tint;
        stroke-width: max(3px, size / 9);
        stroke-line-cap: butt;
    }
    if !thin && hardware >= 0: PickupDot {
        x: cap.x;
        y: cap.y;
        width: cap.width;
        height: cap.height;
        at: hardware;
        tint: root.tint == Theme.text ? Theme.accent : root.tint;
    }
    // The centre mark above the knob; the thin track's arc already grows
    // from the centre.
    if bipolar && origin == 0.5 && !thin: Rectangle {
        x: 4px + size / 2 - 1px;
        y: 0px;
        width: 2px;
        height: 2px;
        border-radius: 1px;
        background: Theme.text-dim;
    }

    // Wider than the knob, so longer labels fit under it.
    if label != "": Caption {
        y: size + 6px;
        x: (parent.width - self.width) / 2;
        width: 80px;
        // The value while the pointer is over it, in the arc's color.
        text: readout != 0 && lit ? readout-text : label;
        color: readout != 0 && lit ? (thin ? root.arc-color : Theme.text) : Theme.n-6e6e73;
    }

    touch := TouchArea {
        mouse-cursor: ns-resize;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.right {
                root.right-clicked();
            } else if e.kind == PointerEventKind.down {
                drag-start = param;
            }
        }
        moved => {
            Controls.set-parameter(index, max(0, min(1, drag-start + (self.pressed-y - self.mouse-y) / 160px)));
        }
        double-clicked => {
            Controls.reset(index);
        }
        // Up and down turn it; a mostly sideways swipe goes on to what's
        // behind (the Mixer's strips scroll sideways).
        scroll-event(e) => {
            if e.delta-y == 0 || abs(e.delta-x / 1px) >= abs(e.delta-y / 1px) {
                return reject;
            }
            Controls.set-parameter(index, max(0, min(1, param + (e.delta-y > 0 ? 0.02 : -0.02))));
            accept
        }
    }
    TourMark { id: root.tour-id; }
    MapMark { key: root.group + "," + root.key; }
}

// The headphone icon, openDJ's own: a round headband with two cups
// tilted outward. Drawn on a 24-unit grid; strokes scale with `size`.
export component HeadphoneIcon inherits Rectangle {
    in property <length> size: 16px;
    in property <color> tint: Theme.text;
    property <float> k: size / 24px;
    width: size;
    height: size;
    Path {
        width: root.size;
        height: root.size;
        viewbox-width: 24;
        viewbox-height: 24;
        stroke: root.tint;
        stroke-width: 1.6px * k;
        stroke-line-cap: round;
        fill: transparent;
        commands: "M 4.2 19 A 10 10 0 1 1 19.8 19";
    }
    // Each cup a rounded bar 3.55 wide and 10 tall, tilted 14°.
    Path {
        width: root.size;
        height: root.size;
        viewbox-width: 24;
        viewbox-height: 24;
        stroke: root.tint;
        stroke-width: 3.55px * k;
        stroke-line-cap: round;
        fill: transparent;
        commands: "M 5.87 14.37 L 7.43 20.63 M 18.13 14.37 L 16.57 20.63";
    }
}

// Flat dark button with a thin border. When its light is on, the label and
// border take the tint.
export component ControlButton inherits Rectangle {
    // Names it for the guided tour (see TourMark).
    in property <string> tour-id;
    in property <string> group;
    in property <string> key;
    in property <string> text;
    in property <color> tint: Theme.accent;
    // Momentary: on while held (cue, hotcues). Otherwise toggles on click.
    in property <bool> momentary: false;
    // Read a different control for the light than the one pressed (e.g. hotcue_N_enabled).
    in property <string> light-key: key;
    in property <length> font-size: Theme.font-normal;
    // Fill the whole button with the tint when lit (sync, keylock) instead of tinting the label.
    in property <bool> fill-when-lit: false;
    // Or just outline it in the tint when lit, label tinted too (SYNC,
    // CUE): a thicker edge, no fill.
    in property <bool> outline-when-lit: false;
    // Show that outline without lighting the label.
    in property <bool> outline: false;
    // The Tron look's switch pill: a dark pill, its word lilac (and a
    // lilac edge) while on, grey while off. Takes over from the looks above.
    in property <bool> pill: false;
    // Draw a headphone icon instead of the text, for headphone cue (PFL).
    in property <bool> headphones: false;
    // Or a filled icon: SVG path commands in a 20 x 20 box. Glyphs like ❚❚
    // are missing from some system fonts, so icons are drawn.
    in property <string> icon;
    // The icon while lit, e.g. pause on a playing deck's play button. (A
    // Path doesn't redraw when its commands change, so each icon is its own.)
    in property <string> lit-icon: icon;
    // Pressed instead while Shift is held, as a momentary push (Shift+SYNC
    // syncs once).
    in property <string> shift-key;
    // A tip shown after hovering a moment, as on key lock; none when the
    // title is empty.
    in property <string> tip-title;
    in property <string> tip-body;
    in property <bool> tip-right-aligned: false;
    property <bool> tip-mine;
    // A right-click, for a button with a menu (SYNC's quantize).
    callback right-clicked();
    property <int> shift-index: shift-key == "" ? -1 : Controls.resolve(group, shift-key);
    property <bool> shift-held;
    property <color> label-color: pill ? (lit ? Theme.lilac-text : touch.has-hover ? Theme.text : Theme.pill-off-text)
        : lit ? (fill-when-lit ? #ffffff : root.tint) : Theme.text;
    property <int> index: Controls.resolve(group, key);
    property <int> light-index: Controls.resolve(group, light-key);
    property <bool> lit: Controls.value(light-index, Controls.tick) > 0;

    preferred-width: 28px;
    preferred-height: 22px;
    border-radius: pill ? 7px : Theme.radius;
    background: pill ? (touch.pressed ? Theme.control-pressed : lit ? Theme.accent.with-alpha(0.12) : touch.has-hover ? Theme.pill-hover : Theme.pill)
        : lit && fill-when-lit ? root.tint
        : touch.pressed ? Theme.control-pressed
        : lit && !outline-when-lit ? root.tint.with-alpha(0.14)
        : touch.has-hover ? Theme.n-1d1d20 : Theme.control;
    border-width: pill ? 1px : (lit && outline-when-lit) || outline ? 2px : 1px;
    border-color: pill ? (lit ? Theme.n-6e58a8 : touch.has-hover ? Theme.n-48484c : Theme.n-2c2c31)
        : lit || outline ? root.tint : Theme.border;

    if !headphones && icon == "": Text {
        text: root.text;
        font-size: root.font-size;
        font-weight: pill ? 500 : 700;
        color: label-color;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if icon != "" && !lit: Path {
        width: 18px;
        height: 18px;
        viewbox-width: 20;
        viewbox-height: 20;
        fill: label-color;
        commands: icon;
    }
    if icon != "" && lit: Path {
        width: 18px;
        height: 18px;
        viewbox-width: 20;
        viewbox-height: 20;
        fill: label-color;
        commands: lit-icon;
    }
    if headphones: HeadphoneIcon { size: min(16px, root.height - 4px); tint: label-color; }

    touch := TouchArea {
        pointer-event(e) => {
            if e.button == PointerEventButton.right && e.kind == PointerEventKind.down {
                root.right-clicked();
                return;
            }
            if e.button != PointerEventButton.left && e.kind != PointerEventKind.cancel {
                return;
            }
            if shift-index >= 0 && (shift-held || (e.kind == PointerEventKind.down && e.modifiers.shift)) {
                if e.kind == PointerEventKind.down {
                    shift-held = true;
                    Controls.set-value(shift-index, 1);
                } else if e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel {
                    shift-held = false;
                    Controls.set-value(shift-index, 0);
                }
                return;
            }
            if momentary {
                if e.kind == PointerEventKind.down {
                    Controls.set-value(index, 1);
                } else if e.kind == PointerEventKind.up {
                    Controls.set-value(index, 0);
                }
            } else if e.kind == PointerEventKind.down {
                Controls.toggle(index);
            }
        }
        changed has-hover => {
            if !self.has-hover && tip-mine {
                tip-mine = false;
                HoverTip.shown = false;
            }
        }
    }
    Timer {
        interval: 600ms;
        running: tip-title != "" && touch.has-hover && !tip-mine;
        triggered => {
            tip-mine = true;
            HoverTip.title = tip-title;
            HoverTip.body = tip-body;
            HoverTip.right-aligned = tip-right-aligned;
            HoverTip.x = root.absolute-position.x + (tip-right-aligned ? root.width : 0px);
            HoverTip.y = root.absolute-position.y + root.height + 6px;
            HoverTip.shown = true;
        }
    }
    TourMark { id: root.tour-id; }
    MapMark { key: root.group + "," + root.key; }
}

// Fader with tick marks either side of a dark slot and a grey metal-look cap.
export component ControlFader inherits Rectangle {
    // Names it for the guided tour (see TourMark).
    in property <string> tour-id;
    in property <string> group;
    in property <string> key;
    in property <bool> vertical: true;
    // Puts the control's minimum at the top (or right) end.
    in property <bool> inverted: false;
    in property <bool> center-mark: false;
    in property <color> tint: Theme.accent;
    in property <int> ticks: 9;
    // Switched off: greyed out with the handle in the centre, and it can't
    // be moved.
    in property <bool> disabled: false;
    // Held by something else (Automix and the crossfader): it still moves,
    // outlined in Automix cyan (the cyan glow says who holds it), but can't be
    // dragged or scrolled.
    in property <bool> locked: false;
    // The slot's dark line lit solid in `glow` (key lock on the tempo
    // fader); unlike `locked` it still moves by hand.
    in property <bool> glowing: false;
    in property <color> glow: Theme.lilac;
    // 0 the usual slot, ticks and cap; 1 a thin track lit lilac from the
    // centre (or the bottom) to a matte cap, as on the mixer's knobs (the
    // tempo, channel and cross faders).
    in property <int> look: 0;
    // A right-click, at that point along the fader.
    callback context-menu(length, length);
    property <int> index: Controls.resolve(group, key);
    property <float> param: Controls.parameter(index, Controls.tick);
    property <float> pos: disabled ? 0.5 : inverted ? 1 - param : param;
    // Where a controller's fader is while it waits to pick this one up.
    property <float> hardware: disabled || locked ? -1 : Controls.hardware(index, Controls.tick);
    property <float> hardware-pos: inverted ? 1 - hardware : hardware;
    property <float> drag-start;
    // Only a left-button drag moves it.
    property <bool> dragging;
    property <length> handle: vertical ? 16px : 14px;
    // Length of the travel, between the handle's end positions.
    property <length> travel: (vertical ? self.height : self.width) - handle;

    preferred-width: vertical ? 28px : 60px;
    preferred-height: vertical ? 60px : 28px;
    opacity: disabled ? 0.35 : 1;

    // Tick marks
    if look == 0: Rectangle {
    for i in ticks: Rectangle {
        property <length> along: handle / 2 + travel * i / (ticks - 1);
        property <bool> major: i == 0 || i == ticks - 1 || (center-mark && i * 2 == ticks - 1);
        // Softer ticks: the minor ones short, either side of the slot.
        x: vertical ? (major ? 0px : root.width * 0.2) : along;
        y: vertical ? along : (major ? 0px : root.height * 0.2);
        width: vertical ? (major ? root.width : root.width * 0.6) : 1px;
        height: vertical ? 1px : (major ? root.height : root.height * 0.6);
        background: major ? Theme.n-55555a.with-alpha(0.8) : Theme.tick.with-alpha(0.6);
    }
    }
    // Slot
    if look == 0: Rectangle {
        x: vertical ? (parent.width - 3px) / 2 : handle / 2;
        y: vertical ? handle / 2 : (parent.height - 3px) / 2;
        width: vertical ? 3px : travel;
        height: vertical ? travel : 3px;
        border-radius: 1.5px;
        background: glowing && !locked ? glow : Theme.n-050506;
        border-width: 1px;
        border-color: locked ? Theme.automix.with-alpha(0.6) : glowing ? glow : Theme.n-2a2a2d;
    }
    // Locked: the slot lights cyan from the centre (or the bottom) to the
    // handle.
    if locked: Rectangle {
        property <float> from: center-mark ? 0.5 : 0;
        property <float> lo: min(from, pos);
        property <float> hi: max(from, pos);
        x: vertical ? (parent.width - 4px) / 2 : handle / 2 + lo * travel;
        y: vertical ? handle / 2 + (1 - hi) * travel : (parent.height - 4px) / 2;
        width: vertical ? 4px : (hi - lo) * travel;
        height: vertical ? (hi - lo) * travel : 4px;
        border-radius: 2px;
        background: Theme.automix;
    }
    // Modern: the thin track, lit from the centre (or the bottom) to the cap.
    if look == 1: Rectangle {
        x: vertical ? (parent.width - 3px) / 2 : handle / 2;
        y: vertical ? handle / 2 : (parent.height - 3px) / 2;
        width: vertical ? 3px : travel;
        height: vertical ? travel : 3px;
        border-radius: 1.5px;
        background: glowing && !locked ? glow.with-alpha(0.45) : Theme.n-3a3a3f;
    }
    if look == 1: Rectangle {
        property <float> from: center-mark ? 0.5 : 0;
        property <float> lo: min(from, pos);
        property <float> hi: max(from, pos);
        x: vertical ? (parent.width - 4px) / 2 : handle / 2 + lo * travel;
        y: vertical ? handle / 2 + (1 - hi) * travel : (parent.height - 4px) / 2;
        width: vertical ? 4px : (hi - lo) * travel;
        height: vertical ? (hi - lo) * travel : 4px;
        border-radius: 2px;
        background: locked ? Theme.automix : Theme.accent;
    }
    // The controller's fader on the thin track: a short notch across it
    // in the deck color, gone once the fader picks the control up.
    if hardware >= 0 && look == 1: Rectangle {
        x: vertical ? (parent.width - self.width) / 2 : handle / 2 + hardware-pos * travel - 2px;
        y: vertical ? handle / 2 + (1 - hardware-pos) * travel - 2px : (parent.height - self.height) / 2;
        width: vertical ? min(parent.width - 8px, 22px) : 4px;
        height: vertical ? 4px : min(parent.height - 8px, 22px);
        border-radius: 2px;
        background: root.tint;
    }
    // The controller's fader, under the handle.
    if hardware >= 0 && look == 0: PickupGhost {
        x: vertical ? 2px : hardware-pos * travel;
        y: vertical ? (1 - hardware-pos) * travel : 2px;
        width: vertical ? root.width - 4px : handle;
        height: vertical ? handle : root.height - 4px;
        tint: root.tint;
        towards: vertical ? (hardware-pos < pos ? 0 : 1) : (hardware-pos < pos ? 3 : 2);
    }
    // Handle
    if look == 0: Rectangle {
        x: vertical ? 2px : pos * travel;
        y: vertical ? (1 - pos) * travel : 2px;
        width: vertical ? parent.width - 4px : handle;
        height: vertical ? handle : parent.height - 4px;
        // The Tron look's refined cap: graphite, a lilac line across it.
        border-radius: 4px;
        background: vertical
            ? @linear-gradient(180deg, Theme.fader-cap-top 0%, Theme.fader-cap-bottom 100%)
            : @linear-gradient(90deg, Theme.fader-cap-top 0%, Theme.fader-cap-bottom 100%);
        border-width: 1px;
        border-color: locked ? Theme.automix : touch.pressed || touch.has-hover ? Theme.n-6e58a8 : Theme.fader-cap-edge;
        drop-shadow-blur: 4px;
        drop-shadow-color: Theme.s-000000a0;
        Rectangle {
            width: vertical ? parent.width - 8px : 2px;
            height: vertical ? 2px : parent.height - 8px;
            border-radius: 1px;
            background: Theme.lilac-text;
        }
    }
    if look == 1: Rectangle {
        x: vertical ? (parent.width - self.width) / 2 : pos * travel;
        y: vertical ? (1 - pos) * travel : (parent.height - self.height) / 2;
        width: vertical ? min(parent.width - 4px, 40px) : handle;
        height: vertical ? handle : min(parent.height - 4px, 40px);
        border-radius: min(self.width, self.height) / 2;
        // Held by Automix: the cap fills with its cyan.
        background: locked ? @radial-gradient(circle, Theme.automix 0%, Theme.automix 100%) : @radial-gradient(circle, Theme.knob-matte-hi 0%, Theme.knob-matte-lo 100%);
        border-width: locked ? 1px : 0px;
        border-color: Theme.automix;
        drop-shadow-blur: 4px;
        drop-shadow-offset-y: 1px;
        drop-shadow-color: Theme.s-000000b0;
        Rectangle {
            width: vertical ? parent.width - 14px : 2px;
            height: vertical ? 2px : parent.height - 14px;
            border-radius: 1px;
            background: touch.has-hover || touch.pressed ? Theme.lilac-text : Theme.n-e4e4e8;
        }
    }
    touch := TouchArea {
        mouse-cursor: locked ? MouseCursor.not-allowed : MouseCursor.default;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                dragging = e.button == PointerEventButton.left && !disabled && !locked;
                drag-start = pos;
                if e.button == PointerEventButton.right {
                    root.context-menu(self.mouse-x, self.mouse-y);
                }
            }
        }
        moved => {
            if !dragging {
                return;
            }
            if vertical {
                Controls.set-parameter(index, to-param(inverted, drag-start + (self.pressed-y - self.mouse-y) / travel));
            } else {
                Controls.set-parameter(index, to-param(inverted, drag-start + (self.mouse-x - self.pressed-x) / travel));
            }
        }
        double-clicked => {
            if !disabled && !locked {
                Controls.reset(index);
            }
        }
        // Scrolling over the fader moves it, no click needed: up moves a
        // fader up and the crossfader right; a sideways swipe moves the
        // crossfader too. Small steps follow a trackpad smoothly; a mouse
        // wheel's notch moves it at most 5%.
        scroll-event(e) => {
            if disabled || locked {
                return reject;
            }
            let d = vertical ? e.delta-y : (abs(e.delta-x / 1px) > abs(e.delta-y / 1px) ? -e.delta-x : e.delta-y);
            Controls.set-parameter(index, to-param(inverted, pos + max(-0.05, min(0.05, d / 400px))));
            accept
        }
    }

    function to-param(inv: bool, p: float) -> float {
        let c = max(0, min(1, p));
        inv ? 1 - c : c
    }
    TourMark { id: root.tour-id; }
    MapMark { key: root.group + "," + root.key; }
}

// The crossfader. A right-click switches it off and on again
// (`[Mixer],crossfader_enabled`, also in Settings > Mixer): while it is off
// every deck plays as if set to thru, and the fader sits greyed out in the
// centre. While Automix is on it drives the crossfader and holds it locked
// (switched off or not): it slides with each mix, glowing Automix cyan,
// and the mouse and controllers can't move it until Automix stops.
export component Crossfader inherits Rectangle {
    // Names it for the guided tour (see TourMark).
    in property <string> tour-id;
    property <int> enabled-index: Controls.resolve("[Mixer]", "crossfader_enabled");
    property <bool> on: Controls.value(enabled-index, Controls.tick) > 0;
    property <int> automix-index: Controls.resolve("[AutoDJ]", "enabled");
    property <bool> automix: Controls.value(automix-index, Controls.tick) > 0;
    property <length> menu-x;
    height: 28px;
    ControlFader {
        width: root.width;
        height: root.height;
        group: "[Master]";
        key: "crossfader";
        vertical: false;
        center-mark: true;
        ticks: 9;
        look: 1;
        disabled: !on && !automix;
        locked: automix;
        context-menu(x, y) => {
            menu-x = x;
            menu.show();
        }
    }
    menu := PopupWindow {
        x: min(menu-x, root.width - self.width);
        y: root.height + 2px;
        width: automix ? 250px : 150px;
        Rectangle {
            background: Theme.panel-raised;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 8px;
            drop-shadow-color: Theme.s-00000080;
        }
        VerticalLayout {
            padding: 4px;
            Rectangle {
                height: 24px;
                background: ta.has-hover ? Theme.panel-raised.brighter(0.3) : transparent;
                border-radius: 4px;
                Text {
                    x: 10px;
                    text: on ? "Disable crossfader" : "Enable crossfader";
                    color: Theme.text;
                    font-size: 11px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
                ta := TouchArea { clicked => { Controls.toggle(enabled-index); } }
            }
            // Why it won't move, and how to get it back.
            if automix: Text {
                height: 22px;
                x: 10px;
                text: "Automix has it: turn Automix off to take over";
                color: Theme.automix;
                font-size: 10px;
                vertical-alignment: center;
            }
        }
    }
    TourMark { id: root.tour-id; }
}

// Segmented level meter: green, then yellow, then red at the top.
// Headphone cue (PFL) as a bare headphone icon: grey when off, lilac when on.
export component CueHeadphones inherits Rectangle {
    // Names it for the guided tour (see TourMark).
    in property <string> tour-id;
    in property <string> group;
    // Kept for callers: the Tron look lights it lilac whatever the deck.
    in property <color> tint: Theme.accent;
    property <int> index: Controls.resolve(group, "pfl");
    property <bool> lit: Controls.value(index, Controls.tick) > 0;
    property <color> icon-color: lit ? Theme.lilac-text : touch.has-hover ? Theme.text : Theme.text-dim;
    // Just the icon under the fader, no rim or fill: lilac while cueing.
    width: 26px;
    height: 26px;
    HeadphoneIcon { size: 18px; tint: icon-color; }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { Controls.set-value(index, lit ? 0 : 1); }
    }
    TourMark { id: root.tour-id; }
    MapMark { key: root.group + ",pfl"; }
}

export component VuMeter inherits Rectangle {
    in property <string> group;
    in property <string> key: "VuMeter";
    in property <bool> vertical: true;
    in property <int> segments: 16;
    property <int> index: Controls.resolve(group, key);
    property <float> level: Controls.value(index, Controls.tick);
    property <length> gap: 1px;
    property <length> seg: ((vertical ? self.height : self.width) - gap * (segments - 1)) / segments;

    min-width: 3px;
    min-height: 3px;
    for i in segments: Rectangle {
        // Segment 0 is the quietest: at the bottom (vertical) or left.
        property <float> at: (i + 0.5) / segments;
        x: vertical ? 0px : i * (seg + gap);
        y: vertical ? root.height - (i + 1) * seg - i * gap : 0px;
        width: vertical ? root.width : seg;
        height: vertical ? seg : root.height;
        border-radius: 1px;
        background: level < at ? Theme.n-2c2c2f : (at > 0.9 ? #ff453a : (at > 0.72 ? #ffd60a : #30d158));
    }
}

// A stereo meter: left and right side by side.
export component StereoMeter inherits HorizontalLayout {
    in property <string> group;
    spacing: 1px;
    VuMeter { group: group; key: "VuMeterL"; width: 4px; }
    VuMeter { group: group; key: "VuMeterR"; width: 4px; }
}

// A tooltip shown above everything else (see HoverTipView in the main
// window): a title and a line or two, next to the point it was asked for.
export global HoverTip {
    in-out property <bool> shown;
    in-out property <string> title;
    in-out property <string> body;
    // Where it goes, in window coordinates: its top left corner, or its
    // top right one when right-aligned.
    in-out property <bool> right-aligned;
    in-out property <length> x;
    in-out property <length> y;
}

export component HoverTipView inherits Rectangle {
    if HoverTip.shown: Rectangle {
        x: HoverTip.x - root.absolute-position.x - (HoverTip.right-aligned ? self.width : 0px);
        y: HoverTip.y - root.absolute-position.y;
        width: tip.preferred-width;
        height: tip.preferred-height;
        background: Theme.n-0b0b0c;
        border-radius: 4px;
        border-width: 1px;
        border-color: Theme.n-6a6a70;
        drop-shadow-blur: 8px;
        drop-shadow-color: Theme.s-000000a0;
        tip := VerticalLayout {
            padding: 8px;
            spacing: 2px;
            Text { text: HoverTip.title; color: Theme.text; font-size: 12px; font-weight: 700; }
            if HoverTip.body != "": Text { text: HoverTip.body; color: Theme.text-dim; font-size: 12px; }
        }
    }
}

// Pitch reset, VirtualDJ's triangle beside the tempo fader: click and the
// tempo glides back to 0%, click again to stop where it is, double-click
// for 0% at once. Lit while gliding; points towards the fader.
export component PitchReset inherits Rectangle {
    in property <string> group;
    in property <color> tint: Theme.accent;
    in property <bool> points-left: false;
    // A short line at the fader's centre instead of the triangle (the
    // thin-track tempo faders); it works the same.
    in property <bool> notch: false;
    property <int> index: Controls.resolve(group, "rate_reset");
    property <int> rate-index: Controls.resolve(group, "rate");
    property <bool> lit: Controls.value(index, Controls.tick) > 0;
    property <bool> tip-mine;
    // A click just now: another one soon is a double-click.
    property <bool> armed;
    width: 12px;
    height: 16px;
    if notch: Rectangle {
        x: points-left ? parent.width - self.width - 1px : 1px;
        width: 8px;
        height: 2px;
        border-radius: 1px;
        background: lit ? Theme.lilac-text : touch.has-hover ? Theme.text : Theme.n-6e6e73;
    }
    if !notch: Path {
        width: 8px;
        height: 10px;
        viewbox-width: 8;
        viewbox-height: 10;
        fill: lit ? root.tint : touch.has-hover ? Theme.text : Theme.text-dim;
        commands: points-left ? "M 8 0 L 0 5 L 8 10 Z" : "M 0 0 L 8 5 L 0 10 Z";
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        // Double-clicks are counted here: TouchArea's double-clicked
        // misses some when the first click lights the triangle.
        clicked => {
            if armed {
                armed = false;
                Controls.set-value(index, 0);
                Controls.set-value(rate-index, 0);
            } else {
                armed = true;
                Controls.toggle(index);
            }
        }
        changed has-hover => {
            if !self.has-hover && tip-mine {
                tip-mine = false;
                HoverTip.shown = false;
            }
        }
    }
    Timer {
        interval: 400ms;
        running: armed;
        triggered => { armed = false; }
    }
    Timer {
        interval: 600ms;
        running: touch.has-hover && !tip-mine;
        triggered => {
            tip-mine = true;
            HoverTip.title = "PITCH RESET";
            HoverTip.body = "Slowly bring the pitch back to 0%. Click again to stop.\nDouble-click to bring it back immediately";
            HoverTip.right-aligned = points-left;
            HoverTip.x = root.absolute-position.x + (points-left ? root.width : 0px);
            HoverTip.y = root.absolute-position.y + root.height + 6px;
            HoverTip.shown = true;
        }
    }
}

// SYNC (Shift-click syncs once). A right-click opens the deck's quantize:
// on and off, and what it snaps to, 1/16 of a beat up to a bar.
export component SyncButton inherits Rectangle {
    // Names it for the guided tour (see TourMark).
    in property <string> tour-id;
    in property <string> group;
    in property <color> tint: Theme.accent;
    in property <length> font-size: Theme.font-normal;
    // Open the menu leftwards, for a button on the window's right edge.
    in property <bool> menu-right-aligned;
    property <int> index: Controls.resolve(group, "quantize");
    property <int> beats-index: Controls.resolve(group, "quantize_beats");
    property <bool> lit: Controls.value(index, Controls.tick) > 0;
    property <float> beats: Controls.value(beats-index, Controls.tick);
    preferred-width: 28px;
    preferred-height: 22px;
    ControlButton {
        width: parent.width;
        height: parent.height;
        group: group;
        key: "sync_enabled";
        shift-key: "beatsync";
        text: "SYNC";
        tint: tint;
        pill: true;
        font-size: root.font-size;
        right-clicked => { menu.show(); }
    }
    menu := PopupWindow {
        x: menu-right-aligned ? root.width - self.width : 0px;
        y: root.height + 4px;
        width: 214px;
        close-policy: close-on-click-outside;
        Rectangle {
            background: Theme.pill-list;
            border-radius: 9px;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 14px;
            drop-shadow-color: Theme.s-000000a0;
        }
        VerticalLayout {
            padding: 8px;
            spacing: 8px;
            HorizontalLayout {
                Text { text: "Quantize cue/loop"; color: Theme.text; font-size: 13px; vertical-alignment: center; horizontal-stretch: 1; }
                Rectangle {
                    width: 32px;
                    height: 18px;
                    border-radius: 9px;
                    background: lit ? Theme.accent : Theme.n-48484c;
                    Rectangle {
                        x: lit ? parent.width - self.width - 2px : 2px;
                        y: 2px;
                        width: 14px;
                        height: 14px;
                        border-radius: 7px;
                        background: Theme.n-ffffff;
                    }
                    TouchArea { mouse-cursor: pointer; clicked => { Controls.toggle(index); } }
                }
            }
            Rectangle {
                height: 26px;
                border-radius: 4px;
                background: Theme.control;
                HorizontalLayout {
                    padding: 2px;
                    spacing: 2px;
                    for size in [
                        { beats: 0.0625, label: "1/16" },
                        { beats: 0.125, label: "1/8" },
                        { beats: 0.25, label: "1/4" },
                        { beats: 0.5, label: "1/2" },
                        { beats: 1, label: "1" },
                        { beats: 4, label: "4" },
                    ]: Rectangle {
                        property <bool> on: abs(beats - size.beats) < 0.001;
                        horizontal-stretch: 1;
                        border-radius: 3px;
                        background: on ? Theme.accent : sta.has-hover ? Theme.n-38373d : transparent;
                        Text { text: size.label; color: on ? #000000 : Theme.text; font-size: 12px; font-weight: on ? 700 : 400; }
                        sta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                Controls.set-value(beats-index, size.beats);
                                Controls.set-value(index, 1);
                            }
                        }
                    }
                }
            }
            Text { text: "Steps in beats; 4 is a bar."; color: Theme.text-dim; font-size: 11px; }
        }
    }
    TourMark { id: root.tour-id; }
}

// MASTER: lit on the deck the synced decks follow, filled while it is
// pinned there. A click pins this deck as the master (rekordbox's MASTER
// button); another click lets the app pick again.
export component MasterBadge inherits Rectangle {
    in property <string> group;
    in property <length> font-size: 10px;
    // Just "M", in a square (the row of letters under a deck's key).
    in property <bool> letter: false;
    property <int> index: Controls.resolve(group, "sync_leader");
    property <float> state: Controls.value(index, Controls.tick);
    property <bool> leading: state > 0.5;
    property <bool> pinned: state > 1.5;
    property <bool> tip-mine;
    height: 18px;
    preferred-width: letter ? root.height : label.preferred-width + (root.font-size >= 10px ? 12px : 10px);
    // A switch pill: lilac while this deck leads, with a lilac fill too
    // while it is pinned there.
    border-radius: min(7px, self.height / 2);
    border-width: 1px;
    border-color: leading ? Theme.n-6e58a8 : touch.has-hover ? Theme.n-48484c : Theme.n-2c2c31;
    background: pinned ? Theme.accent.with-alpha(0.28) : leading ? Theme.accent.with-alpha(0.12) : Theme.pill;
    label := Text {
        text: letter ? "M" : "Master";
        font-weight: letter ? 600 : 500;
        color: leading ? Theme.lilac-text : touch.has-hover ? Theme.text : Theme.pill-off-text;
        font-size: root.font-size + 1px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { Controls.set-value(index, pinned ? 0 : 2); }
        changed has-hover => {
            if !self.has-hover && tip-mine {
                tip-mine = false;
                HoverTip.shown = false;
            }
        }
    }
    Timer {
        interval: 600ms;
        running: touch.has-hover && !tip-mine;
        triggered => {
            tip-mine = true;
            HoverTip.title = "Master";
            HoverTip.body = pinned ? "Synced decks follow this deck. Click to let openDJ pick the master again"
                : leading ? "Synced decks follow this deck. Click to keep it the master"
                : "Click to make this deck the master that synced decks follow";
            HoverTip.right-aligned = true;
            HoverTip.x = root.absolute-position.x + root.width;
            HoverTip.y = root.absolute-position.y + root.height + 6px;
            HoverTip.shown = true;
        }
    }
}

// A switch.
export component Switch inherits Rectangle {
    in property <bool> on;
    callback toggled(on: bool);
    width: 38px;
    height: 22px;
    border-radius: 11px;
    background: on ? Theme.accent : Theme.n-3a3a3e;
    animate background { duration: 120ms; }
    Rectangle {
        x: on ? parent.width - self.width - 2px : 2px;
        y: 2px;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background: Theme.n-f2f2f7;
        drop-shadow-blur: 2px;
        drop-shadow-color: Theme.s-00000060;
        animate x { duration: 120ms; easing: ease-out; }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(!on); }
    }
}
