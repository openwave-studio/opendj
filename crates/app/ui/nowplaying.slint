// Player mode's karaoke: the track playing over the whole library, its album
// art large on the left with the title, artist, album and year under it,
// and on the right its lyrics as on the karaoke screen (KaraokeColumn), or
// the lyrics list when they aren't timed. The side panel hides while it
// shows. The bar's art and its microphone open and close it; Karaoke Screen
// sends the lyrics to a window of their own. The app fills NowPlayingUi with
// the track the Player bar shows (crate::now_playing_view).
import { Theme } from "theme.slint";
import { LyricsUi, PlayerLyrics, SmallButton } from "lyrics.slint";
import { KaraokeColumn, PlayerKaraoke } from "karaoke.slint";

export global NowPlayingUi {
    in-out property <bool> open;
    in property <bool> loaded;
    in property <string> title;
    in property <string> artist;
    // "Night Shift · 2024", empty for neither.
    in property <string> album;
    in property <image> cover;
    in property <bool> has-cover;
    in property <string> initials;
    in property <color> tint: Theme.f-5b3fd1;
    // The lyrics follow the track playing while it shows.
    public function show() {
        open = true;
        LyricsUi.big = true;
    }
    public function close() {
        open = false;
        LyricsUi.big = false;
    }
    // The bar's art and microphone: open or close.
    public function toggle() {
        if open {
            close();
        } else {
            show();
        }
    }
}

export component NowPlayingView inherits Rectangle {
    background: Theme.browser;
    clip: true;
    // The art's side: as large as the room allows, beside the lyrics.
    property <length> art: max(160px, min(root.height - 220px, root.width * 0.4, 560px));

    // The art again, faint and filling the view, under a darkening wash:
    // the colours of the cover tint the whole page.
    if NowPlayingUi.has-cover: Image {
        width: parent.width;
        height: parent.height;
        source: NowPlayingUi.cover;
        image-fit: cover;
        opacity: 0.22;
    }
    Rectangle {
        background: NowPlayingUi.has-cover
            ? @linear-gradient(180deg, Theme.browser.with-alpha(0.35) 0%, Theme.browser.with-alpha(0.9) 70%, Theme.browser 100%)
            : @linear-gradient(160deg, NowPlayingUi.tint.with-alpha(0.28) 0%, Theme.browser.with-alpha(0) 65%);
    }

    HorizontalLayout {
        padding-left: 44px;
        padding-right: 36px;
        padding-top: 52px;
        padding-bottom: 28px;
        spacing: 44px;

        // The art, then what the track is.
        VerticalLayout {
            width: art;
            alignment: center;
            spacing: 6px;
            Rectangle {
                width: art;
                height: art;
                border-radius: 10px;
                clip: true;
                drop-shadow-blur: 30px;
                drop-shadow-color: Theme.s-000000a0;
                background: NowPlayingUi.loaded ? @linear-gradient(135deg, NowPlayingUi.tint 0%, NowPlayingUi.tint.darker(0.6) 55%, Theme.f-101012 100%) : Theme.control;
                if NowPlayingUi.has-cover: Image {
                    width: parent.width;
                    height: parent.height;
                    source: NowPlayingUi.cover;
                    image-fit: cover;
                }
                if !NowPlayingUi.has-cover: Text {
                    text: NowPlayingUi.loaded ? NowPlayingUi.initials : "♪";
                    color: Theme.n-ffffffd8;
                    font-size: art / 3;
                    font-weight: 700;
                }
            }
            Rectangle { height: 14px; }
            Text {
                text: NowPlayingUi.loaded ? NowPlayingUi.title : "Nothing playing";
                color: Theme.text;
                font-size: 28px;
                font-weight: 800;
                overflow: elide;
            }
            if NowPlayingUi.loaded: Text {
                text: NowPlayingUi.artist;
                color: Theme.text.with-alpha(0.78);
                font-size: 17px;
                font-weight: 600;
                overflow: elide;
            }
            if NowPlayingUi.loaded && NowPlayingUi.album != "": Text {
                text: NowPlayingUi.album;
                color: Theme.text-dim;
                font-size: 14px;
                overflow: elide;
            }
            if !NowPlayingUi.loaded: Text {
                text: "Pick a track and press play: it shows here, with its lyrics.";
                color: Theme.text-dim;
                font-size: 14px;
                wrap: word-wrap;
            }
        }

        // The lyrics: as on the karaoke screen when they are timed, else
        // the lyrics list (no lyrics, Find, lines without times).
        Rectangle {
            horizontal-stretch: 1;
            min-width: 0px;
            if PlayerKaraoke.timed: KaraokeColumn {
                width: 100%;
                height: 100%;
                unit: self.height * 0.9;
                lines: PlayerKaraoke.lines;
                active-line: PlayerKaraoke.active-line;
                sung: PlayerKaraoke.sung;
                word: PlayerKaraoke.word;
                part: PlayerKaraoke.part;
                rest: PlayerKaraoke.rest;
                count-in: PlayerKaraoke.count-in;
                accent: PlayerKaraoke.accent;
            }
            if !PlayerKaraoke.timed: PlayerLyrics {
                width: 100%;
                height: 100%;
                back: false;
                inset: 0px;
                screen-button: false;
            }
        }
    }

    // Sends the lyrics to a window of their own, for a TV or a projector.
    SmallButton {
        x: parent.width - self.width - 20px;
        y: 14px;
        text: LyricsUi.karaoke ? "Close Karaoke Screen" : "Karaoke Screen";
        primary: LyricsUi.karaoke;
        clicked => { LyricsUi.set-karaoke(!LyricsUi.karaoke); }
    }

    // Closes, back to the library: a chevron, as in other players.
    Rectangle {
        x: 14px;
        y: 12px;
        width: 34px;
        height: 34px;
        border-radius: 17px;
        background: cta.has-hover ? Theme.n-ffffff1a : transparent;
        Path {
            width: 16px;
            height: 16px;
            viewbox-width: 16;
            viewbox-height: 16;
            stroke: Theme.text;
            stroke-width: 1.8px;
            commands: "M 3 6 L 8 11 L 13 6";
        }
        cta := TouchArea {
            mouse-cursor: pointer;
            clicked => { NowPlayingUi.close(); }
        }
    }
}
