// The cues of the track on Prep's deck, for its pad pages: hot cues,
// saved loops, Automix points and memory cues.

export struct CueRow {
    // 0 to 7 for hot cues 1 to 8, -1 for a memory cue.
    pad: int,
    is-loop: bool,
    time: string,
    // Where it is: "bar 17", or how long a loop is: "4 bars".
    detail: string,
    name: string,
    color: color,
}

export global CueList {
    // The deck the tab follows: 0 deck 1, 1 deck 2. Prep keeps it on deck 1.
    in-out property <int> deck;
    in property <bool> prep;
    // The track on that deck, empty when none.
    in property <string> title;
    in property <[CueRow]> rows;
    // Whether a loop plays on the deck, so Save loop is offered.
    in property <bool> looping;
    // Names and colors of hot cues 1 to 8 on deck 1, for Prep's pads
    // (an empty name: none; transparent: the pad's own color).
    in property <[string]> pad-names: ["", "", "", "", "", "", "", ""];
    in property <[color]> pad-colors: [transparent, transparent, transparent, transparent, transparent, transparent, transparent, transparent];
    callback pick-deck(deck: int);
    callback rename(row: int, name: string);
    callback recolor(row: int);
    // Moves the cue to hot cue `pad` (0 to 7), or -1: a memory cue.
    callback renumber(row: int, pad: int);
    callback remove(row: int);
    callback go(row: int);
    // A memory cue at the playhead, or the loop playing saved.
    callback add-memory();
    // Prep's Loops page: deck 1's saved loops in time order (their time
    // and length in bars), up to 8. A press on pad `slot` plays its loop,
    // or on an empty one saves the loop playing; `clear` removes it.
    in property <[CueRow]> prep-loops;
    callback loop-pad(slot: int, clear: bool);
    // Prep's Automix page: where Automix mixes deck 1's track in (0) and
    // out (1), as "1:02.4", empty when not set, and where that is.
    in property <[string]> mix-times: ["", ""];
    in property <[string]> mix-details: ["", ""];
    // Jumps to the point, or sets it at the playhead when not set;
    // `clear` removes it.
    callback mix-pad(which: int, clear: bool);
    // Prep's Memory page: deck 1's memory cues (no end) in time order, up
    // to 8. A press jumps to one, or on an empty pad adds one at the
    // playhead; `clear` removes it.
    in property <[CueRow]> prep-memory;
    callback memory-pad(slot: int, clear: bool);
}
