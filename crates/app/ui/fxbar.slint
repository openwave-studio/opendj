// The FX bar: a full-width row of its own under the decks, after djay
// Pro's. Each deck's three effects over its own width and the Beat FX in
// the middle, as wide as the mixer. An effect has its name (the list
// under it picks another), ON, its length in beats (beat-synced effects)
// or a slider for its second control (the others), and its D/W knob (the
// effect's main knob, `meta`, which controllers turn too). In 2-Deck Basic each
// effect is a cell of two rows, the name stepped with arrows either side;
// in 4-Deck each deck's three are stacked in one-line rows. The FX button
// in the top bar shows and hides the bar.
import { Theme } from "theme.slint";
import { TourMark } from "tourmark.slint";
import { ControlButton, Controls, PickupDot, PickupGhost } from "controls.slint";
import { EffectList, EffectMenu } from "deck.slint";
import { MapMark } from "mapmark.slint";

// ‹ or ›, stepping to the previous or next effect.
component StepArrow inherits Rectangle {
    in property <bool> next;
    in property <int> index;
    // The control, for Map mode: `[EffectRack1_EffectUnit1_Effect1],next_effect`.
    in property <string> map-key;
    width: 28px;
    Path {
        width: 6px;
        height: 10px;
        viewbox-width: 6;
        viewbox-height: 10;
        commands: next ? "M 1 1 L 5 5 L 1 9" : "M 5 1 L 1 5 L 5 9";
        stroke: ta.pressed ? Theme.text-dim : ta.has-hover ? Theme.text : Theme.n-b0b0b5;
        stroke-width: 1.6px;
        stroke-line-cap: round;
        fill: transparent;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            Controls.set-value(index, 1);
            Controls.set-value(index, 0);
        }
    }
    MapMark { key: root.map-key; }
}

// A filled triangle halving or doubling the beats.
component BeatArrow inherits Rectangle {
    in property <bool> next;
    in property <bool> enabled;
    callback clicked();
    width: 14px;
    Path {
        width: 9px;
        height: 12px;
        viewbox-width: 9;
        viewbox-height: 12;
        commands: next ? "M 0 0 L 9 6 L 0 12 Z" : "M 9 0 L 0 6 L 9 12 Z";
        fill: !enabled ? Theme.n-3a3a3e : ta.pressed ? Theme.n-6e6e73 : ta.has-hover ? Theme.n-a8a8ad : Theme.n-6e6e73;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// ◀ 1/8 ▶: an effect's length, halved and doubled from 1/16 to 4 beats.
component BeatChooser inherits HorizontalLayout {
    in property <int> index;
    property <float> beats: Controls.value(index, Controls.tick);
    BeatArrow {
        enabled: beats > 1 / 16;
        clicked => {
            if beats > 1 / 16 {
                Controls.set-value(index, beats / 2);
            }
        }
    }
    Text {
        min-width: 22px;
        horizontal-stretch: 1;
        text: beats <= 0 ? "–" : beats < 1 ? "1/" + round(1 / beats) : round(beats);
        color: Theme.n-b0b0b5;
        font-size: 13px;
        font-weight: 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    BeatArrow {
        next: true;
        enabled: beats > 0 && beats < 4;
        clicked => {
            if beats > 0 && beats < 4 {
                Controls.set-value(index, beats * 2);
            }
        }
    }
}

// A thin track with ticks and a round thumb: an effect's second control.
component ParamSlider inherits Rectangle {
    in property <int> index;
    property <float> pos: Controls.parameter(index, Controls.tick);
    property <float> hardware: Controls.hardware(index, Controls.tick);
    property <length> thumb: 14px;
    property <length> travel: self.width - thumb;
    property <float> drag-start;
    min-width: 40px;
    horizontal-stretch: 1;
    Rectangle {
        x: thumb / 2;
        width: travel;
        height: 2px;
        background: Theme.n-3a3a3e;
    }
    for t in 5: Rectangle {
        x: thumb / 2 + t * travel / 4 - 0.5px;
        y: parent.height / 2 - 4px;
        width: 1px;
        height: 8px;
        background: Theme.n-3a3a3e;
    }
    if hardware >= 0: PickupGhost {
        x: hardware * travel;
        width: thumb;
        height: thumb;
        border-radius: thumb / 2;
        arrow: false;
    }
    Rectangle {
        x: pos * travel;
        width: thumb;
        height: thumb;
        border-radius: thumb / 2;
        background: touch.pressed ? @linear-gradient(180deg, #8e8e93 0%, #6e6e73 100%) : touch.has-hover ? @linear-gradient(180deg, #a8a8ad 0%, #7c7c81 100%) : @linear-gradient(180deg, #98989d 0%, #6e6e73 100%);
        drop-shadow-blur: 3px;
        drop-shadow-color: Theme.s-00000080;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                let at = (self.mouse-x - thumb / 2) / travel;
                if abs(at - pos) * travel > thumb / 2 {
                    Controls.set-parameter(index, clamp(at, 0, 1));
                    drag-start = clamp(at, 0, 1);
                } else {
                    drag-start = pos;
                }
            }
        }
        moved => {
            if self.pressed {
                Controls.set-parameter(index, clamp(drag-start + (self.mouse-x - self.pressed-x) / travel, 0, 1));
            }
        }
        double-clicked => { Controls.reset(index); }
        scroll-event(e) => {
            let d = abs(e.delta-x / 1px) > abs(e.delta-y / 1px) ? -e.delta-x : e.delta-y;
            Controls.set-parameter(index, clamp(pos + max(-0.05, min(0.05, d / 400px)), 0, 1));
            accept
        }
    }
}

// A small round knob for D/W, its arc in the tint.
component DwKnob inherits Rectangle {
    in property <int> index;
    in property <color> tint;
    property <float> param: Controls.parameter(index, Controls.tick);
    property <float> drag-start;
    property <angle> a: -135deg + param * 270deg;
    property <float> hardware: Controls.hardware(index, Controls.tick);
    width: 20px;
    height: 20px;
    Rectangle {
        border-radius: self.width / 2;
        background: ta.has-hover ? Theme.n-2a2a2e : Theme.n-121214;
        border-width: 1.5px;
        border-color: Theme.n-58585d;
    }
    Path {
        viewbox-width: 100;
        viewbox-height: 100;
        stroke: param > 0.004 ? tint : Theme.n-e4e4e8;
        stroke-width: 2px;
        stroke-line-cap: round;
        MoveTo { x: 50 + 4 * sin(a); y: 50 - 4 * cos(a); }
        LineTo { x: 50 + 34 * sin(a); y: 50 - 34 * cos(a); }
    }
    if hardware >= 0: PickupDot { at: hardware; tint: tint; }
    ta := TouchArea {
        mouse-cursor: ns-resize;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                drag-start = param;
            }
        }
        moved => {
            Controls.set-parameter(index, clamp(drag-start + (self.pressed-y - self.mouse-y) / 160px, 0, 1));
        }
        double-clicked => { Controls.reset(index); }
        scroll-event(e) => {
            Controls.set-parameter(index, clamp(param + (e.delta-y > 0 ? 0.02 : -0.02), 0, 1));
            accept
        }
    }
}

// One effect: the effect chooser on top, ON, beats or slider and D/W under it.

// Three short bars, high on top and low at the bottom: the bands an effect
// works on, each lit in its band's color, or all lilac for the whole signal.
component BandIcon inherits Rectangle {
    // The slot's `band`: 0 the whole signal, else 1 low + 2 mid + 4 high.
    in property <int> mask;
    width: 10px;
    height: 8px;
    for i in 3: Rectangle {
        property <int> bit: i == 0 ? 4 : i == 1 ? 2 : 1;
        property <bool> lit: mask == 0 || mask == 7 || mod(floor(mask / bit), 2) == 1;
        x: 0px;
        y: i * 3px;
        width: 10px;
        height: 2px;
        border-radius: 1px;
        background: !lit ? Theme.n-48484c
            : mask == 0 || mask == 7 ? Theme.lilac-text
            : i == 0 ? Theme.band-high : i == 1 ? Theme.band-mid : Theme.band-low;
    }
}

// The name and color of a band choice.
component BandWord inherits Text {
    in property <int> mask;
    text: mask == 1 ? "Low" : mask == 2 ? "Mid" : mask == 4 ? "High"
        : mask == 3 ? "Low+Mid" : mask == 6 ? "Mid+High" : mask == 5 ? "Low+High" : "All";
    color: mask == 1 ? Theme.band-low : mask == 2 ? Theme.band-mid : mask == 4 ? Theme.band-high : Theme.lilac-text;
    font-size: 12px;
    font-weight: 500;
    vertical-alignment: center;
}

// A dark value pill: what is set, in its color, and ▾ for a titled list.
// It outlines on hover.
component ValuePill inherits Rectangle {
    in property <bool> open;
    callback clicked();
    height: 22px;
    border-radius: 7px;
    background: Theme.light ? #ffffff : ta.has-hover || open ? #17151e : #111113;
    border-width: 1px;
    border-color: ta.has-hover || open ? Theme.n-6e58a8 : Theme.n-2c2c31;
    animate border-color { duration: 120ms; }
    @children
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// The small ▾ in a value pill.
component PillCaret inherits Path {
    width: 7px;
    height: 4px;
    viewbox-width: 7;
    viewbox-height: 4;
    commands: "M 0 0 L 7 0 L 3.5 4 Z";
    fill: Theme.lilac-text.with-alpha(0.7);
}

// A row in a titled list: lit (tinted, the text in its color) when it is
// the one set, a lighter row under the pointer.
component ListRow inherits Rectangle {
    in property <bool> selected;
    callback clicked();
    height: 28px;
    border-radius: 6px;
    background: ta.has-hover ? Theme.n-38373d : selected ? Theme.n-313036 : transparent;
    @children
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// The titled list a value pill opens.
component TitledList inherits Rectangle {
    in property <string> title;
    background: Theme.light ? #ffffff : #262629;
    border-radius: 9px;
    border-width: 1px;
    border-color: Theme.border;
    drop-shadow-blur: 14px;
    drop-shadow-color: Theme.s-000000a0;
    VerticalLayout {
        padding: 8px;
        padding-top: 10px;
        spacing: 1px;
        Text {
            text: root.title;
            color: Theme.text;
            font-size: 13px;
            font-weight: 700;
            height: 24px;
            vertical-alignment: top;
            x: 8px;
        }
        @children
    }
}

// Band: a value pill for the bands an effect works on, with a titled list
// of Whole signal, Low, Mid and High. The effect plays on the bands chosen
// and the others pass by it, as on the RMX's band levers.
component BandPill inherits HorizontalLayout {
    in property <string> fx;
    in property <bool> with-label: true;
    // Only the mark, for 4-Deck's one-line effects.
    in property <bool> compact;
    property <int> band-index: Controls.resolve(fx, "band");
    property <int> mask: Controls.value(band-index, Controls.tick);
    spacing: 6px;
    if with-label: Text {
        text: "Band";
        color: Theme.n-a8a8ad;
        font-size: 11.5px;
        vertical-alignment: center;
    }
    VerticalLayout {
        alignment: center;
        pill := ValuePill {
            open: false;
            clicked => { list.show(); }
            HorizontalLayout {
                padding-left: 9px;
                padding-right: 9px;
                spacing: 5px;
                VerticalLayout { alignment: center; BandIcon { mask: mask; } }
                if !compact: BandWord { mask: mask; }
                VerticalLayout { alignment: center; PillCaret { } }
            }
            MapMark { key: root.fx + ",band"; }
        }
    }
    list := PopupWindow {
        x: 0px;
        y: pill.y + pill.height + 4px;
        width: 172px;
        close-policy: close-on-click-outside;
        TitledList {
            title: "Band";
            for b[i] in [0, 1, 2, 4]: ListRow {
                selected: (mask == 7 ? 0 : mask) == b;
                clicked => {
                    Controls.set-value(band-index, b);
                    list.close();
                }
                HorizontalLayout {
                    padding-left: 8px;
                    spacing: 10px;
                    VerticalLayout { alignment: center; BandIcon { mask: b; } }
                    Text {
                        property <bool> chosen: (mask == 7 ? 0 : mask) == b;
                        text: b == 0 ? "Whole signal" : b == 1 ? "Low" : b == 2 ? "Mid" : "High";
                        color: chosen ? (b == 1 ? Theme.band-low : b == 2 ? Theme.band-mid : b == 4 ? Theme.band-high : Theme.lilac-text) : Theme.text;
                        font-size: 13px;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}

// The effect's name and ▾, opening the list of effects under it. Picking
// one loads it and turns it on; picking the loaded one turns it on or off.
// A change from anywhere else (a controller, the ‹ › arrows, OSC) makes the
// name glow for about 2 s; with `strip`, a strip under it also shows the
// effects before and after it in the list.
component EffectPicker inherits Rectangle {
    in property <string> fx;
    in property <color> tint;
    in property <length> font-size: 14px;
    in property <bool> centred: true;
    in property <bool> strip;
    // Set by a pick from the list, so that change doesn't glow.
    property <bool> own-pick;
    property <bool> glowing: glow-timer.running;
    property <int> loaded-index: Controls.resolve(fx, "loaded_effect");
    property <int> enabled-index: Controls.resolve(fx, "enabled");
    property <int> loaded: Controls.value(loaded-index, Controls.tick);
    property <bool> has-effect: loaded > 0 && loaded <= EffectList.names.length;
    min-width: 0px;
    horizontal-stretch: 1;
    HorizontalLayout {
        alignment: centred ? center : start;
        spacing: 5px;
        Text {
            min-width: 0px;
            text: has-effect ? EffectList.names[loaded - 1] : "No effect";
            color: !has-effect ? Theme.text-dim : glowing ? Theme.lilac-text : ta.has-hover ? Theme.n-ffffff : Theme.text;
            animate color { duration: 300ms; }
            font-size: root.font-size;
            font-weight: 500;
            vertical-alignment: center;
            overflow: elide;
        }
        Path {
            width: 9px;
            height: 6px;
            y: (parent.height - self.height) / 2;
            viewbox-width: 9;
            viewbox-height: 6;
            commands: "M 1 1 L 4.5 4.5 L 8 1";
            stroke: ta.has-hover ? Theme.text : Theme.n-b0b0b5;
            stroke-width: 1.6px;
            stroke-line-cap: round;
            fill: transparent;
        }
    }
    property <int> menu-tab;
    changed loaded => {
        if own-pick {
            own-pick = false;
        } else if has-effect {
            glow-timer.running = false;
            glow-timer.running = true;
            if strip {
                strip-popup.show();
            }
        }
    }
    glow-timer := Timer {
        interval: 2s;
        running: false;
        triggered => {
            self.running = false;
            strip-popup.close();
        }
    }
    // The effects either side, in list order, while the name glows.
    property <int> before: loaded >= 1 && loaded <= EffectList.previous.length ? EffectList.previous[loaded - 1] : 0;
    property <int> after: loaded >= 1 && loaded <= EffectList.following.length ? EffectList.following[loaded - 1] : 0;
    strip-popup := PopupWindow {
        x: (root.width - 238px) / 2;
        y: root.height + 2px;
        width: 238px;
        height: 26px;
        close-policy: no-auto-close;
        Rectangle {
            background: Theme.panel-raised;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 8px;
            drop-shadow-color: Theme.s-000000a0;
        }
        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            spacing: 6px;
            Text {
                horizontal-stretch: 1;
                min-width: 0px;
                text: before >= 1 && before <= EffectList.names.length ? "‹ " + EffectList.names[before - 1] : "";
                color: Theme.text-dim;
                font-size: 11px;
                vertical-alignment: center;
                overflow: elide;
            }
            Rectangle {
                horizontal-stretch: 0;
                y: (parent.height - self.height) / 2;
                height: 18px;
                width: current-name.preferred-width + 12px;
                border-radius: 3px;
                background: tint.with-alpha(0.35);
                current-name := Text {
                    text: has-effect ? EffectList.names[loaded - 1] : "";
                    color: Theme.text;
                    font-size: 11px;
                    font-weight: 500;
                    vertical-alignment: center;
                }
            }
            Text {
                horizontal-stretch: 1;
                min-width: 0px;
                text: after >= 1 && after <= EffectList.names.length ? EffectList.names[after - 1] + " ›" : "";
                color: Theme.text-dim;
                font-size: 11px;
                horizontal-alignment: right;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            menu-tab = loaded > EffectList.builtin-count ? 1 : 0;
            menu.show();
        }
    }
    menu := PopupWindow {
        x: centred ? (root.width - 210px) / 2 : 0px;
        y: root.height + 2px;
        width: 210px;
        close-policy: close-on-click-outside;
        Rectangle {
            background: Theme.panel-raised;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 12px;
            drop-shadow-color: Theme.s-000000a0;
        }
        EffectMenu {
            loaded: loaded;
            tint: tint;
            tab <=> root.menu-tab;
            picked(i) => {
                if loaded == i + 1 {
                    Controls.toggle(enabled-index);
                } else {
                    own-pick = true;
                    Controls.set-value(loaded-index, i + 1);
                    Controls.set-value(enabled-index, 1);
                }
                menu.close();
            }
        }
    }
}

// ON, then (with `with-name`) the effect's name, its beats or slider, and D/W.
component FxControls inherits HorizontalLayout {
    in property <string> fx;
    in property <color> tint;
    in property <bool> with-name;
    property <int> enabled-index: Controls.resolve(fx, "enabled");
    property <int> loaded-index: Controls.resolve(fx, "loaded_effect");
    property <int> beats-index: Controls.resolve(fx, "beats");
    property <bool> on: Controls.value(enabled-index, Controls.tick) > 0;
    property <int> loaded: Controls.value(loaded-index, Controls.tick);
    property <float> beats: Controls.value(beats-index, Controls.tick);
    property <bool> has-effect: loaded > 0 && loaded <= EffectList.names.length;
    property <int> param: !has-effect ? -1 : loaded > EffectList.builtin-count ? 0 : loaded <= EffectList.slider-params.length ? EffectList.slider-params[loaded - 1] : -1;
    property <bool> plugin: has-effect && loaded > EffectList.builtin-count;
    padding-left: 6px;
    padding-right: 6px;
    spacing: 4px;
    // ON, lit in the deck's color while the effect plays.
    Rectangle {
        width: 34px;
        height: 23px;
        y: (parent.height - self.height) / 2;
        border-radius: 6px;
        background: on ? tint : ota.pressed ? Theme.control-pressed : ota.has-hover ? Theme.n-222225 : Theme.n-141416;
        border-width: 1px;
        border-color: on ? tint : Theme.n-48484c;
        Text { text: "ON"; color: on ? #ffffff : has-effect ? Theme.text : Theme.text-dim; font-size: 12px; font-weight: 500; }
        ota := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                if has-effect {
                    Controls.toggle(enabled-index);
                }
            }
        }
        MapMark { key: root.fx + ",enabled"; }
        TourMark { id: root.fx + ",enabled"; }
    }
    // A plugin's own window, for its presets and every setting: lit while
    // it is open.
    if plugin: ControlButton {
        width: 34px;
        height: 23px;
        y: (parent.height - self.height) / 2;
        group: fx;
        key: "show_editor";
        text: "EDIT";
        tint: tint;
        font-size: 10px;
        outline-when-lit: true;
    }
    if with-name: EffectPicker { fx: fx; tint: tint; font-size: 13px; centred: false; min-width: 64px; preferred-width: 110px; horizontal-stretch: 0; }
    Rectangle {
        horizontal-stretch: 1;
        min-width: 50px;
        if beats > 0: BeatChooser { width: parent.width; height: parent.height; index: beats-index; }
        if beats > 0: TourMark { width: parent.width; height: parent.height; id: root.fx + ",beats"; }
        if beats <= 0 && param >= 0: ParamSlider { width: parent.width; height: parent.height; index: Controls.resolve(fx, "parameter" + (param + 1)); }
        if beats <= 0 && param >= 0: MapMark { width: parent.width; height: parent.height; key: root.fx + ",parameter" + (param + 1); }
    }
    if with-name: BandPill { fx: fx; with-label: false; compact: true; }
    HorizontalLayout {
        horizontal-stretch: 0;
        spacing: 2px;
        Text { text: "D"; color: Theme.text-dim; font-size: 10px; font-weight: 700; vertical-alignment: center; }
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 20px;
                height: 20px;
                DwKnob { index: Controls.resolve(fx, "meta"); tint: tint; }
                MapMark { key: root.fx + ",meta"; }
                TourMark { id: root.fx + ",meta"; }
            }
        }
        Text { text: "W"; color: Theme.text-dim; font-size: 10px; font-weight: 700; vertical-alignment: center; }
    }
}

// 2-Deck Basic: one effect as a cell of two rows, ‹ name ▾ › over its controls.
component FxCell inherits Rectangle {
    // The effect unit and slot, from 0.
    in property <int> unit;
    in property <int> slot;
    in property <color> tint;
    property <string> fx: "[EffectRack1_EffectUnit" + (unit + 1) + "_Effect" + (slot + 1) + "]";
    background: Theme.panel;
    horizontal-stretch: 1;
    min-width: 0px;
    preferred-width: 0px;
    VerticalLayout {
        spacing: 0px;
        HorizontalLayout {
            height: 30px;
            StepArrow { index: Controls.resolve(fx, "prev_effect"); map-key: fx + ",prev_effect"; }
            EffectPicker { fx: fx; tint: tint; }
            StepArrow { next: true; index: Controls.resolve(fx, "next_effect"); map-key: fx + ",next_effect"; }
        }
        Rectangle { height: 1px; background: Theme.edge; }
        FxControls { height: 37px; fx: fx; tint: tint; }
        Rectangle { height: 1px; background: Theme.edge; }
        HorizontalLayout {
            height: 31px;
            padding-left: 10px;
            padding-right: 10px;
            alignment: start;
            BandPill { fx: fx; }
        }
    }
    // The name, for the step that picks another effect.
    TourMark { id: root.fx; y: 0px; height: 30px; }
}

// 4-Deck: a deck's three effects stacked, one line each.
component FxStack inherits Rectangle {
    in property <int> deck;
    background: Theme.panel;
    horizontal-stretch: 1;
    min-width: 0px;
    preferred-width: 0px;
    VerticalLayout {
        padding-top: 2px;
        padding-bottom: 2px;
        for i in 3: FxControls {
            vertical-stretch: 1;
            fx: "[EffectRack1_EffectUnit" + (deck + 1) + "_Effect" + (i + 1) + "]";
            tint: Theme.deck-color(deck);
            with-name: true;
        }
    }
}

// A word that lights up when chosen, as djay's MANUAL / INSTANT.
component TextToggle inherits Text {
    in property <bool> lit;
    callback clicked();
    color: lit ? Theme.lilac-text : ta.has-hover ? Theme.text : Theme.text-dim;
    font-size: 11px;
    font-weight: 600;
    vertical-alignment: center;
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// Release: how `[Master],fx_release` lets go (a value pill with Echo,
// Brake, Spin and Cut) and a round button that does it while held. Every
// effect stops; Echo lets the echoes ring out, Brake slows the main mix to a
// stop and Spin spins it back for a beat (both come back on letting go),
// Cut mutes it while held.
component ReleaseControls inherits HorizontalLayout {
    property <int> mode-index: Controls.resolve("[Master]", "fx_release_mode");
    property <int> fire-index: Controls.resolve("[Master]", "fx_release");
    property <int> mode: Controls.value(mode-index, Controls.tick);
    property <bool> held: Controls.value(fire-index, Controls.tick) > 0;
    spacing: 6px;
    Text {
        text: "Release";
        color: Theme.n-a8a8ad;
        font-size: 11.5px;
        vertical-alignment: center;
    }
    VerticalLayout {
        alignment: center;
        pill := ValuePill {
            clicked => { list.show(); }
            HorizontalLayout {
                padding-left: 9px;
                padding-right: 9px;
                spacing: 5px;
                Text {
                    text: mode == 1 ? "Brake" : mode == 2 ? "Spin" : mode == 3 ? "Cut" : "Echo";
                    color: Theme.lilac-text;
                    font-size: 12px;
                    font-weight: 500;
                    vertical-alignment: center;
                }
                VerticalLayout { alignment: center; PillCaret { } }
            }
            MapMark { key: "[Master],fx_release_mode"; }
        }
    }
    VerticalLayout {
        alignment: center;
        Rectangle {
            width: 22px;
            height: 22px;
            border-radius: 11px;
            background: held ? Theme.n-ff6b70.with-alpha(0.25) : fta.has-hover ? #2a1a1c : Theme.light ? #ffffff : #111113;
            border-width: 1px;
            border-color: held || fta.has-hover ? Theme.n-ff6b70 : Theme.n-ff6b70.with-alpha(0.45);
            Path {
                width: 10px;
                height: 11px;
                viewbox-width: 10;
                viewbox-height: 11;
                commands: "M 5 1 L 5 7 M 2 4.5 L 5 7.5 L 8 4.5 M 1.5 10 L 8.5 10";
                stroke: Theme.n-ff6b70;
                stroke-width: 1.5px;
                stroke-line-cap: round;
                fill: transparent;
            }
            fta := TouchArea {
                mouse-cursor: pointer;
                changed pressed => {
                    Controls.set-value(fire-index, self.pressed ? 1 : 0);
                }
            }
            MapMark { key: "[Master],fx_release"; }
        }
    }
    list := PopupWindow {
        x: pill.x;
        y: pill.y + pill.height + 4px;
        width: 160px;
        close-policy: close-on-click-outside;
        TitledList {
            title: "Release";
            for m[i] in ["Echo", "Brake", "Spin", "Cut"]: ListRow {
                selected: mode == i;
                clicked => {
                    Controls.set-value(mode-index, i);
                    list.close();
                }
                HorizontalLayout {
                    padding-left: 8px;
                    Text {
                        text: m;
                        color: mode == i ? Theme.lilac-text : Theme.text;
                        font-size: 13px;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}

// The middle, as wide as the mixer: BEAT FX, the effect (its list under
// the name) and where it goes (deck 1, deck 2, both or the main mix; on
// 4-Deck any one deck or the main mix), over ON, its length in beats and
// LEVEL as D/W. The BEAT FX sections of Pioneer controllers drive the same
// controls.
component BeatFxSection inherits Rectangle {
    in property <bool> four;
    property <string> unit: "[EffectRack1_EffectUnit5]";
    property <string> fx: "[EffectRack1_EffectUnit5_Effect1]";
    // 0 off, 1 to 4 a deck, 5 decks 1 and 2, 6 the main mix (MST).
    property <int> route-index: Controls.resolve(unit, "route");
    property <int> route: Controls.value(route-index, Controls.tick);
    background: Theme.panel;
    width: 254px;
    VerticalLayout {
        alignment: center;
        spacing: 0px;
        HorizontalLayout {
            height: 30px;
            padding-left: 8px;
            padding-right: 8px;
            spacing: 6px;
            if !four: Text { text: "BEAT FX"; color: Theme.text-dim; font-size: 9px; font-weight: 700; letter-spacing: 0.5px; vertical-alignment: center; }
            EffectPicker { fx: fx; tint: Theme.accent; strip: true; }
            // Where it goes, as `route` values.
            for c[i] in four ? ["1", "2", "3", "4", "MST"] : ["1", "2", "1&2", "MST"]: TextToggle {
                property <int> value: four ? (i == 4 ? 6 : i + 1) : (i == 2 ? 5 : i == 3 ? 6 : i + 1);
                text: c;
                lit: route == value;
                clicked => {
                    Controls.set-value(route-index, value);
                }
            }
        }
        Rectangle { height: 1px; background: Theme.edge; }
        FxControls { height: 37px; fx: fx; tint: Theme.accent; }
        if !four: Rectangle { height: 1px; background: Theme.edge; }
        if !four: HorizontalLayout {
            height: 31px;
            padding-left: 8px;
            padding-right: 8px;
            spacing: 6px;
            BandPill { fx: fx; with-label: false; }
            Rectangle { horizontal-stretch: 1; }
            ReleaseControls { }
        }
    }
    TourMark { id: root.unit; }
}

export component FxBar inherits Rectangle {
    // 4-Deck: decks 3 and 1 left of the Beat FX, 2 and 4 right of it, each
    // deck's effects stacked.
    in property <bool> four;
    background: Theme.n-000000;
    height: four ? 96px : 100px;
    if !four: HorizontalLayout {
        spacing: 1px;
        // As wide as the decks above, either side of the mixer.
        HorizontalLayout {
            spacing: 1px;
            horizontal-stretch: 1;
            min-width: 400px;
            preferred-width: 400px;
            for i in 3: FxCell { unit: 0; slot: i; tint: Theme.deck1; }
        }
        BeatFxSection { }
        HorizontalLayout {
            spacing: 1px;
            horizontal-stretch: 1;
            min-width: 400px;
            preferred-width: 400px;
            for i in 3: FxCell { unit: 1; slot: i; tint: Theme.deck2; }
        }
    }
    if four: HorizontalLayout {
        spacing: 1px;
        FxStack { deck: 2; }
        FxStack { deck: 0; }
        BeatFxSection { four: true; }
        FxStack { deck: 1; }
        FxStack { deck: 3; }
    }
}
