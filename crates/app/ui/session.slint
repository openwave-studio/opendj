// The Session: a Live set's clips, launched from a grid of tracks
// (columns) and scenes (rows), playing on the Session channel in time with
// the master deck. Shown in the Jam source while a set is open.

import { Theme, CloseIcon } from "theme.slint";
import { SwitchPill } from "pills.slint";

export struct SessionTrack {
    name: string,
    color: color,
    // A pale colour, where a playing clip's text goes dark.
    light: bool,
    // How far through its clip it is (0..1), -1 when stopped.
    progress: float,
    // Its level after the fader, 0..1.
    peak: float,
}

// One clip slot. state: 0 empty, 1 a clip, 2 queued to start, 3 playing.
export struct SessionSlot {
    name: string,
    state: int,
}

export global SessionUi {
    in property <bool> open;
    in property <bool> loading;
    in property <bool> playing;
    in property <string> name;
    // What didn't come in from the set.
    in property <string> note;
    in property <string> error;
    in property <[SessionTrack]> tracks;
    in property <int> scenes;
    // Scene by scene, each scene's slots track by track.
    in property <[SessionSlot]> slots;
    // Goes up to bring the Jam source up.
    in-out property <int> show-request;
    callback open-set();
    callback close-set();
    callback launch(track: int, scene: int);
    callback stop(track: int);
    callback scene(scene: int);
    callback stop-all();
}

// A queued clip blinks with the beat's pace while it waits for the bar.
component ClipCell inherits Rectangle {
    in property <SessionSlot> slot;
    in property <color> tint;
    in property <bool> light;
    // On a playing clip's full colour the text is black or white whatever
    // the theme; on the faint ones it follows the theme.
    property <color> ink: playing ? (light ? #000000 : #ffffff) : Theme.text;
    in property <float> progress;
    callback clicked();
    property <bool> queued: slot.state == 2;
    property <bool> playing: slot.state == 3;
    border-radius: 4px;
    background: slot.state == 0
        ? (ta.has-hover ? Theme.n-262629 : Theme.n-1c1c1f)
        : tint.with-alpha(playing ? 0.9 : ta.has-hover ? 0.55 : 0.4);
    border-width: playing ? 1px : 0px;
    border-color: ink.with-alpha(0.7);
    clip: true;
    if slot.state != 0: HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        spacing: 5px;
        Text {
            text: playing ? "▶" : queued ? "▷" : "▷";
            color: playing ? ink : Theme.n-ffffff.with-alpha(queued ? (mod(animation-tick(), 400ms) < 200ms ? 1.0 : 0.3) : 0.6);
            font-size: 10px;
            vertical-alignment: center;
        }
        Text {
            text: slot.name;
            color: ink;
            font-size: 11px;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }
    // How far through the loop it is.
    if playing && progress >= 0: Rectangle {
        x: 0;
        y: parent.height - 3px;
        height: 3px;
        width: parent.width * clamp(progress, 0, 1);
        background: ink.with-alpha(0.8);
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A square button under a track or beside a scene.
component GridButton inherits Rectangle {
    in property <string> text;
    in property <bool> lit;
    callback clicked();
    border-radius: 4px;
    background: ta.pressed ? Theme.control-pressed : ta.has-hover ? Theme.n-262629 : Theme.n-1c1c1f;
    Text {
        text: root.text;
        color: root.lit ? Theme.accent : Theme.text-dim;
        font-size: 11px;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// The grid, with the set's name and STOP ALL above it.
export component SessionGrid inherits Rectangle {
    property <int> count: SessionUi.tracks.length;
    property <length> gap: 3px;
    property <length> scene-width: 44px;
    property <length> head-height: 30px;
    property <length> foot-height: 26px;
    property <length> cell-width: count > 0 ? max(60px, (grid.width - scene-width - gap * count) / count) : 60px;
    property <length> cell-height: SessionUi.scenes > 0
        ? clamp((grid.height - head-height - foot-height - gap * (SessionUi.scenes + 1)) / SessionUi.scenes, 22px, 44px)
        : 30px;
    background: Theme.browser;
    VerticalLayout {
        padding: 10px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 8px;
            height: 26px;
            Text {
                text: SessionUi.name;
                color: Theme.text;
                font-size: 14px;
                font-weight: 600;
                vertical-alignment: center;
                overflow: elide;
            }
            Text {
                text: SessionUi.note;
                color: Theme.text-dim;
                font-size: 11px;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
            SwitchPill {
                text: "STOP ALL";
                font-size: 11px;
                on: SessionUi.playing;
                clicked => { SessionUi.stop-all(); }
            }
            SwitchPill {
                text: "OPEN…";
                font-size: 11px;
                on: false;
                clicked => { SessionUi.open-set(); }
            }
            close := Rectangle {
                width: 26px;
                border-radius: 6px;
                background: cta.has-hover ? Theme.control : transparent;
                CloseIcon { size: 11px; color: cta.has-hover ? Theme.text : Theme.text-dim; }
                cta := TouchArea { mouse-cursor: pointer; clicked => { SessionUi.close-set(); } }
            }
        }
        // Too many tracks for the width: the grid scrolls sideways.
        grid := Flickable {
            vertical-stretch: 1;
            content-width: max(self.width, scene-width + count * (cell-width + gap));
            content-height: max(self.height, head-height + foot-height + SessionUi.scenes * (cell-height + gap) + gap);
            for track[t] in SessionUi.tracks: Rectangle {
                x: t * (cell-width + gap);
                y: 0;
                width: cell-width;
                height: parent.content-height;
                // The track's name on its colour, with its level along the
                // bottom.
                Rectangle {
                    y: 0;
                    height: head-height;
                    border-radius: 4px;
                    background: track.color.with-alpha(0.25);
                    clip: true;
                    Text {
                        x: 6px;
                        width: parent.width - 12px;
                        text: track.name;
                        color: Theme.text;
                        font-size: 11px;
                        font-weight: 600;
                        overflow: elide;
                    }
                    Rectangle {
                        x: 0;
                        y: parent.height - 3px;
                        height: 3px;
                        width: parent.width * clamp(track.peak, 0, 1);
                        background: track.peak > 0.95 ? Theme.f-ff5500 : track.color;
                    }
                    Rectangle { x: 0; width: 3px; background: track.color; }
                }
                for s in SessionUi.scenes: ClipCell {
                    y: head-height + gap + s * (cell-height + gap);
                    height: cell-height;
                    slot: SessionUi.slots[s * count + t];
                    tint: track.color;
                    light: track.light;
                    progress: track.progress;
                    clicked => { SessionUi.launch(t, s); }
                }
                GridButton {
                    y: head-height + gap + SessionUi.scenes * (cell-height + gap);
                    height: foot-height;
                    text: "■";
                    lit: track.progress >= 0;
                    clicked => { SessionUi.stop(t); }
                }
            }
            // The scenes, launched whole from the right.
            for s in SessionUi.scenes: GridButton {
                x: count * (cell-width + gap);
                y: head-height + gap + s * (cell-height + gap);
                width: scene-width;
                height: cell-height;
                text: "▶ " + (s + 1);
                clicked => { SessionUi.scene(s); }
            }
        }
    }
}

// The Jam source with no set open: how to open one.
export component SessionHint inherits HorizontalLayout {
    alignment: center;
    padding-top: 6px;
    spacing: 8px;
    if SessionUi.loading: Text {
        text: "Opening the Live set…";
        color: Theme.text-dim;
        font-size: 12px;
        vertical-alignment: center;
    }
    if !SessionUi.loading: SwitchPill {
        text: "OPEN LIVE SET…";
        font-size: 11px;
        on: false;
        clicked => { SessionUi.open-set(); }
    }
    if SessionUi.error != "": Text {
        text: SessionUi.error;
        color: Theme.f-ff5500;
        font-size: 11px;
        vertical-alignment: center;
    }
}
