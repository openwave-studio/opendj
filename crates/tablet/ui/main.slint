// openDJ for tablets (iPad first): two decks, a folder of tracks and a
// controller, in the desktop app's look: its theme, fonts, logo, buttons
// and waveform colours (see crates/app/ui). Landscape, touch first.

import { ListView } from "std-widgets.slint";
import { Theme } from "../../app/ui/theme.slint";

export struct DeckView {
    loaded: bool,
    title: string,
    artist: string,
    bpm: string,
    key: string,
    elapsed: string,
    remaining: string,
    playing: bool,
    cue-lit: bool,
    sync: bool,
    pfl: bool,
    // Album art, or none for a tile with the artist's initials.
    cover: image,
    has-cover: bool,
    initials: string,
    // The whole track, drawn once it is analysed.
    overview: image,
    // Where the deck is, 0 to 1.
    playhead: float,
    // Seconds around the play position, drawn every frame.
    wave: image,
}

export struct Row {
    title: string,
    artist: string,
    bpm: string,
    key: string,
    time: string,
}

// The headphone glyph, as the desktop's HeadphoneIcon.
component HeadphoneIcon inherits Rectangle {
    in property <length> size: 18px;
    in property <color> tint: Theme.text;
    property <float> k: size / 24px;
    width: size;
    height: size;
    Path {
        width: root.size;
        height: root.size;
        viewbox-width: 24;
        viewbox-height: 24;
        stroke: root.tint;
        stroke-width: 1.6px * k;
        stroke-line-cap: round;
        fill: transparent;
        commands: "M 4.2 19 A 10 10 0 1 1 19.8 19";
    }
    Path {
        width: root.size;
        height: root.size;
        viewbox-width: 24;
        viewbox-height: 24;
        stroke: root.tint;
        stroke-width: 3.55px * k;
        stroke-line-cap: round;
        fill: transparent;
        commands: "M 5.87 14.37 L 7.43 20.63 M 18.13 14.37 L 16.57 20.63";
    }
}

// A flat dark button with a thin border, as the desktop's ControlButton:
// lit, its label and border take the tint.
component Button inherits Rectangle {
    in property <string> text;
    in property <bool> lit;
    in property <color> tint: Theme.accent;
    in property <length> font-size: 15px;
    callback down();
    callback up();
    min-height: 44px;
    min-width: 64px;
    horizontal-stretch: 0;
    border-radius: Theme.radius;
    border-width: root.lit ? 2px : 1px;
    border-color: root.lit ? root.tint : Theme.border;
    background: touch.pressed ? Theme.control-pressed : Theme.control;
    Text {
        text: root.text;
        color: root.lit ? root.tint : Theme.text;
        font-size: root.font-size;
        font-weight: 600;
    }
    touch := TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.down();
            } else if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) {
                root.up();
            }
        }
    }
}

// Play and pause in one button showing ▶, outlined and drawn in the deck
// colour while playing, as the desktop's PlayButton.
component PlayButton inherits Rectangle {
    in property <bool> playing;
    in property <color> tint;
    callback toggle();
    min-height: 44px;
    width: 96px;
    border-radius: Theme.radius;
    border-width: root.playing ? 2px : 1px;
    border-color: root.playing ? root.tint : Theme.border;
    background: touch.pressed ? Theme.control-pressed : Theme.control;
    Path {
        width: 18px;
        height: 20px;
        viewbox-width: 16;
        viewbox-height: 18;
        fill: root.playing ? root.tint : Theme.text;
        commands: "M 1 1 L 15 9 L 1 17 Z";
    }
    touch := TouchArea {
        clicked => {
            root.toggle();
        }
    }
}

// Headphone cue for a deck, filled with the deck colour while on.
component CueHeadphones inherits Rectangle {
    in property <bool> lit;
    in property <color> tint;
    callback toggle();
    width: 56px;
    min-height: 44px;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: root.lit ? root.tint : Theme.border;
    background: root.lit ? root.tint : touch.pressed ? Theme.control-pressed : Theme.control;
    HeadphoneIcon {
        size: 20px;
        tint: root.lit ? #ffffff : Theme.text-dim;
    }
    touch := TouchArea {
        clicked => {
            root.toggle();
        }
    }
}

// The deck's header, as on the desktop: cover, title, artist and tempo,
// time left and key, and the whole track under them.
component DeckPanel inherits Rectangle {
    in property <DeckView> deck;
    in property <color> tint;
    // Deck B mirrors deck A: its controls on the far side from the centre.
    in property <bool> mirrored;
    callback play();
    callback cue(bool);
    callback sync();
    callback pfl();
    callback seek(float);
    background: Theme.panel;
    VerticalLayout {
        padding: 10px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 10px;
            height: 64px;
            // Cover art, or the artist's initials on the deck's colour.
            Rectangle {
                width: 64px;
                border-radius: 4px;
                clip: true;
                background: @linear-gradient(135deg, root.tint, root.tint.darker(0.6));
                visible: root.deck.loaded;
                Text {
                    text: root.deck.initials;
                    color: #ffffff;
                    font-size: 26px;
                    font-weight: 700;
                    visible: !root.deck.has-cover;
                }
                Image {
                    width: 100%;
                    height: 100%;
                    source: root.deck.cover;
                    image-fit: cover;
                    visible: root.deck.has-cover;
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 2px;
                Text {
                    text: root.deck.loaded ? root.deck.title : "Pick a track below, then Load";
                    color: root.deck.loaded ? Theme.text : Theme.text-dim;
                    font-size: 20px;
                    overflow: elide;
                }
                Text {
                    text: root.deck.loaded ? root.deck.artist + (root.deck.bpm != "" ? "  |  " + root.deck.bpm : "") : "";
                    color: Theme.text-dim;
                    font-size: 15px;
                    overflow: elide;
                }
            }
            VerticalLayout {
                alignment: center;
                Text {
                    text: root.deck.remaining;
                    color: Theme.text;
                    font-size: 28px;
                    horizontal-alignment: right;
                }
                Text {
                    text: root.deck.key;
                    color: Theme.key;
                    font-size: 17px;
                    font-weight: 600;
                    horizontal-alignment: right;
                }
            }
        }
        // The whole track; a tap jumps there.
        Rectangle {
            height: 44px;
            background: Theme.wave-well;
            clip: true;
            Image {
                width: 100%;
                height: 100%;
                source: root.deck.overview;
                image-fit: fill;
            }
            // Played so far, dimmed.
            Rectangle {
                width: parent.width * root.deck.playhead;
                x: 0;
                background: #00000066;
                visible: root.deck.loaded;
            }
            Rectangle {
                x: parent.width * root.deck.playhead - 1px;
                width: 2px;
                background: #ffffff;
                visible: root.deck.loaded;
            }
            TouchArea {
                clicked => {
                    if (root.deck.loaded) {
                        root.seek(self.mouse-x / self.width);
                    }
                }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            if root.mirrored: PlayButton {
                playing: root.deck.playing;
                tint: root.tint;
                toggle => {
                    root.play();
                }
            }
            if root.mirrored: Button {
                width: 72px;
                text: "CUE";
                lit: root.deck.cue-lit;
                tint: Theme.cue;
                down => {
                    root.cue(true);
                }
                up => {
                    root.cue(false);
                }
            }
            if root.mirrored: Rectangle {
                horizontal-stretch: 1;
            }
            Button {
                text: "SYNC";
                lit: root.deck.sync;
                tint: Theme.accent;
                font-size: 13px;
                down => {
                    root.sync();
                }
            }
            CueHeadphones {
                lit: root.deck.pfl;
                tint: root.tint;
                toggle => {
                    root.pfl();
                }
            }
            if !root.mirrored: Rectangle {
                horizontal-stretch: 1;
            }
            if !root.mirrored: Button {
                width: 72px;
                text: "CUE";
                lit: root.deck.cue-lit;
                tint: Theme.cue;
                down => {
                    root.cue(true);
                }
                up => {
                    root.cue(false);
                }
            }
            if !root.mirrored: PlayButton {
                playing: root.deck.playing;
                tint: root.tint;
                toggle => {
                    root.play();
                }
            }
        }
    }
}

// One deck's scrolling waveform, the play position in the middle.
component Waveform inherits Rectangle {
    in property <DeckView> deck;
    in property <string> letter;
    in property <color> tint;
    background: Theme.wave-well;
    clip: true;
    Image {
        width: 100%;
        height: 100%;
        source: root.deck.wave;
        image-fit: fill;
    }
    Rectangle {
        x: parent.width / 2 - 1px;
        width: 2px;
        background: #ffffff;
    }
    Rectangle {
        x: 6px;
        y: 6px;
        width: 20px;
        height: 18px;
        border-radius: 3px;
        background: root.tint;
        Text {
            text: root.letter;
            color: #ffffff;
            font-size: 12px;
            font-weight: 700;
        }
    }
    Text {
        x: parent.width - self.width - 8px;
        y: 6px;
        text: root.deck.elapsed;
        color: Theme.text-dim;
        font-size: 12px;
    }
}

// The crossfader, as the desktop's: a slot with a grey handle, centre tick.
component Crossfader inherits Rectangle {
    in property <float> value;
    callback moved(float);
    width: 260px;
    height: 44px;
    property <length> handle: 22px;
    Rectangle {
        y: (parent.height - 4px) / 2;
        height: 4px;
        border-radius: 2px;
        background: Theme.well;
        border-width: 1px;
        border-color: Theme.border;
    }
    Rectangle {
        x: (parent.width - 1px) / 2;
        y: 6px;
        width: 1px;
        height: parent.height - 12px;
        background: Theme.tick;
    }
    Rectangle {
        x: (root.value + 1) / 2 * (parent.width - root.handle);
        y: 4px;
        width: root.handle;
        height: parent.height - 8px;
        border-radius: 3px;
        background: Theme.fader-handle;
        Rectangle {
            width: 2px;
            height: parent.height - 10px;
            background: Theme.panel;
        }
    }
    TouchArea {
        moved => {
            if (self.pressed) {
                root.moved(Math.clamp((self.mouse-x - root.handle / 2) / (root.width - root.handle) * 2 - 1, -1, 1));
            }
        }
        double-clicked => {
            root.moved(0);
        }
    }
}

// A small status pill in the top bar, as the desktop's MIC and MASTER.
component Pill inherits Rectangle {
    in property <string> label;
    in property <string> text;
    in property <bool> ok;
    height: 32px;
    horizontal-stretch: 0;
    border-radius: Theme.radius;
    background: Theme.control;
    border-width: 1px;
    border-color: Theme.border;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        Rectangle {
            width: 7px;
            height: 7px;
            y: (parent.height - 7px) / 2;
            border-radius: 3.5px;
            background: root.ok ? Theme.automix : Theme.text-dim;
        }
        Text {
            text: root.label;
            color: Theme.label;
            font-size: 11px;
            font-weight: 600;
            vertical-alignment: center;
        }
        Text {
            text: root.text;
            color: Theme.text;
            font-size: 13px;
            vertical-alignment: center;
        }
    }
}

export component AppWindow inherits Window {
    title: "openDJ";
    background: Theme.background;
    default-font-family: Theme.font-family;
    preferred-width: 1194px;
    preferred-height: 834px;
    in property <[DeckView]> decks: [{}, {}];
    in property <[Row]> rows;
    in property <int> selected: -1;
    in property <string> status;
    /// The music folder's name.
    in property <string> folder;
    /// Whether there is a folder picker (iPadOS).
    in property <bool> can-pick-folder;
    in property <float> crossfader;
    // What's connected: controllers by name, and where the audio goes.
    in property <string> controllers;
    in property <string> outputs;
    in property <bool> phones;
    callback play(int);
    callback cue(int, bool);
    callback sync(int);
    callback pfl(int);
    callback seek(int, float);
    callback select(int);
    callback load(int);
    callback rescan();
    callback pick-folder();
    callback crossfade(float);

    VerticalLayout {
        // The top bar: what's connected on the left, the logo in the middle.
        Rectangle {
            height: 52px;
            background: Theme.panel;
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 10px;
                padding-bottom: 10px;
                spacing: 8px;
                Pill {
                    label: "CONTROLLER";
                    text: root.controllers != "" ? root.controllers : "None";
                    ok: root.controllers != "";
                }
                Pill {
                    label: "AUDIO";
                    text: root.outputs;
                    ok: root.phones;
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
                if root.can-pick-folder: Button {
                    text: "Folder";
                    min-height: 32px;
                    font-size: 13px;
                    width: 84px;
                    down => {
                        root.pick-folder();
                    }
                }
                Button {
                    text: "Rescan";
                    min-height: 32px;
                    font-size: 13px;
                    width: 84px;
                    down => {
                        root.rescan();
                    }
                }
            }
            HorizontalLayout {
                alignment: center;
                spacing: 8px;
                VerticalLayout {
                    alignment: center;
                    Image {
                        source: @image-url("../../app/ui/icons/opendj-mark.svg");
                        width: 32px;
                        height: 20px;
                    }
                }
                Text {
                    text: "openDJ";
                    color: Theme.text;
                    font-family: Theme.brand-font;
                    font-size: 21px;
                    vertical-alignment: center;
                }
            }
        }
        Rectangle {
            height: 1px;
            background: Theme.edge;
        }
        // Both decks' waveforms, stacked, to line up beats by eye.
        Waveform {
            height: 100px;
            deck: root.decks[0];
            letter: "A";
            tint: Theme.deck1;
        }
        Rectangle {
            height: 1px;
            background: Theme.edge;
        }
        Waveform {
            height: 100px;
            deck: root.decks[1];
            letter: "B";
            tint: Theme.deck2;
        }
        Rectangle {
            height: 1px;
            background: Theme.edge;
        }
        HorizontalLayout {
            DeckPanel {
                horizontal-stretch: 1;
                deck: root.decks[0];
                tint: Theme.deck1;
                play => {
                    root.play(0);
                }
                cue(down) => {
                    root.cue(0, down);
                }
                sync => {
                    root.sync(0);
                }
                pfl => {
                    root.pfl(0);
                }
                seek(at) => {
                    root.seek(0, at);
                }
            }
            Rectangle {
                width: 1px;
                background: Theme.edge;
            }
            DeckPanel {
                horizontal-stretch: 1;
                deck: root.decks[1];
                tint: Theme.deck2;
                mirrored: true;
                play => {
                    root.play(1);
                }
                cue(down) => {
                    root.cue(1, down);
                }
                sync => {
                    root.sync(1);
                }
                pfl => {
                    root.pfl(1);
                }
                seek(at) => {
                    root.seek(1, at);
                }
            }
        }
        // The crossfader, for when no controller is plugged in.
        Rectangle {
            height: 52px;
            background: Theme.panel;
            HorizontalLayout {
                alignment: center;
                Crossfader {
                    value: root.crossfader;
                    moved(v) => {
                        root.crossfade(v);
                    }
                }
            }
        }
        Rectangle {
            height: 1px;
            background: Theme.edge;
        }
        // The tracks in the folder, as the desktop's track list.
        Rectangle {
            vertical-stretch: 1;
            background: Theme.browser;
            VerticalLayout {
                HorizontalLayout {
                    height: 52px;
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-top: 6px;
                    padding-bottom: 6px;
                    spacing: 10px;
                    Text {
                        text: root.folder != "" ? root.folder : "Collection";
                        color: Theme.text;
                        font-size: 17px;
                        font-weight: 600;
                        vertical-alignment: center;
                        overflow: elide;
                        max-width: 280px;
                    }
                    Text {
                        text: root.status != "" ? root.status : root.rows.length + " Songs";
                        color: Theme.text-dim;
                        font-size: 14px;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    Button {
                        text: "Load A";
                        lit: true;
                        tint: Theme.deck1;
                        width: 96px;
                        font-size: 14px;
                        down => {
                            root.load(0);
                        }
                    }
                    Button {
                        text: "Load B";
                        lit: true;
                        tint: Theme.deck2;
                        width: 96px;
                        font-size: 14px;
                        down => {
                            root.load(1);
                        }
                    }
                }
                // Column headings.
                HorizontalLayout {
                    height: 28px;
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 12px;
                    Text {
                        horizontal-stretch: 3;
                        preferred-width: 0px;
                        min-width: 0px;
                        text: "Title";
                        color: Theme.label;
                        font-size: 13px;
                        vertical-alignment: center;
                    }
                    Text {
                        horizontal-stretch: 2;
                        preferred-width: 0px;
                        min-width: 0px;
                        text: "Artist";
                        color: Theme.label;
                        font-size: 13px;
                        vertical-alignment: center;
                    }
                    Text {
                        width: 56px;
                        text: "Length";
                        color: Theme.label;
                        font-size: 13px;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                    Text {
                        width: 48px;
                        text: "Bpm";
                        color: Theme.label;
                        font-size: 13px;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                    Text {
                        width: 40px;
                        text: "Key";
                        color: Theme.label;
                        font-size: 13px;
                        horizontal-alignment: left;
                        vertical-alignment: center;
                    }
                }
                Rectangle {
                    height: 1px;
                    background: Theme.separator;
                }
                list := ListView {
                    vertical-stretch: 1;
                    for row[i] in root.rows: Rectangle {
                        height: 44px;
                        property <bool> picked: i == root.selected;
                        background: picked ? Theme.selection : (Math.mod(i, 2) == 0 ? Theme.row : Theme.row-alt);
                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            spacing: 12px;
                            Text {
                                horizontal-stretch: 3;
                        preferred-width: 0px;
                        min-width: 0px;
                                text: row.title;
                                color: picked ? Theme.on-row-selection : Theme.text;
                                font-size: 16px;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            Text {
                                horizontal-stretch: 2;
                        preferred-width: 0px;
                        min-width: 0px;
                                text: row.artist;
                                color: picked ? Theme.on-row-selection : Theme.text;
                                font-size: 16px;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            Text {
                                width: 56px;
                                text: row.time;
                                color: picked ? Theme.on-row-selection : Theme.text;
                                font-size: 16px;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                            }
                            Text {
                                width: 48px;
                                text: row.bpm;
                                color: picked ? Theme.on-row-selection : Theme.text;
                                font-size: 16px;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                            }
                            Text {
                                width: 40px;
                                text: row.key;
                                color: picked ? Theme.on-row-selection : Theme.text;
                                font-size: 16px;
                                vertical-alignment: center;
                            }
                        }
                        TouchArea {
                            clicked => {
                                root.select(i);
                            }
                        }
                    }
                }
            }
        }
    }

    // Keeps the picked row in view when the controller's browse knob moves it.
    public function show-row(index: int) {
        if (index * 44px < -list.content-y) {
            list.content-y = -index * 44px;
        } else if ((index + 1) * 44px > -list.content-y + list.visible-height) {
            list.content-y = -((index + 1) * 44px - list.visible-height);
        }
    }
}
