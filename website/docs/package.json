{
  "name": "opendj-docs",
  "private": true,
  "type": "module",
  "description": "The openDJ docs at opendj.app/docs, built with Starlight. website/build.sh builds them with the rest of the site.",
  "scripts": {
    "controllers": "python3 ../tools/controllers.py ../../res/controllers .",
    "dev": "npm run controllers && astro dev",
    "build": "npm run controllers && astro build"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.10",
    "@astrojs/starlight": "0.43.1",
    "astro": "7.4.13",
    "sharp": "0.35.5",
    "starlight-links-validator": "0.27.0"
  }
}
