<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "setup": the Inno Setup installer,
     built from the already signed binaries. The GitHub artifact the release
     workflow uploads is a zip with the one setup .exe at its root. Paste
     this into the SignPath project (slug opendj) as the artifact
     configuration with slug "setup". -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="openDJ-*-windows-x64-setup.exe">
      <authenticode-sign/>
    </pe-file>
  </zip-file>
</artifact-configuration>
