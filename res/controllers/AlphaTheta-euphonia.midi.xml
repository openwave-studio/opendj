<?xml version="1.0" encoding="utf-8"?>
<MixxxControllerPreset schemaVersion="1" mixxxVersion="2.6">
    <info>
        <name>AlphaTheta euphonia</name>
        <author>openDJ</author>
        <description>openDJ mapping for the AlphaTheta euphonia as an external mixer: its channel faders and INPUT SELECT tell openDJ which decks are on air, while the mixer does the mixing. Beta: written from the mixer's MIDI messages, not yet tried on the hardware.</description>
    </info>
