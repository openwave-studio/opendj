<?xml version="1.0" encoding="utf-8"?>
<MixxxControllerPreset schemaVersion="1" mixxxVersion="2.6">
    <info>
        <name>Pioneer DJM-250MK2</name>
        <author>openDJ</author>
        <description>openDJ mapping for the Pioneer DJM-250MK2 as an external mixer: its channel faders and INPUT SELECT tell openDJ which decks are on air, while the mixer does the mixing. Beta: written from the mixer's MIDI messages, not yet tried on the hardware.</description>
    </info>
    <controller id="DJM-250MK2">
        <scriptfiles>
            <file functionprefix="PioneerDJM" filename="Pioneer-DJM-script.js"/>
        </scriptfiles>
        <controls>
            <control>
                <description>INPUT SELECT CH1 - USB A - sets whether the channel plays this computer</description>
                <group>[Channel1]</group>
                <key>PioneerDJM.inputUsbA</key>
                <status>0x90</status>
                <midino>0x35</midino>
                <options>
                    <Script-Binding />
                </options>
            </control>
            <control>
                <description>INPUT SELECT CH2 - USB A - sets whether the channel plays this computer</description>
                <group>[Channel2]</group>
                <key>PioneerDJM.inputUsbA</key>
                <status>0x90</status>
                <midino>0x39</midino>
                <options>
                    <Script-Binding />
                </options>
            </control>
            <control>
                <description>INPUT SELECT CH1 - LINE - sets whether the channel plays this computer</description>
                <group>[Channel1]</group>
                <key>PioneerDJM.inputOther</key>
                <status>0x90</status>
                <midino>0x33</midino>
                <options>
                    <Script-Binding />
                </options>
            </control>
            <control>
                <description>INPUT SELECT CH2 - LINE - sets whether the channel plays this computer</description>
                <group>[Channel2]</group>
                <key>PioneerDJM.inputOther</key>
                <status>0x90</status>
                <midino>0x37</midino>
                <options>
                    <Script-Binding />
                </options>
            </control>
            <control>
                <description>INPUT SELECT CH1 - PHONO - sets whether the channel plays this computer</description>
                <group>[Channel1]</group>
                <key>PioneerDJM.inputOther</key>
                <status>0x90</status>
                <midino>0x34</midino>
                <options>
                    <Script-Binding />
                </options>
            </control>
            <control>
                <description>INPUT SELECT CH2 - PHONO - sets whether the channel plays this computer</description>
                <group>[Channel2]</group>
                <key>PioneerDJM.inputOther</key>
                <status>0x90</status>
                <midino>0x38</midino>
                <options>
                    <Script-Binding />
                </options>
            </control>
            <control>
                <description>CH FADER CH1 - slide - channel volume</description>
                <group>[Channel1]</group>
                <key>PioneerDJM.fader</key>
                <status>0xB0</status>
                <midino>0x11</midino>
                <options>
                    <Script-Binding />
                </options>
            </control>
            <control>
                <description>CH FADER CH2 - slide - channel volume</description>
                <group>[Channel2]</group>
                <key>PioneerDJM.fader</key>
                <status>0xB0</status>
                <midino>0x12</midino>
                <options>
                    <Script-Binding />
                </options>
            </control>
            <control>
                <description>CROSSFADER - slide - crossfade</description>
                <group>[Master]</group>
                <key>PioneerDJM.crossfader</key>
                <status>0xB0</status>
                <midino>0x0B</midino>
                <options>
                    <Script-Binding />
                </options>
            </control>
            <control>
                <description>USB A - connected - this computer is on the mixer's USB A port</description>
                <group>[Master]</group>
                <key>PioneerDJM.usbPortA</key>
                <status>0x90</status>
                <midino>0x4E</midino>
                <options>
                    <Script-Binding />
                </options>
            </control>
        </controls>
        <outputs>

        </outputs>
    </controller>
</MixxxControllerPreset>
